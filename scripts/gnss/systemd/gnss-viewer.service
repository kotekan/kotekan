[Unit]
Description=CHORD GNSS live fleet viewer (HTTP 8080, WebSocket 8539)
Documentation=file:///home/kvand/gnss/kotekan/docs/CHORD_GNSS_VM_MIGRATION.md
RequiresMountsFor=/home/kvand
After=gnss-broker.service
# ⚠️ TWO PROPAGATIONS, BOTH LOAD-BEARING. The viewer reads the broker's chain inventory ONCE at
# construction and never re-reads it, so it must die with the broker as well as with the stack --
# otherwise a broker restart leaves it serving an inventory from a broker that no longer exists.
PartOf=gnss-stack.target gnss-broker.service
# After= orders the START, not the READINESS. Without the wait below the viewer wins the race and
# caches a part-built chain list: it came up on 2 chains once and 1 the next time, against 8.

[Service]
Type=simple
# Must exceed the ExecStartPre deadline, or systemd kills the wait it was told to do.
TimeoutStartSec=360
User=kvand
# It resolves its static assets relative to the cwd, so this is load-bearing, not tidiness.
# ⚠️ THE VIEWER ONCE CALLED A DEAD BAND "LOCKED" because it gated on sig, which reads 46M on
# noise. It gates on q now. Reproduce the live argument list exactly rather than tidying it:
# --no-power-stream and --unified are what the running instance uses.
ExecStartPre=/home/kvand/gnss/kotekan/scripts/gnss/wait_for_broker_chains.sh

# ⚠️ ExecStart goes through run_component.sh so that the argv AND the environment come
# from ONE definition (scripts/gnss/stack_components.sh), which the *_up.sh scripts also
# use. Inlining the command here is how #134 happened: the command line was reproduced
# faithfully and the broker's OPENBLAS_NUM_THREADS export, which is not on it, was not.
# stack_contract_gate.sh proves a running process still matches the definition.
ExecStart=/home/kvand/gnss/kotekan/scripts/gnss/run_component.sh viewer
Restart=on-failure
RestartSec=10
MemoryAccounting=yes
MemoryMax=1G
StandardOutput=append:/var/log/gnss/viewer.log
StandardError=inherit

[Install]
WantedBy=gnss-stack.target
