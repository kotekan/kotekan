[Unit]
Description=CHORD GNSS unified multi-chain broker
Documentation=file:///home/kvand/gnss/kotekan/docs/CHORD_GNSS_VM_MIGRATION.md
# The code, the venv and the chain manifest are all on NFS. Starting before the mount is up
# fails in a way that reads as a code fault, not a missing filesystem.
RequiresMountsFor=/home/kvand
After=network-online.target remote-fs.target
Wants=network-online.target
# The gather's trim-in socket is bound to 127.0.0.1, so these two are one machine by
# construction, not by convenience.
After=gnss-gather.service
PartOf=gnss-stack.target
# StartLimit* live in [Unit], not [Service] -- systemd silently ignores them
# in [Service] and the crash loop then has no limit at all.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# ⚠️ NO Environment= HERE ON PURPOSE. The broker needs free-threaded 3.14t (GNSS_PY) and a
# one-thread BLAS cap (#134), and BOTH now live beside the argv in stack_components.sh, so the
# command and the environment cannot be ported apart again. Verify with stack_contract_gate.sh,
# which compares a RUNNING process against that definition -- argv and environment.
User=kvand

# Replaces the hand-rolled supervisor loop in broker_restart.sh: restart on a non-zero exit,
# with a burst limit so a crash loop stops instead of hiding behind a restart.
# ⚠️ ExecStart goes through run_component.sh so that the argv AND the environment come
# from ONE definition (scripts/gnss/stack_components.sh), which the *_up.sh scripts also
# use. Inlining the command here is how #134 happened: the command line was reproduced
# faithfully and the broker's OPENBLAS_NUM_THREADS export, which is not on it, was not.
# stack_contract_gate.sh proves a running process still matches the definition.
ExecStart=/home/kvand/gnss/kotekan/scripts/gnss/run_component.sh broker
Restart=on-failure
RestartSec=5
# No swap on this box, so a leak must hit a cgroup limit and restart one unit rather than let
# the kernel pick a victim. 582 MB is the steady state.
MemoryAccounting=yes
MemoryMax=3G
LimitNOFILE=65536
StandardOutput=append:/var/log/gnss/broker.log
StandardError=inherit

[Install]
WantedBy=gnss-stack.target
