[Unit]
Description=CHORD GNSS infrastructure stack (broker, gather, observables writers)
Documentation=file:///home/kvand/gnss/kotekan/docs/CHORD_GNSS_RUNBOOK.md
# ⚠️ ON THIS HOST ONLY, and every unit says so. The user-unit copies live in the NFS-SHARED home
# (~/.config/systemd/user), so cf06 and all eight cx nodes see them too -- and any login there
# starts kvand's user manager, which pulls default.target -> this target -> the whole stack. On
# 2026-10-02 a read-only ssh to cx51 left all 15 units crash-looping there until the session
# closed; on cf06 the broker hit its start limit. A stray broker that came up would command the
# fleet beside the real one. The condition is on EVERY unit, not just this target: a target whose
# condition fails is skipped, but the start jobs its Wants= queued run anyway. Two triggering
# (|) forms so a short hostname also matches; gethostname() returns the FQDN here today.
ConditionHost=|gnss
ConditionHost=|gnss.site.chord-observatory.ca
# Ordering within the target comes from the units' own After=; this only groups them so the
# whole stack starts on boot and stops together. The prize is that a reboot -- the VM will take
# unattended-upgrades reboots the way cf06 does at 03:03 -- needs no operator.
Wants=gnss-gather.service gnss-broker.service gnss-viewer.service gnss-aggregator.service gnss-rail.service
# gnss-aggregator.service joined on 2026-09-17, after the peak sample (which first said no,
# then said yes once #134 -- the dropped BLAS thread cap -- was fixed and the stack fell from
# 5.2 to 2.1 cores of 6). ⚠️ cf06 keeps its second L40S idle for benching; this host has one.
Wants=gnss-obs@gps_l5.service gnss-obs@gps_l2c.service
Wants=gnss-obs@gal_e5a.service gnss-obs@gal_e5b.service gnss-obs@gal_e6.service
Wants=gnss-obs@bds_b2a.service gnss-obs@bds_b2b.service gnss-obs@bds_b3i.service

[Install]
WantedBy=multi-user.target
