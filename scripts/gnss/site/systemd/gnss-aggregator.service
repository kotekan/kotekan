[Unit]
Description=CHORD GNSS aggregator (channelised search, GPU)
Documentation=file:///home/kvand/gnss/kotekan/docs/CHORD_GNSS_RUNBOOK.md
# This host only: the user copies sit in the NFS-shared home (see gnss-stack.target).
ConditionHost=|gnss
ConditionHost=|gnss.site.chord-observatory.ca
RequiresMountsFor=/home/kvand
After=network-online.target remote-fs.target
Wants=network-online.target
PartOf=gnss-stack.target
# A crash loop here must stop rather than hide behind the restart.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
# Needs a CUDA build, not a -DUSE_CUDA=OFF tree: the search runs on the GPU
# (use_cuda_acquire: true); the CPU acquire path exists but is the expensive stage.

# A socket per feed (bufferRecv per node and GPU) on top of CUDA's own descriptors; raised from
# the default 1024, like the gather's, so reconnect churn cannot exhaust it.
LimitNOFILE=65536
# ExecStart goes through run_component.sh so the argv and the environment come from one
# definition (scripts/gnss/site/stack_components.sh); stack_contract_gate.sh checks a running
# process against it.
ExecStart=/home/kvand/gnss/kotekan/scripts/gnss/site/run_component.sh aggregator
Restart=on-failure
RestartSec=15
# VmSize is mostly CUDA's virtual reservation, many times the resident memory; MemoryMax caps
# the resident figure. Leave overcommit alone: vm.overcommit_memory=2 would refuse the
# reservation and the process would not start.
MemoryAccounting=yes
MemoryMax=4G
StandardOutput=append:/var/tmp/gnss-logs/aggregator.log
StandardError=inherit

[Install]
WantedBy=gnss-stack.target
