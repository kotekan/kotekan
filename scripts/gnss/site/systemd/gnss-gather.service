[Unit]
Description=CHORD GNSS telemetry gather and fleet trim
Documentation=file:///home/kvand/gnss/kotekan/docs/CHORD_GNSS_RUNBOOK.md
# This host only: the user copies sit in the NFS-shared home (see gnss-stack.target).
ConditionHost=|gnss
ConditionHost=|gnss.site.chord-observatory.ca
RequiresMountsFor=/home/kvand
After=network-online.target remote-fs.target
Wants=network-online.target
PartOf=gnss-stack.target
# StartLimit* are [Unit] settings. In [Service] systemd ignores StartLimitIntervalSec=, and
# the default 10 s interval never fills at this RestartSec, so a crash loop would not stop.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
# build_nodpdk is built ARCH=native on cf06; this VM is a guest on cf02, the same Xeon Gold
# 5416S, so the binary runs here as-is. That holds for this host only; a -DARCH=x86-64-v2 tree
# is the portable build.

# The gather holds a socket per sender plus the broker's connections, and reconnect churn can
# exhaust the default 1024.
LimitNOFILE=65536
# A restart reloads the standing trims from the trim store (trim_state_file, if younger than
# trim_state_max_age_s) but breaks every fleet-ADR arc while the senders reconnect. Coming back
# beats staying down, but it must not be cheap or silent, hence the long RestartSec and the low
# burst limit.
# ExecStart goes through run_component.sh so the argv and the environment come from one
# definition (scripts/gnss/site/stack_components.sh); stack_contract_gate.sh checks a running
# process against it.
ExecStart=/home/kvand/gnss/kotekan/scripts/gnss/site/run_component.sh gather
Restart=on-failure
RestartSec=30
MemoryAccounting=yes
MemoryMax=2G
StandardOutput=append:/var/tmp/gnss-logs/gather.log
StandardError=inherit

[Install]
WantedBy=gnss-stack.target
