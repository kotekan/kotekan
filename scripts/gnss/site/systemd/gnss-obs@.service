[Unit]
Description=CHORD GNSS observables writer for chain %i
Documentation=file:///home/kvand/gnss/kotekan/docs/CHORD_GNSS_RUNBOOK.md
# This host only: the user copies sit in the NFS-shared home (see gnss-stack.target).
ConditionHost=|gnss
ConditionHost=|gnss.site.chord-observatory.ca
# Writes to /home/kvand/gnss/fixtures/obs, reads from the broker.
RequiresMountsFor=/home/kvand
After=gnss-broker.service
PartOf=gnss-stack.target

[Service]
# %i is the chain name; the RF constants come from stack_components.sh.
Environment=GNSS_CHAIN=%i
Type=simple
# The writers and the broker must run the same code. They are separate processes: a broker
# restarted with a new published field while the writers run older code publishes that field
# into nothing. Restart gnss-stack.target, not one unit, to keep them in step.

# ExecStart goes through run_component.sh so the argv and the environment come from one
# definition (scripts/gnss/site/stack_components.sh); stack_contract_gate.sh checks a running
# process against it.
ExecStart=/home/kvand/gnss/kotekan/scripts/gnss/site/run_component.sh obs
Restart=on-failure
RestartSec=10
MemoryAccounting=yes
MemoryMax=512M
StandardOutput=append:/var/tmp/gnss-logs/obs_%i.log
StandardError=inherit

[Install]
WantedBy=gnss-stack.target
