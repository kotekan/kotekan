[Unit]
Description=CHORD GNSS unified multi-chain broker
Documentation=file:///home/kvand/gnss/kotekan/docs/CHORD_GNSS_RUNBOOK.md
# This host only: the user copies sit in the NFS-shared home (see gnss-stack.target).
ConditionHost=|gnss
ConditionHost=|gnss.site.chord-observatory.ca
# The code, the venv and the chain manifest are all on NFS. Starting before the mount is up
# fails in a way that reads as a code fault, not a missing filesystem.
RequiresMountsFor=/home/kvand
After=network-online.target remote-fs.target
Wants=network-online.target
# The gather serves the broker's telemetry stream on 127.0.0.1 (serve_host), so these two run
# on one machine by construction.
After=gnss-gather.service
PartOf=gnss-stack.target
# StartLimit* are [Unit] settings. In [Service] systemd ignores StartLimitIntervalSec=, and
# the default 10 s interval never fills at this RestartSec, so a crash loop would not stop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# No Environment= here on purpose: the broker's free-threaded python (GNSS_PY) and one-thread
# BLAS cap live beside its argv in stack_components.sh.

# Restart on a non-zero exit (including exit 3, a changed F-engine frame0), with a burst limit
# so a crash loop stops instead of hiding behind a restart.
# ExecStart goes through run_component.sh so the argv and the environment come from one
# definition (scripts/gnss/site/stack_components.sh); stack_contract_gate.sh checks a running
# process against it.
ExecStart=/home/kvand/gnss/kotekan/scripts/gnss/site/run_component.sh broker
Restart=on-failure
RestartSec=5
# No swap on this box, so a leak must hit a cgroup limit and restart one unit rather than let
# the kernel pick a victim. 3G is several times the broker's steady state.
MemoryAccounting=yes
MemoryMax=3G
LimitNOFILE=65536
StandardOutput=append:/var/tmp/gnss-logs/broker.log
StandardError=inherit

[Install]
WantedBy=gnss-stack.target
