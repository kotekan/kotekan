[Unit]
Description=CHORD GNSS infrastructure stack (broker, gather, observables writers)
Documentation=file:///home/kvand/gnss/kotekan/docs/CHORD_GNSS_RUNBOOK.md
# On this host only, and every unit says so. The user-unit copies live in the NFS-shared home
# (~/.config/systemd/user), so cf06 and the cx nodes see them too, and any login there starts
# kvand's user manager, which pulls default.target -> this target -> the whole stack. A stray
# broker that came up would command the fleet beside the real one. The condition is on every
# unit, not just this target: a target whose condition fails is skipped, but the start jobs its
# Wants= queued run anyway. Two triggering (|) forms so a short hostname also matches;
# gethostname() returns the FQDN here.
ConditionHost=|gnss
ConditionHost=|gnss.site.chord-observatory.ca
# Ordering within the target comes from the units' own After=; this only groups them so the
# whole stack starts on boot (given user lingering) and stops together, so an unattended reboot
# needs no operator.
Wants=gnss-gather.service gnss-broker.service gnss-viewer.service gnss-aggregator.service gnss-rail.service
Wants=gnss-obs@gps_l5.service gnss-obs@gps_l2c.service
Wants=gnss-obs@gal_e5a.service gnss-obs@gal_e5b.service gnss-obs@gal_e6.service
Wants=gnss-obs@bds_b2a.service gnss-obs@bds_b2b.service gnss-obs@bds_b3i.service
Wants=gnss-obs@glo_l3oc.service

[Install]
WantedBy=default.target
