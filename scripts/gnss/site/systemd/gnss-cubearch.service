[Unit]
Description=CHORD GNSS beam-cube archiver (bufferRecv :11070 -> rawFileWrite on cs00)
Documentation=file:///home/kvand/gnss/kotekan/scripts/gnss/site/cubearch_up.sh
# This host only (see gnss-cube.target).
ConditionHost=|cf06
ConditionHost=|cf06.site.chord-observatory.ca
# The binary and config are on the NFS home; the archive is on cs00.
RequiresMountsFor=/home/kvand /mnt/cs00
Wants=network-online.target
After=network-online.target remote-fs.target
PartOf=gnss-cube.target

[Service]
Type=simple
# Pre-flight: config present, archive dir writable, sender/receiver frame_size agree -- a
# mismatch delivers NOTHING from a listener that is up (cubearch_up.sh says what it cost).
ExecStartPre=/home/kvand/gnss/kotekan/scripts/gnss/site/cubearch_up.sh --check
# ⚠️ ExecStart goes through run_component.sh so that the argv AND the environment come from
# ONE definition (scripts/gnss/site/stack_components.sh); gnss-broker.service has #134.
ExecStart=/home/kvand/gnss/kotekan/scripts/gnss/site/run_component.sh cubearch
# ARCHIVER FIRST, THEN THE NODES: the 90 senders drop rather than block, so a restart here
# loses windows and never stalls a tracker.
Restart=on-failure
RestartSec=30
StandardOutput=append:/tmp/gnss_cubearch.log
StandardError=inherit

[Install]
WantedBy=gnss-cube.target
