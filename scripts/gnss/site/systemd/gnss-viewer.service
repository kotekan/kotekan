[Unit]
Description=CHORD GNSS live fleet viewer (HTTP 8080, WebSocket 8539)
Documentation=file:///home/kvand/gnss/kotekan/docs/CHORD_GNSS_RUNBOOK.md
# This host only: the user copies sit in the NFS-shared home (see gnss-stack.target).
ConditionHost=|gnss
ConditionHost=|gnss.site.chord-observatory.ca
RequiresMountsFor=/home/kvand
After=gnss-broker.service
# PartOf both: the viewer reads the broker's chain inventory once at startup and never re-reads
# it, so it must stop and restart with the broker as well as with the stack, or a broker restart
# leaves it serving a stale inventory.
PartOf=gnss-stack.target gnss-broker.service
# After= orders the start, not readiness; the ExecStartPre wait keeps the viewer from caching a
# part-built chain list.

[Service]
Type=simple
# Must exceed the ExecStartPre deadline (GNSS_CHAINS_TIMEOUT_S, default 300 s), or systemd
# kills the wait.
TimeoutStartSec=360
ExecStartPre=/home/kvand/gnss/kotekan/scripts/gnss/site/wait_for_broker_chains.sh

# ExecStart goes through run_component.sh so the argv and the environment come from one
# definition (scripts/gnss/site/stack_components.sh); stack_contract_gate.sh checks a running
# process against it.
ExecStart=/home/kvand/gnss/kotekan/scripts/gnss/site/run_component.sh viewer
Restart=on-failure
RestartSec=10
MemoryAccounting=yes
MemoryMax=1G
StandardOutput=append:/var/tmp/gnss-logs/viewer.log
StandardError=inherit

[Install]
WantedBy=gnss-stack.target
