[Unit]
Description=CHORD GNSS beam-cube leg on the gnss VM: archiver
Documentation=file:///home/kvand/gnss/kotekan/scripts/gnss/site/cubearch_up.sh
# The gnss VM only, and the archiver says so too (gnss-cube.target says why). The nodes send
# to it once their manifest's cube-host is the VM. Enabled, so the archiver starts at boot:
#   systemctl --user enable --now gnss-cubevm.target
# It does not pull in gnss-cubevm-compact.service, which does not fit beside the stack in the
# VM's 16 GB (that unit says why): the staging loop runs on corrcal.
ConditionHost=|gnss
ConditionHost=|gnss.site.chord-observatory.ca
Wants=gnss-cubevm-arch.service

[Install]
WantedBy=default.target
