# -*-yaml-*-

################################################################################
#
# Run a test of the xpose2048 reordering kernel
#
################################################################################

---
log_level: debug

num_polarizations: 2
num_dishes: 1024
num_elements: num_polarizations * num_dishes
num_components: 2 # Re/Im
num_freq_host_buf: 1
{% set num_freq_gpu_buf = 16 %}
num_freq_gpu_buf: {{ num_freq_gpu_buf }}

samples_per_data_set: 16384
sample_period_ns: 2560
network_frame_arrival_period: 16384 * sample_period_ns / 1e9

# must be at least size of gpu_buffer_depth
host_buffer_depth: 4
# this must be 4 since cudaTranspose2048_chime.cpp hard-codes the outermost
# size of the voltage ring-buffer as 4
gpu_buffer_depth: 4

# Constants
sizeof_int32: 4

cpu_affinity: []

main_pool:
  kotekan_metadata_pool: chordMetadata
  num_metadata_objects: 10 * host_buffer_depth

# Buffers

host_scatter_indices_buffer:
    kotekan_buffer: ndarray
    num_frames: 1
    value_type: int32
    extents: [num_polarizations, num_dishes]
    metadata_pool: main_pool

host_voltage_buffers:
  num_frames: host_buffer_depth
  metadata_pool: main_pool
  numa_0:
    numa_node: 0
{%- for id in range(num_freq_gpu_buf) %}
    host_voltage_buffer_{{ id }}:
      kotekan_buffer: ndarray
      value_type: int4x2_swapped_withoffset
      extents: [num_freq_host_buf, samples_per_data_set, num_elements]
{%- endfor %}

host_voltage_ringbuffer:
  kotekan_buffer: ring
  ring_buffer_size: gpu_buffer_depth * samples_per_data_set * num_elements * num_freq_gpu_buf
  metadata_pool: main_pool

host_xposed_voltage_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: gpu_buffer_depth * num_dishes * num_polarizations * num_freq_gpu_buf * samples_per_data_set
    metadata_pool: main_pool

host_xposed_voltage_buffer:
  num_frames: host_buffer_depth
  metadata_pool: main_pool
  host_xposed_voltage_buffer:
    kotekan_buffer: ndarray
    value_type: int4x2_swapped_withoffset
    extents: [samples_per_data_set, num_freq_gpu_buf, num_polarizations, num_dishes]

cpu_xposed_voltage_buffer:
  num_frames: host_buffer_depth
  metadata_pool: main_pool
  cpu_xposed_voltage_buffer:
    kotekan_buffer: ndarray
    value_type: int4x2_swapped_withoffset
    extents: [samples_per_data_set, num_freq_gpu_buf, num_polarizations, num_dishes]
# Stages

set_voltage:
    kotekan_stage: testXpose
    num_elements: num_elements
    num_times: samples_per_data_set
    num_frequencies: num_freq_host_buf
    num_xposed_frequencies: num_freq_gpu_buf
    out_bufs:
{%- for id in range(num_freq_gpu_buf) %}
        - host_voltage_buffer_{{ id }}
{%- endfor %}
    out_xposed_buf: cpu_xposed_voltage_buffer
    scatter_indices_buf: host_scatter_indices_buffer

run_send_voltage:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
{%- for id in range(num_freq_gpu_buf) %}
            host_voltage_buffer_{{ id }}: host_voltage_buffer_{{ id }}
{%- endfor %}
        out_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer
        commands:
        - name: cudaCopyNToRingbuffer
          input_size: samples_per_data_set * num_elements * num_freq_host_buf
          ring_buffer_size: gpu_buffer_depth * input_size
          in_bufs: 
{%- for id in range(num_freq_gpu_buf) %}
            - host_voltage_buffer_{{ id }}
{%- endfor %}
          signal_buf: host_voltage_ringbuffer
          gpu_mem_output: voltage_buffer

run_xpose2048:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_scatter_indices_buffer: host_scatter_indices_buffer
            host_voltage_ringbuffer: host_voltage_ringbuffer
        out_buffers:
            host_xposed_voltage_ringbuffer: host_xposed_voltage_ringbuffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_scatter_indices_buffer
          gpu_mem: scatter_indices_buffer
        - name: cudaSyncInput
        - name: cudaTranspose2048_chime
          input_voltage_name: voltage
          scatter_indices_name: scatter_indices
          output_voltage_name: xposed_voltage
          poison_buffers: true

run_recv_xposed_voltage:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_xposed_voltage_ringbuffer: host_xposed_voltage_ringbuffer
        out_buffers:
            host_xposed_voltage_buffer: host_xposed_voltage_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_xposed_voltage_ringbuffer
          gpu_mem_input: xposed_voltage_buffer
          output_size: num_dishes * num_polarizations * num_freq_gpu_buf * num_times
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_xposed_voltage_buffer

compare_data:
    kotekan_stage: testDataCheckUchar
    first_buf: cpu_xposed_voltage_buffer
    second_buf: host_xposed_voltage_buffer
    num_frames_to_test: 1
    trigger_exit_on_pass: true
    check_metadata: true

