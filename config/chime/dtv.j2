{#-
  dtv.j2
  Optional DTV detector for the CHIME upgrade, detect only. Included by
  chime_upgrade_2numa.j2 in each NUMA domain when dtv_enabled is set, so every
  name here carries numa_sfx. No visibility or weight consumer reads the outputs.
  Bundle profiles must use chime_freq_id; see docs/sphinx/user/modules/pilotproxy.rst.
  dtv_write_enabled (default false) writes the outputs under dtv_output_dir. Without
  it the outputs have no consumer and each frame is dropped.
-#}
{% set dtv_runtime_bundle_dir = dtv_runtime_bundle_dir|default("data/pilotproxy_bundle") %}
{% set dtv_output_dir = dtv_output_dir|default("/scratch/dtv") %}
    ############################################################################
    # DTV detector

    # Buffers

    # One frame per 16384-sample block: mask, target/lower/upper powers
    # (sums of 256 fine powers), and per-frequency fine support.
    host_dtv_mask_buffer{{ numa_sfx }}:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: int8
        extents: [1, num_freq_gpu_buf]
        quantity_name: "dtv_mask"
        dimnames: ["T", "F"]
        dimscalings: [16384, 1]
        metadata_pool: main_pool{{ numa_sfx }}

    host_dtv_powers_buffer{{ numa_sfx }}:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: uint64
        extents: [1, num_freq_gpu_buf, 3]
        quantity_name: "dtv_powers"
        dimnames: ["T", "F", "W"]
        dimscalings: [16384, 1, 1]
        metadata_pool: main_pool{{ numa_sfx }}

    host_dtv_fine_support_buffer{{ numa_sfx }}:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: int32
        extents: [1, num_freq_gpu_buf, 2]
        quantity_name: "dtv_fine_support"
        dimnames: ["T", "F", "S"]
        dimscalings: [16384, 1, 1]
        metadata_pool: main_pool{{ numa_sfx }}

    # Stages

    run_dtv_detector:
        kotekan_stage: cudaProcess
        buffer_depth: gpu_buffer_depth
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        # A private stream triple, so the detector and the correlator do not queue together.
        cuda_stream_base: 1
        in_buffers:
            host_xposed_voltage_ringbuffer: host_xposed_voltage_ringbuffer{{ numa_sfx }}
        out_buffers:
            host_dtv_mask: host_dtv_mask_buffer{{ numa_sfx }}
            host_dtv_powers: host_dtv_powers_buffer{{ numa_sfx }}
            host_dtv_fine_support: host_dtv_fine_support_buffer{{ numa_sfx }}
        commands:
        - name: cudaPilotProxyDetector
          num_frequencies: num_freq_gpu_buf
          voltage_name: xposed_voltage
          detector_window_samples: 128
          receiver_channel_id_namespace: chime_freq_id
          dtv_mask_name: dtv_mask
          dtv_powers_name: dtv_powers
          dtv_fine_support_name: dtv_fine_support
          pilot_profiles_path: {{ dtv_runtime_bundle_dir }}/pilot_profiles.json
          weights_path: {{ dtv_runtime_bundle_dir }}/weights.bin
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: dtv_mask_buffer
          out_buf: host_dtv_mask
        - name: cudaOutputData
          gpu_mem: dtv_powers_buffer
          out_buf: host_dtv_powers
        - name: cudaOutputData
          gpu_mem: dtv_fine_support_buffer
          out_buf: host_dtv_fine_support

{% if dtv_write_enabled|default(false) %}
    write_dtv:
{% for product in ["mask", "powers", "fine_support"] %}
        {{ product }}:
            kotekan_stage: rawFileWrite
            in_buf: host_dtv_{{ product }}_buffer{{ numa_sfx }}
            base_dir: {{ dtv_output_dir }}
            file_name: dtv_{{ product }}{{ numa_sfx }}
            file_ext: raw
            num_frames_per_file: 1024
            allow_ndarray: true
{% endfor %}
{% endif %}
