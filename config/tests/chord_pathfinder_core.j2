    num_frames: buffer_depth * num_local_freq
    metadata_pool: n2_pool

n2_eigen_buffer_1:
    kotekan_buffer: N2
    num_elements: 8
    num_ev: num_ev_to_calculate
    n2_layout: "FullUpperTri"
    num_frames: buffer_depth * num_local_freq
    metadata_pool: n2_pool

n2_recv_buffer_0:
    kotekan_buffer: N2
    num_elements: 8
    num_ev: num_ev_to_calculate
    n2_layout: "FullUpperTri"
    num_frames: buffer_depth * num_local_freq
    metadata_pool: n2_pool

n2_recv_buffer_1:
    kotekan_buffer: N2
    num_elements: 8
    num_ev: num_ev_to_calculate
    n2_layout: "FullUpperTri"
