host_rfi_s012_ringbuffer_1:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (samples_per_data_set / rfi_downsampling_factor) * num_local_freq * 3 * num_elements * sizeof_uint64
    metadata_pool: main_pool
    numa_node: 1

host_rfi_sktilde_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (samples_per_data_set / rfi_downsampling_factor) * num_local_freq * 3 * sizeof_float32
    metadata_pool: main_pool

host_rfi_sktilde_ringbuffer_1:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (samples_per_data_set / rfi_downsampling_factor) * num_local_freq * 3 * sizeof_float32
    metadata_pool: main_pool
    numa_node: 1

host_rfi_RFImask_dummy_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * num_local_freq * samples_per_data_set / 8
