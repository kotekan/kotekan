host_rfi_RFImask_dummy_ringbuffer_1:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * num_local_freq * samples_per_data_set / 8
    metadata_pool: main_pool
    numa_node: 1


########
# Stages
########

## Send data to GPU ringbuffers ##

run_send_voltage:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        cpu_affinity: [12, 13, 14]
        in_buffers:
            host_voltage_buffer_in: host_voltage_buffer_0
        out_buffers:
            host_voltage_ringbuffer_out: host_voltage_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: samples_per_data_set * num_elements * num_local_freq
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_voltage_buffer_in
          signal_buf: host_voltage_ringbuffer_out
          gpu_mem_output: voltage_buffer
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        cpu_affinity: [25, 26, 27]
        in_buffers:
            host_voltage_buffer_in: host_voltage_buffer_1
        out_buffers:
            host_voltage_ringbuffer_out: host_voltage_ringbuffer_1
        commands:
        - name: cudaCopyToRingbuffer
          input_size: samples_per_data_set * num_elements * num_local_freq
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_voltage_buffer_in
          signal_buf: host_voltage_ringbuffer_out
          gpu_mem_output: voltage_buffer

# Copy the dummy RFI mask to the RFI mask on the GPU
# To activate the 1st stage RFI excision, do not run this stage! Instead make sure the
# SKtilde stage produces the RFI mask and places it in the host_rfi_RFImask_buffer
run_send_rfi_RFImask_dummy:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        cpu_affinity: [12, 13, 14]
        in_buffers:
            host_rfi_RFImask_buffer_in: host_rfi_RFImask_dummy_buffer
        out_buffers:
            host_rfi_RFImask_ringbuffer_out: host_rfi_RFImask_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: num_local_freq * samples_per_data_set / 8
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_rfi_RFImask_buffer_in
          signal_buf: host_rfi_RFImask_ringbuffer_out
          gpu_mem_output: rfi_RFImask_buffer
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        cpu_affinity: [25, 26, 27]
        in_buffers:
            host_rfi_RFImask_buffer_in: host_rfi_RFImask_dummy_buffer_1
        out_buffers:
            host_rfi_RFImask_ringbuffer_out: host_rfi_RFImask_ringbuffer_1
        commands:
        - name: cudaCopyToRingbuffer
          input_size: num_local_freq * samples_per_data_set / 8
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_rfi_RFImask_buffer_in
          signal_buf: host_rfi_RFImask_ringbuffer_out
          gpu_mem_output: rfi_RFImask_buffer

run_send_pl_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        cpu_affinity: [12, 13, 14]
        in_buffers:
            host_pl_mask_buffer_in: host_pl_mask_buffer
        out_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: (samples_per_data_set / 128) * (num_local_freq / 4) * (num_elements / 8) * 8
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_pl_mask_buffer_in
          signal_buf: host_pl_mask_ringbuffer
          gpu_mem_output: pl_mask_buffer
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        cpu_affinity: [25, 26, 27]
        in_buffers:
            host_pl_mask_buffer_in: host_pl_mask_buffer_1
        out_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer_1
        commands:
        - name: cudaCopyToRingbuffer
          input_size: (samples_per_data_set / 128) * (num_local_freq / 4) * (num_elements / 8) * 8
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_pl_mask_buffer_in
          signal_buf: host_pl_mask_ringbuffer
          gpu_mem_output: pl_mask_buffer

## Run GPU stages ##

run_rfi_s012:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
        out_buffers:
            host_rfi_s012_ringbuffer: host_rfi_s012_ringbuffer
        commands:
        - name: cudaRFIS012
          voltage_name: voltage
          pl_mask_name: pl_mask
          rfi_S012_name: rfi_s012
          num_times: samples_per_data_set
          num_frequencies: num_local_freq
          rfi_num_times: samples_per_data_set / rfi_downsampling_factor
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        in_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer_1
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer_1
        out_buffers:
            host_rfi_s012_ringbuffer: host_rfi_s012_ringbuffer_1
        commands:
        - name: cudaRFIS012
          voltage_name: voltage
          pl_mask_name: pl_mask
          rfi_S012_name: rfi_s012
          num_times: samples_per_data_set
          num_frequencies: num_local_freq
          rfi_num_times: samples_per_data_set / rfi_downsampling_factor

# This stage produces SK statistics averaged over all input elements and the RFI mask.
# If the pipeline is using the dummy DPDK-produced RFI mask, then this stage needs to direct its
# mask to "_dummy" buffers.  If the pipeline is using this RFI mask, then the buffers should
# *not* contain "_dummy", and the DPDK-produced mask should not be sent to the GPU.
run_rfi_sktilde:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_bf_mask_buffer: host_bf_mask_buffer
            host_rfi_s012_ringbuffer: host_rfi_s012_ringbuffer
        out_buffers:
            host_rfi_sktilde_ringbuffer: host_rfi_sktilde_ringbuffer
            host_rfi_mask_dummy_ringbuffer: host_rfi_RFImask_dummy_ringbuffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_bf_mask_buffer
          gpu_mem: bf_mask_buffer
        - name: cudaSyncInput
        - name: cudaRFISKtilde
          rfi_S012_name: rfi_s012
          bf_mask_name: bf_mask
          rfi_SKtilde_name: rfi_sktilde
          rfi_RFImask_name: rfi_mask_dummy
          num_times: samples_per_data_set
          num_frequencies: num_local_freq
          rfi_num_times: samples_per_data_set / rfi_downsampling_factor
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        in_buffers:
            host_bf_mask_buffer: host_bf_mask_buffer_1
            host_rfi_s012_ringbuffer: host_rfi_s012_ringbuffer_1
        out_buffers:
            host_rfi_sktilde_ringbuffer: host_rfi_sktilde_ringbuffer_1
            host_rfi_mask_dummy_ringbuffer: host_rfi_RFImask_dummy_ringbuffer_1
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_bf_mask_buffer
          gpu_mem: bf_mask_buffer
        - name: cudaSyncInput
        - name: cudaRFISKtilde
          rfi_S012_name: rfi_s012
          bf_mask_name: bf_mask
          rfi_SKtilde_name: rfi_sktilde
          rfi_RFImask_name: rfi_mask_dummy
          num_times: samples_per_data_set
          num_frequencies: num_local_freq
          rfi_num_times: samples_per_data_set / rfi_downsampling_factor

run_recv_rfi_sktilde:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_rfi_sktilde_ringbuffer_in: host_rfi_sktilde_ringbuffer
        out_buffers:
            host_rfi_sktilde_buffer_out: host_rfi_sktilde_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_sktilde_ringbuffer_in
          gpu_mem_input: rfi_sktilde_buffer
          output_size: (samples_per_data_set / rfi_downsampling_factor) * num_local_freq * 3 * sizeof_float32
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_sktilde_buffer_out
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        in_buffers:
            host_rfi_sktilde_ringbuffer_in: host_rfi_sktilde_ringbuffer_1
        out_buffers:
            host_rfi_sktilde_buffer_out: host_rfi_sktilde_buffer_1
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_sktilde_ringbuffer_in
          gpu_mem_input: rfi_sktilde_buffer
          output_size: (samples_per_data_set / rfi_downsampling_factor) * num_local_freq * 3 * sizeof_float32
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_sktilde_buffer_out

# This copies the RFI Mask that was used in N2K kernels back out to the CPU into the
# host_rfi_RFImask_buffer. It may contain either the DPDK-produced dummy mask or the
# SKtilde-produced real mask.
run_recv_rfi_RFImask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_rfi_RFImask_ringbuffer_in: host_rfi_RFImask_ringbuffer
        out_buffers:
            host_rfi_RFImask_buffer_out: host_rfi_RFImask_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_RFImask_ringbuffer_in
          gpu_mem_input: rfi_RFImask_buffer
          output_size: samples_per_data_set * num_local_freq / 8
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_RFImask_buffer_out
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        in_buffers:
            host_rfi_RFImask_ringbuffer_in: host_rfi_RFImask_ringbuffer_1
        out_buffers:
            host_rfi_RFImask_buffer_out: host_rfi_RFImask_buffer_1
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_RFImask_ringbuffer_in
          gpu_mem_input: rfi_RFImask_buffer
          output_size: samples_per_data_set * num_local_freq / 8
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_RFImask_buffer_out

# Only the "normal" (downsampled) PL mask is sent to the GPU. This expands that mask for
# the 1 bit correlator kernel. Other stages use the downsampled mask directly.
run_pl_expand:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
        out_buffers:
            host_pl_mask_exp_ringbuffer: host_pl_mask_exp_ringbuffer
        commands:
        - name: cudaPLMaskExpander
          num_frequencies: num_local_freq
          pl_mask_name: pl_mask
          pl_expanded_mask_name: pl_mask_exp
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        in_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer_1
        out_buffers:
            host_pl_mask_exp_ringbuffer: host_pl_mask_exp_ringbuffer_1
        commands:
        - name: cudaPLMaskExpander
          num_frequencies: num_local_freq
          pl_mask_name: pl_mask
          pl_expanded_mask_name: pl_mask_exp

# Packet-loss correlator to produce counts for N2Accumulate
run_pl_corr:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_mask_exp_ringbuffer: host_pl_mask_exp_ringbuffer
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer
        out_buffers:
            host_counts_buffer: host_counts_buffer
        commands:
        - name: cudaPL1bitCorrelator
          num_frequencies: num_local_freq
          pl_expanded_mask_name: pl_mask_exp
          rfi_RFImask_name: rfi_RFImask
          n2k_counts_name: counts
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: counts_buffer
          out_buf: host_counts_buffer
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        in_buffers:
            host_pl_mask_exp_ringbuffer: host_pl_mask_exp_ringbuffer_1
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer_1
        out_buffers:
            host_counts_buffer: host_counts_buffer_1
        commands:
        - name: cudaPL1bitCorrelator
          num_frequencies: num_local_freq
          pl_expanded_mask_name: pl_mask_exp
          rfi_RFImask_name: rfi_RFImask
          n2k_counts_name: counts
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: counts_buffer
          out_buf: host_counts_buffer

# Run N2K correlator
run_n2k:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        cpu_affinity: [12, 13, 14]
        in_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer
        out_buffers:
            host_correlation: host_correlation_buffer
        commands:
        - name: cudaCorrelator
          n2k_correlation_name: correlation
          voltage_name: voltage
          rfi_RFImask_name: rfi_RFImask
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: correlation_buffer
          out_buf: host_correlation
    gpu_1:
        kotekan_stage: cudaProcess
        gpu_id: 1
        cpu_affinity: [25, 26, 27]
        in_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer_1
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer_1
        out_buffers:
            host_correlation: host_correlation_buffer_1
        commands:
        - name: cudaCorrelator
          n2k_correlation_name: correlation
          voltage_name: voltage
          rfi_RFImask_name: rfi_RFImask
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: correlation_buffer
          out_buf: host_correlation


## Debugging / counting stages ##

hex_dump:
    #kotekan_stage: hexDump
    cpu_affinity: [29]
    in_buf: n2_buffer_1
    len: 4096

count_rfi_mask:
    kotekan_stage: RfiMaskSum
    in_buf: host_rfi_RFImask_buffer
    out_buf: host_rfi_RFImask_counts_buffer

count_rfi_mask_1:
    kotekan_stage: RfiMaskSum
    in_buf: host_rfi_RFImask_buffer_1
    out_buf: host_rfi_RFImask_counts_buffer_1

count_PL:
    kotekan_stage: CountLostPLSamplesScalar
    in_buf: host_pl_mask_buffer
    out_buf: host_pl_counts_buffer
    packet_loss_is_scalar: true

count_PL_1:
    kotekan_stage: CountLostPLSamplesScalar
    in_buf: host_pl_mask_buffer_1
    out_buf: host_pl_counts_buffer_1
    packet_loss_is_scalar: true

compute_RFI_frame_mask:
    kotekan_stage: RfiFrameMask
    in_buf: host_rfi_sktilde_buffer
    out_buf: host_rfi_RFIframemask_buffer
    enabled_updatable_config: /rfi_second_stage_enabled
    thresholds_updatable_config: /rfi_second_stage_thresholds

compute_RFI_frame_mask_1:
    kotekan_stage: RfiFrameMask
    in_buf: host_rfi_sktilde_buffer_1
    out_buf: host_rfi_RFIframemask_buffer_1
    enabled_updatable_config: /rfi_second_stage_enabled
    thresholds_updatable_config: /rfi_second_stage_thresholds

rfi_second_stage_enabled:
    kotekan_update_endpoint: json
    enabled: false
    valid_at_time_ns: 0

rfi_second_stage_thresholds:
    kotekan_update_endpoint: json
    thresholds: []
    valid_at_time_ns: 0

## Accumulate N2K visibilities on CPU ##

n2_accumulate:
    kotekan_stage: N2Accumulate
    cpu_affinity: [9]
    in_buf: host_correlation_buffer
    in_counts_buf: host_counts_buffer
    in_rficounts_buf: host_rfi_RFImask_counts_buffer
    in_plcounts_buf: host_pl_counts_buffer
    in_rfiframemask_buf: host_rfi_RFIframemask_buffer
    out_buf: n2_buffer
    num_freq_per_n2k_frame: num_local_freq
    packet_loss_is_scalar: True
    input_order: CHORDEarly
    num_subintegrations_per_bin: {{ num_subintegrations_per_bin }}
    variance_mode: EvenOddPosDef
    output_batch_size: 12
    num_workers: 1

n2_accumulate_1:
    kotekan_stage: N2Accumulate
    cpu_affinity: [28]
    in_buf: host_correlation_buffer_1
    in_counts_buf: host_counts_buffer_1
    in_rficounts_buf: host_rfi_RFImask_counts_buffer_1
    in_plcounts_buf: host_pl_counts_buffer_1
    in_rfiframemask_buf: host_rfi_RFIframemask_buffer_1
    out_buf: n2_buffer_1
    num_freq_per_n2k_frame: num_local_freq
    packet_loss_is_scalar: True
    input_order: CHORDEarly
    num_subintegrations_per_bin: {{ num_subintegrations_per_bin }}
    variance_mode: EvenOddPosDef
    bin_in_ERA: false
    do_fringestop: false
    output_batch_size: 12
    num_workers: 1


# Subset to first 8 elements (4 dishes x 2 polarizations)

n2_subset:
    kotekan_stage: N2Subset
    cpu_affinity: [11]
    in_buf: n2_buffer
    out_buf: n2_subset_buffer

n2_subset_1:
    kotekan_stage: N2Subset
    cpu_affinity: [29]
    in_buf: n2_buffer_1
    out_buf: n2_subset_buffer_1

# Eigenmode calculation (runs only on subsetted data for now)

eigencalc:
    kotekan_stage: EigenN2Iter
    num_ev: num_ev_to_calculate
    cpu_affinity: [10]
    num_blaze_workers: 1
    in_buf: n2_subset_buffer
    out_buf: n2_eigen_buffer
    # Convergence config
    tol_eval: 0.0001
    tol_evec: 0.001
    max_iterations: 10
    num_ev_conv: 2
    krylov: 2
    subspace: 2

eigencalc_1:
    kotekan_stage: EigenN2Iter
    num_ev: num_ev_to_calculate
    cpu_affinity: [30]
    num_blaze_workers: 1
    in_buf: n2_subset_buffer_1
    out_buf: n2_eigen_buffer_1
    # Convergence config
    tol_eval: 0.0001
    tol_evec: 0.001
    max_iterations: 10
    num_ev_conv: 2
    krylov: 2
    subspace: 2
