{#-
  chord_pathfinder.j2
  Basic N2 pipeline with F-engine packet capture
-#}

# Buffer sends

write_n2:

    max_frames: -1
    compression: zstd
    compression_level: 9
    use_bitshuffle: true

    # The element order of the visibility matrices in n2_buffer / n2_eigen_buffer, used to look
    # up feed positions and dish grid indices. The correlated element axis comes from the
    # voltage buffer's [..., P, D], so element index = polarization * num_dishes + dish, which
    # is what CHORDTelescope encodes as a station id and what CHORDBeamformer indexes by
    # (CHORDEarly would be [D][P]).
    input_order: CHORDBeamformer

    write_subsets:
        base_dir: subset_file_dir

        write_n2_subset:
            kotekan_stage: hdf5N2Write
            in_buf: n2_eigen_buffer
            num_file_t: 4

        write_n2_subset_1:
            kotekan_stage: hdf5N2Write
            in_buf: n2_eigen_buffer_1
            num_file_t: 4

    write_fulls:
        base_dir: full_file_dir

        write_n2_full:
            kotekan_stage: hdf5N2Write
            in_buf: n2_buffer
            num_file_t: 4

        write_n2_full_1:
            kotekan_stage: hdf5N2Write
            in_buf: n2_buffer_1
            num_file_t: 4
