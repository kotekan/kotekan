# -*-yaml-*-

# CHIME RFI setup, copied from config/chime_upgrade_frb.j2 without the network output
# (rfiBroadcast) and with the SKtilde dimension name fixed (see below). Jinja variable:
# rfi_feed_averaged_min_good_frac.

################################################################################
# RFI setup

# from 2.56 us to 0.655 ms
rfi_downsampling_factor: 256
# from 0.655 ms ms to 41.94304 ms
rfi_second_downsampling_factor: 64

rfi_sk_rfimask_sigmas: 5.0
rfi_single_feed_min_good_frac: 0.8
rfi_feed_averaged_min_good_frac: {{ rfi_feed_averaged_min_good_frac | default(0.8) }}
# range [2,50] as suggested in SK estimation note in software design document
# (overleaf 671416c2d6343fda483e336b) and references to the SK note therein.
rfi_mu_min: 2.0
rfi_mu_max: 50.0

# Buffers

rfi_num_times: 64      # 0.655 ms cadence
rfi_num_times_bar: 1   # 41.94304 ms cadence

host_rfi_S012_ringbuffer:
    kotekan_buffer: ring
    num_frames: gpu_buffer_depth
    ring_buffer_size: gpu_buffer_depth * sizeof_uint64 * num_dishes * num_polarizations * 3 * num_freq_gpu_buf * rfi_num_times
    type: uint64
    dimnames: ["Trfi", "F", "S", "P", "D"]
    shape: [gpu_buffer_depth * rfi_num_times, num_freq_gpu_buf, 3, num_polarizations, num_dishes]
    metadata_pool: main_pool

host_rfi_S012bar_ringbuffer:
    kotekan_buffer: ring
    num_frames: gpu_buffer_depth
    ring_buffer_size: gpu_buffer_depth * sizeof_uint64 * num_dishes * num_polarizations * 3 * num_freq_gpu_buf * rfi_num_times_bar
    type: uint64
    dimnames: ["Trfibar", "F", "S", "P", "D"]
    shape: [gpu_buffer_depth * rfi_num_times_bar, num_freq_gpu_buf, 3, num_polarizations, num_dishes]
    metadata_pool: main_pool

host_rfi_S012tilde_ringbuffer:
    kotekan_buffer: ring
    num_frames: gpu_buffer_depth
    ring_buffer_size: gpu_buffer_depth * sizeof_uint64 * 3 * num_freq_gpu_buf * rfi_num_times
    type: uint64
    dimnames: ["Trfi", "F", "S"]
    shape: [gpu_buffer_depth * rfi_num_times, num_freq_gpu_buf, 3]
    metadata_pool: main_pool

host_rfi_SKtilde_buffer:
    kotekan_buffer: ndarray
    num_frames: gpu_buffer_depth
    value_type: float32
    # GPU producer cudaRFISKtilde rfi_SKtilde (leading extent = per-frame rfi_num_times);
    # also validated by RfiFrameMask in_buf as {Trfi, F, SK}.
    # config/chime_upgrade_frb.j2 has "S", which cudaRFISKtilde rejects
    dimnames: ["Trfi", "F", "SK"]
    extents: [rfi_num_times, num_freq_gpu_buf, 3]
    metadata_pool: main_pool
host_rfi_SKtilde_ringbuffer:
    kotekan_buffer: ring
    num_frames: gpu_buffer_depth
    ring_buffer_size: gpu_buffer_depth * sizeof_float32 * 3 * num_freq_gpu_buf * rfi_num_times
    type: float32
    dimnames: ["Trfi", "F", "S"]
    shape: [gpu_buffer_depth * rfi_num_times, num_freq_gpu_buf, 3]
    metadata_pool: main_pool

host_rfi_RFImask_buffer:
    kotekan_buffer: ndarray
    num_frames: gpu_buffer_depth
    value_type: uint1x8
    # GPU producer cudaRFISKtilde rfi_RFImask (leading = per-frame samples/(8*128));
    # also validated by RfiMaskSum/lostSamplesToN2Counts/cudaCorrelator as RFImask.
    extents: [samples_per_data_set / 8 / 128, num_freq_gpu_buf, 128]
    metadata_pool: main_pool
host_rfi_RFImask_ringbuffer:
    kotekan_buffer: ring
    num_frames: gpu_buffer_depth
    ring_buffer_size: gpu_buffer_depth * num_freq_gpu_buf * samples_per_data_set / 8
    type: uint1x8
    dimnames: ["T8hi128", "F", "T8lo128"]
    shape: [gpu_buffer_depth * samples_per_data_set / 8 / 128, num_freq_gpu_buf, 128]
    metadata_pool: main_pool

host_rfi_SKbar_buffer:
    kotekan_buffer: ndarray
    num_frames: gpu_buffer_depth
    value_type: float32
    # GPU producer cudaRFISKbar rfi_SKbar (leading = per-frame rfi_num_times_bar).
    extents: [rfi_num_times_bar, num_freq_gpu_buf, 3, num_polarizations, num_dishes]
    metadata_pool: main_pool
host_rfi_SKbar_ringbuffer:
    kotekan_buffer: ring
    num_frames: gpu_buffer_depth
    ring_buffer_size: gpu_buffer_depth * sizeof_float32 * num_dishes * num_polarizations * 3 * num_freq_gpu_buf * rfi_num_times_bar
    type: float32
    dimnames: ["Trfi", "F", "S", "P", "D"]
    shape: [gpu_buffer_depth * rfi_num_times_bar, num_freq_gpu_buf, 3, num_polarizaions, num_dishes]
    metadata_pool: main_pool

host_rfi_SKbartilde_buffer:
    kotekan_buffer: ndarray
    num_frames: gpu_buffer_depth
    value_type: float32
    # GPU producer cudaRFISKbar rfi_SKbartilde (leading = per-frame rfi_num_times_bar).
    extents: [rfi_num_times_bar, num_freq_gpu_buf, 3]
    metadata_pool: main_pool
host_rfi_SKbartilde_ringbuffer:
    kotekan_buffer: ring
    num_frames: gpu_buffer_depth
    ring_buffer_size: gpu_buffer_depth * sizeof_float32 * 3 * num_freq_gpu_buf * rfi_num_times_bar
    type: float32
    dimnames: ["Trfi", "F", "S"]
    shape: [gpu_buffer_depth * rfi_num_times_bar, num_freq_gpu_buf, 3]
    metadata_pool: main_pool

# The mask for second stage RFI excision.
host_rfi_RFIframemask_buffer:
    kotekan_buffer: ndarray
    num_frames: gpu_buffer_depth
    value_type: uint8
    # produced by RfiFrameMask (out_buf): {num_integrations, num_local_freq}
    extents: [samples_per_data_set / n2k_sub_integration_ntime, num_local_freq]
    zero_new_frames: true
    zero_value: 0xFF
    metadata_pool: main_pool

# Stages

run_rfi_S012:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            # TODO: transpose pl_mask
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
            host_xposed_voltage_ringbuffer: host_xposed_voltage_ringbuffer
        out_buffers:
            host_rfi_S012_ringbuffer: host_rfi_S012_ringbuffer
        commands:
        - name: cudaRFIS012
          num_frequencies: num_freq_gpu_buf
          pl_mask_name: pl_mask
          voltage_name: xposed_voltage
          rfi_S012_name: rfi_S012

run_rfi_S012tilde:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        # maybe? Depends on the chunking of the previous stage
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_bf_mask_ringbuffer: host_bf_mask_ringbuffer
            host_rfi_S012_ringbuffer: host_rfi_S012_ringbuffer
        out_buffers:
            host_rfi_S012tilde_ringbuffer: host_rfi_S012tilde_ringbuffer
        commands:
        - name: cudaRFIS012tilde
          num_frequencies: num_freq_gpu_buf
          bf_mask_name: bf_mask
          rfi_S012_name: rfi_S012
          rfi_S012tilde_name: rfi_S012tilde

run_rfi_S012bar:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        # maybe? Depends on the chunking of the previous stage
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_rfi_S012_ringbuffer: host_rfi_S012_ringbuffer
        out_buffers:
            host_rfi_S012bar_ringbuffer: host_rfi_S012bar_ringbuffer
        commands:
        - name: cudaRFIS012bar
          num_frequencies: num_freq_gpu_buf
          rfi_S012_name: rfi_S012
          rfi_S012bar_name: rfi_S012bar

run_rfi_SKtilde:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        # maybe? Depends on the chunking of the previous stage
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_bf_mask_ringbuffer: host_bf_mask_ringbuffer
            host_rfi_S012_ringbuffer: host_rfi_S012_ringbuffer
        out_buffers:
            host_rfi_SKtilde_ringbuffer: host_rfi_SKtilde_ringbuffer
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer
        commands:
        - name: cudaRFISKtilde
          num_frequencies: num_freq_gpu_buf
          bf_mask_name: bf_mask
          rfi_S012_name: rfi_S012
          rfi_SKtilde_name: rfi_SKtilde
          rfi_RFImask_name: rfi_RFImask
          enabled_updatable_config: /updatable_config/rfi_first_stage_enabled

run_rfi_SKbar:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        # maybe? Depends on the chunking of the previous stage
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_bf_mask_ringbuffer: host_bf_mask_ringbuffer
            host_rfi_S012bar_ringbuffer: host_rfi_S012bar_ringbuffer
        out_buffers:
            host_rfi_SKbar_ringbuffer: host_rfi_SKbar_ringbuffer
            host_rfi_SKbartilde_ringbuffer: host_rfi_SKbartilde_ringbuffer
        commands:
        - name: cudaRFISKbar
          num_frequencies: num_freq_gpu_buf
          bf_mask_name: bf_mask
          rfi_S012bar_name: rfi_S012bar
          rfi_SKbar_name: rfi_SKbar
          rfi_SKbartilde_name: rfi_SKbartilde

run_rfi_SK_copy_from_GPU:
    gpu0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        frame_arrival_period: network_frame_arrival_period
        num_times: rfi_num_times_bar
        in_buffers:
            host_rfi_SKbar_ringbuffer: host_rfi_SKbar_ringbuffer
            host_rfi_SKtilde_ringbuffer: host_rfi_SKtilde_ringbuffer
        out_buffers:
            host_rfi_SKbar_buffer: host_rfi_SKbar_buffer
            host_rfi_SKtilde_buffer: host_rfi_SKtilde_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_SKbar_ringbuffer
          gpu_mem_input: rfi_SKbar_buffer
          output_size: sizeof_float32 * num_dishes * num_polarizations * 3 * num_freq_gpu_buf * rfi_num_times_bar
          ring_buffer_size: gpu_buffer_depth * output_size
          out_buf: host_rfi_SKbar_buffer
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_SKtilde_ringbuffer
          gpu_mem_input: rfi_SKtilde_buffer
          output_size: sizeof_float32 * 3 * num_freq_gpu_buf * rfi_num_times
          ring_buffer_size: gpu_buffer_depth * output_size
          out_buf: host_rfi_SKtilde_buffer

run_rfi_MASK_copy_from_GPU:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        # maybe? Depends on the chunking of the previous stage
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer
        out_buffers:
            host_rfi_RFImask_buffer: host_rfi_RFImask_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_RFImask_ringbuffer
          gpu_mem_input: rfi_RFImask_buffer
          output_size: num_freq_gpu_buf * samples_per_data_set / 8
          ring_buffer_size: gpu_buffer_depth * output_size
          out_buf: host_rfi_RFImask_buffer

# Second-stage RFI flagging
compute_RFI_frame_mask:
    kotekan_stage: RfiFrameMask
    in_buf: host_rfi_SKtilde_buffer
    out_buf: host_rfi_RFIframemask_buffer
    sub_integration_ntime: n2k_sub_integration_ntime
    enabled_updatable_config: /updatable_config/rfi_second_stage_enabled
    thresholds_updatable_config: /updatable_config/rfi_second_stage_thresholds
