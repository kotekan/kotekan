# -*-yaml-*-

# CHIME upchannelizer and FRB setup, copied from config/chime_upgrade_frb.j2 without the outputs and
# the debugging dumps, and with frb1_swap_MN and the FRB1 weight layout fixed (see below). Jinja variables: upchan_gains ('16': the 16 fine-channel gains),
# frb2_beam_layout (replaces `mode` and `beams` of setFRBBeams), frb2_weights_lifetime_in_samples;
# `frb_pl_mask` in `outputs` adds the host copy of the FRB packet loss mask.

################################################################################
# FRB beamforming

# UpchannelizationSchedule (used by setUpchanGain) expects these in the root level of the config tree.
# TODO: change this and get the frequency indices from get_coarse_freq() so
# that input files do not contain per-node information
#
# adapted from fengine_chime.j2
# TODO: this cannot be a fixed list since the frequencies change per x-engine node
#       instead we can / should used coarse_freq metadata entry
# The frequency channels we keep.
#     Channel 1024 has 400 MHz for CHIME, channel 0 has 800 MHz.
#     There are 2.56 channels per MHz, with a channel width of 390625 Hz.
#
# NOTE: these *must* be sorted since the are passed through a std::set which
# sorts them
# frequency_channels: [ 269, 277, 285, 293, 301, 477, 485, 493, 541, 717, 749, 901, 957, 981, 989, 1005 ]
frequency_channels: [ 58, 66, 234, 666, 698, 730, 738, 746, 802, 818, 826, 898, 906, 954, 962, 978]

upchan_factors: [16]
# ranges are [min, max)
upchan_channel_ranges:
    16: [0, 2048]

FRB:
    # cudaQuantize requires `frb_num_output_times` to be a multiple of 256
    frb_num_output_times: 256
    frb_chunk_size: 256
    frb_downsampling_factor: 24 * 16 # 384

    # The FRB1 beamforming weights are valid for this many input samples. process_frb1_U16_phase
    # emits one set of weights per bad feed mask frame, so this has to be the mask's lifetime. The
    # U = 16 FRB1 kernel processes multiples of 16 * (384 / 16) = 384 input samples, so it also
    # has to be a multiple of 384.
    frb1_phase_lifetime_in_samples: bf_mask_lifetime_in_samples

    # The FRB2 beamforming weights are valid for this many input samples. This must be a multiple
    # of frb_num_output_times * frb_downsampling_factor, the number of input samples the FRB2
    # beamformer processes per kernel invocation. The weights matrices are large and are
    # recalculated on the GPU, so keep this long: about a minute here, and possibly much longer
    # (e.g. 24 h) in production.
    frb2_weights_lifetime_in_samples: {{ frb2_weights_lifetime_in_samples | default('240 * frb_num_output_times * frb_downsampling_factor') }} # default: 60.3979776 s
    # Number of weights matrices in the GPU ring buffer. Each takes
    # 2 * upchan_U16_max_num_output_channels * frb2_num_beams * frb1_num_beams_Q * frb1_num_beams_P
    # bytes (2 GiB).
    frb2_weights_ring_depth: 2

    # The GPU-local (not global) channel index range for each upchannelization factor

    # actual = 16, scaled = 256
    factor_upchan_out: 16
    upchan_U16_max_num_channels: 16 # probably should be {{ num_freq_gpu_buf }}
    upchan_U16_min_channel: 0
    upchan_U16_max_channel: 16 # probably should be {{ num_freq_gpu_buf }}
    upchan_U16_min_output_channel: 0
    upchan_U16_max_output_channel: (upchan_U16_max_channel - upchan_U16_min_channel) * 16
    upchan_U16_max_num_output_channels: upchan_U16_max_output_channel - upchan_U16_min_output_channel

    # TODO: remove
    frb1_num_beams_P: 2 * num_dishes_y
    frb1_num_beams_Q: 2 * num_dishes_x
    # Not in config/chime_upgrade_frb.j2: without it processFRBFeedGains describes its weights as
    # [dishN = 256, dishM = 4], the FRB1 kernel expects [dishN = 4, dishM = 256], and kotekan
    # does not start
    frb1_swap_MN: true

    {%- set frb2_num_beams_x = 4 %}
    {%- set frb2_num_beams_y = 256 %}
    {%- set frb2_num_beams = frb2_num_beams_x * frb2_num_beams_y %}
    frb2_num_beams_x: {{ frb2_num_beams_x }}
    frb2_num_beams_y: {{ frb2_num_beams_y }}
    frb2_num_beams: {{ frb2_num_beams }}

    # Buffers

    # Upchanneling Gains
    # Per-frequency real multiplier for each upchannelized frequency. This is _not_
    # the complex feed gains
    host_upchan_U16_gain_buffer:
        kotekan_buffer: ndarray
        num_frames: 1
        # TODO: check if factor_upchan_out was the correct 16 to use here
        value_type: float16
        extents: [upchan_U16_max_num_channels * 16]
        quantity_name: "G"
        dimnames: ["Fbar"]
        dimscalings: [1]
        metadata_pool: main_pool

    # Upchannelized voltages
    host_upchan_U16_voltage_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: int4x2_swapped_withoffset
        extents: [samples_per_data_set / 16, upchan_U16_max_num_channels * 16, num_polarizations, num_dishes]
        quantity_name: "Ebar"
        dimnames: ["Tbar", "Fbar", "P", "D"]
        dimscalings: [16, 1, 1, 1]
        metadata_pool: main_pool
    host_upchan_U16_voltage_ringbuffer:
        kotekan_buffer: ring
        ring_buffer_size: gpu_buffer_depth * num_dishes * num_polarizations * (upchan_U16_max_num_channels * factor_upchan_out) * (samples_per_data_set / factor_upchan_out)
        metadata_pool: main_pool

    # Beam locations

    # One frame of positions per frb2_weights_lifetime_in_samples input samples
    host_frb2_beam_positions_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: float32
        extents: [frb2_num_beams, 2]
        quantity_name: "frb2_beam_positions"
        dimnames: ["R", "X/Y"]
        dimscalings: [1, 1]
        metadata_pool: main_pool

    host_frb2_beam_ids_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: uint64
        extents: [frb2_num_beams]
        quantity_name: "frb2_beam_ids"
        dimnames: ["R"]
        dimscalings: [1]
        metadata_pool: main_pool

    # Beamforming gains at coarse frequency resolution
    host_frb1_phase_buffer:
        kotekan_buffer: ndarray
        num_frames: 1
        value_type: float32
        extents: [num_freq_gpu_buf, num_elements, num_components]
        quantity_name: "gain"
        dimnames: ["F", "E", "C"]
        dimscalings: [1, 1, 1]
        metadata_pool: main_pool

    # Beamforming gains at upchannelized frequency resolution. One frame is one set of weights,
    # covering frb1_phase_lifetime_in_samples input samples.
    host_frb1_U16_phase_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: float16
        # config/chime_upgrade_frb.j2 has [..., num_dishes_y, num_dishes_x, ...], which the FRB1
        # kernel rejects
        extents: [1, num_freq_gpu_buf * factor_upchan_out, num_polarizations, num_dishes_x, num_dishes_y, num_components]
        quantity_name: "W"  # also referred to as weights, hence the name
        dimnames: ["TW", "Fbar", "P", "dishN", "dishM", "C"]
        dimscalings: [frb1_phase_lifetime_in_samples, 1, 1, 1, 1, 1]
        metadata_pool: main_pool
    # The ring must hold as many sets of weights as the FRB1 kernel's `TW` axis: 4
    host_frb1_U16_phase_ringbuffer:
        kotekan_buffer: ring
        ring_buffer_size: gpu_buffer_depth * sizeof_float16 * num_freq_gpu_buf * factor_upchan_out * num_polarizations * num_dishes_y * num_dishes_x * num_components
        metadata_pool: main_pool

    # The weights are calculated on the GPU, directly into this ring buffer, one matrix
    # [Fbar, R, beamQ, beamP] per frb2_weights_lifetime_in_samples input samples. There is no host
    # copy.
    host_frb2_weights_ringbuffer:
        kotekan_buffer: ring
        ring_buffer_size: frb2_weights_ring_depth * sizeof_float16 * upchan_U16_max_num_output_channels * frb2_num_beams * frb1_num_beams_Q * frb1_num_beams_P
        metadata_pool: main_pool

    # (Intermediate) Beams

    host_frb1_beams_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: float16
        extents: [frb_num_output_times, upchan_U16_max_num_output_channels, frb1_num_beams_Q, frb1_num_beams_P]
        quantity_name: "I"
        dimnames: ["Ttilde", "Fbar", "beamQ", "beamP"]
        dimscalings: [frb_downsampling_factor, 1, 1, 1]
        metadata_pool: main_pool
    host_frb1_beams_ringbuffer:
        kotekan_buffer: ring
        num_frames: gpu_buffer_depth
        ring_buffer_size: gpu_buffer_depth * sizeof_float16 * frb1_num_beams_P * frb1_num_beams_Q * upchan_U16_max_num_output_channels * frb_num_output_times
        metadata_pool: main_pool

    # Packet loss masks

    host_upchan_U16_expanded_pl_mask_ringbuffer:
        kotekan_buffer: ring
        ring_buffer_size: gpu_buffer_depth * (64 / 8) * (num_dishes / 8) * num_polarizations * upchan_U16_max_num_channels * (samples_per_data_set / 64 / 16)
        metadata_pool: main_pool

    # The packet loss mask of the FRB1 beams, one byte (1 = valid) per sample and frequency
    host_frb1_pl_mask_ringbuffer:
        kotekan_buffer: ring
        num_frames: gpu_buffer_depth
        ring_buffer_size: gpu_buffer_depth * upchan_U16_max_num_output_channels * frb_num_output_times
        metadata_pool: main_pool

{%- if 'frb_pl_mask' in outputs | default([]) %}
    # Host copy of the packet loss mask, for debugging. The quantizer encodes invalid samples as 0,
    # so the mask is not needed after quantization.
    host_frb_pl_mask_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: uint8
        extents: [frb_num_output_times, upchan_U16_max_num_output_channels]
        quantity_name: "pl_mask_I"
        dimnames: ["Ttilde", "Fbar"]
        dimscalings: [frb_downsampling_factor, 1]
        metadata_pool: main_pool
{%- endif %}

    host_frb2_beams_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: float16
        extents: [1, frb2_num_beams, upchan_U16_max_num_output_channels, frb_num_output_times]
        quantity_name: "I2"
        dimnames: ["Ttildehi256", "R", "Fbar", "Ttildelo256"]
        dimscalings: [frb_downsampling_factor * 256, 1, 1, frb_downsampling_factor]
        metadata_pool: main_pool

    host_frb3_beams_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: uint8
        extents: [1, frb2_num_beams/4, upchan_U16_max_num_output_channels/64, 16,
                  4, 4, 16, 16]
        quantity_name: "I3"
        dimnames: ["Ttilde256", "R4", "Fbar64", "Ttilde16_lo16", "Rlo4", "Fbar16_lo4", "Fbarlo16", "Ttildelo16"]
        dimscalings: [frb_downsampling_factor * 256, 4, 64, frb_downsampling_factor * 16, 1, 16, 1,
                      frb_downsampling_factor]
        metadata_pool: main_pool

    host_frb3_beams_buffer_post:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: uint8
        extents: [1, frb2_num_beams/4, upchan_U16_max_num_output_channels/64, 16,
                  4, 4, 16, 16]
        quantity_name: "I3"
        dimnames: ["Ttilde256", "R4", "Fbar64", "Ttilde16_lo16", "Rlo4", "Fbar16_lo4", "Fbarlo16", "Ttildelo16"]
        dimscalings: [frb_downsampling_factor * 256, 4, 64, frb_downsampling_factor * 16, 1, 16, 1,
                      frb_downsampling_factor]
        metadata_pool: main_pool

    host_frb3_beams_offsetscale_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        # the output is quantized in chunks of `frb_chunk_size`
        value_type: float16
        extents: [1, frb2_num_beams/4, upchan_U16_max_num_output_channels/64, 16, 4, 4, 2]
        quantity_name: "I3_offsetscale"
        dimnames: ["Ttilde256", "R4", "Fbar64", "Ttilde16_lo16", "Rlo4", "Fbar16_lo4", "offset/scale"]
        dimscalings: [frb_downsampling_factor * 256, 4, 64, frb_downsampling_factor * 16, 1, 16, 1]
        metadata_pool: main_pool

    # Stages

    run_set_upchan_U16_gain:
        kotekan_stage: setUpchanGain
        upchan_factor: factor_upchan_out
        upchan_max_num_channels: upchan_U16_max_num_channels
        upchan_gain: {{ (upchan_gains | default({})).get('16', [1] * 16) | tojson }}
        upchan_gain_buffer: host_upchan_U16_gain_buffer
        metadata_source:
{%- for id in range(num_freq_gpu_buf) %}
            - host_voltage_buffer_{{ id }}
{%- endfor %}

    run_upchan_pl_U16:
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_pl_expanded_mask_ringbuffer: host_pl_expanded_mask_ringbuffer
            out_buffers:
                host_upchan_U16_expanded_pl_mask_ringbuffer: host_upchan_U16_expanded_pl_mask_ringbuffer
            commands:
            - name: cudaPLMaskUpchannelizer
              expanded_pl_mask_name: pl_expanded_mask
              upchannelized_expanded_pl_mask_name: upchan_U16_expanded_pl_mask
              num_frequencies: num_freq_gpu_buf
              upchannelization_factor: 16
              num_frequencies_out: upchan_U16_max_num_channels
              Fmin: upchan_U16_min_channel
              Fmax: upchan_U16_max_channel

    run_upchan_U16:
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            # maybe? Depends on the chunking of the previous stage
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_xposed_voltage_ringbuffer: host_xposed_voltage_ringbuffer
                host_upchan_U16_gain_buffer: host_upchan_U16_gain_buffer
            out_buffers:
                host_upchan_U16_voltage_ringbuffer: host_upchan_U16_voltage_ringbuffer
            commands:
            - name: cudaInputData
              do_once: true
              in_buf: host_upchan_U16_gain_buffer
              gpu_mem: upchan_U16_gain_buffer
            - name: cudaSyncInput
            - name: cudaUpchannelizer_chime_U16_K4
              voltage_name: xposed_voltage
              upchan_U16_gain_name: upchan_U16_gain
              upchan_U16_voltage_name: upchan_U16_voltage
              Fmin: upchan_U16_min_channel
              Fmax: upchan_U16_max_channel
            - name: cudaSyncOutput

    run_recv_upchan_U16_voltage:
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            # maybe? Depends on the chunking of the previous stage
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_upchan_U16_voltage_ringbuffer: host_upchan_U16_voltage_ringbuffer
            out_buffers:
                host_upchan_U16_voltage_buffer: host_upchan_U16_voltage_buffer
            commands:
            - name: cudaCopyFromRingbuffer
              host_signal: host_upchan_U16_voltage_ringbuffer
              gpu_mem_input: upchan_U16_voltage_buffer
              output_size: num_dishes * num_polarizations * (upchan_U16_max_num_channels * factor_upchan_out) * (samples_per_data_set / factor_upchan_out)
              ring_buffer_size: buffer_depth * output_size
              out_buf: host_upchan_U16_voltage_buffer

    # FRB 1

    load_frb1_phase:
        kotekan_stage: loadFeedGains
        beamformer_type: "frb"
        filename_template: "quick_gains_%04d_reordered.bin"
        num_local_freq: num_freq_gpu_buf
        default_gains: [1.0, 1.0]
        gain_buffers:
          - host_frb1_phase_buffer
        in_buf: host_rfi_RFImask_buffer
        updatable_config:
          frb_gain: /updatable_config/frb_gain

    process_frb1_U16_phase:
        kotekan_stage: processFRBFeedGains
        num_local_freq: num_freq_gpu_buf
        upchan_factor: factor_upchan_out
        gain_buffers:
          - host_frb1_phase_buffer
        # This reads the mask on the host side, not from the GPU ringbuffer, and it reads it as
        # a flat array of num_elements bytes -- which the rank-3 [1, P, D] mask still is.
        in_mask_buf: host_bf_mask_buffer
        out_buf: host_frb1_U16_phase_buffer

    # Send the weights to their GPU ringbuffer. One set of weights covers
    # frb1_phase_lifetime_in_samples input samples, so this runs far less often than run_frb1_U16.
    run_send_frb1_U16_phase:
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_frb1_U16_phase_buffer: host_frb1_U16_phase_buffer
            out_buffers:
                host_frb1_U16_phase_ringbuffer: host_frb1_U16_phase_ringbuffer
            commands:
            - name: cudaCopyToRingbuffer
              input_size: sizeof_float16 * num_freq_gpu_buf * factor_upchan_out * num_polarizations * num_dishes_y * num_dishes_x * num_components
              ring_buffer_size: gpu_buffer_depth * input_size
              in_buf: host_frb1_U16_phase_buffer
              signal_buf: host_frb1_U16_phase_ringbuffer
              gpu_mem_output: frb1_U16_phase_buffer

    run_frb1_U16:
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            # maybe? Depends on the chunking of the previous stage
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_upchan_U16_voltage_ringbuffer: host_upchan_U16_voltage_ringbuffer
                host_frb1_U16_phase_ringbuffer: host_frb1_U16_phase_ringbuffer
            out_buffers:
                host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
            commands:
            - name: cudaCHIMEFRBBeamformer_chime_U16_K4
              voltage_name: upchan_U16_voltage
              frb_phase_name: frb1_U16_phase
              frb_beamgrid_name: frb1_beams

    # The packet loss mask of the FRB1 beams. An FRB1 output sample is valid only if all input
    # samples it depends on are valid.
    run_frb1_pl_U16:
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_upchan_U16_expanded_pl_mask_ringbuffer: host_upchan_U16_expanded_pl_mask_ringbuffer
            out_buffers:
                host_frb1_pl_mask_ringbuffer: host_frb1_pl_mask_ringbuffer
            commands:
            - name: cudaPLMaskFRB1
              pl_mask_name: upchan_U16_expanded_pl_mask
              frb1_pl_mask_name: frb1_pl_mask
              num_frequencies: upchan_U16_max_num_channels
              upchannelization_factor: 16
              downsampling_factor: frb_downsampling_factor / 16
              Fmin: 0
              Fmax: upchan_U16_max_channel - upchan_U16_min_channel
              Fbar_out_min: upchan_U16_min_output_channel
              Fbar_out_max: upchan_U16_max_output_channel
              num_output_frequencies: upchan_U16_max_num_output_channels
              num_output_times: buffer_depth * frb_num_output_times

    # FRB 2 and 3

    # One frame of beams per weights lifetime, starting at the first voltage frame's sequence
    # number
    run_set_beam_positions:
        kotekan_stage: setFRBBeams
        metadata_source: host_voltage_buffer_0
        out_pos_buf: host_frb2_beam_positions_buffer
        out_id_buf: host_frb2_beam_ids_buffer
        time_downsampling_fpga: frb2_weights_lifetime_in_samples
        num_beams: frb2_num_beams
{%- if frb2_beam_layout is defined %}
{%- for key, val in frb2_beam_layout.items() %}
        {{ key }}: {{ val | tojson }}
{%- endfor %}
{%- else %}
        mode: manual
        # beam separation in EW should be 0.4deg
        # beam separtion in NS is such that sin(angle) changes by sqrt(3)/256
        # from https://github.com/chime-frb-open-data/chime-frb-beam-model/blob/e65b070243056fe5d33a2b1f4ce52ce685b74fc5/cfbm/formed.py#L86 via Paul Scholz
        # these are in degrees
        {% set achromatic_beam_angles_NS = [
          -59.233549987193, -58.483949017744, -57.750011991337, -57.030682735392,
          -56.325015186745, -55.632157961228, -54.951341594436, -54.281867909548,
          -53.623101094342, -52.974460163257, -52.335412550528, -51.705468633724,
          -51.084177027739, -50.471120520824, -49.865912548762, -49.268194122623,
          -48.677631140774, -48.093912028012, -47.516745654459, -46.945859494750,
          -46.380997994466, -45.821921115990, -45.268403040290, -44.720231004668,
          -44.177204259468, -43.639133129205, -43.105838165609, -42.577149381831,
          -42.052905558502, -41.532953613565, -41.017148028873, -40.505350327419,
          -39.997428595831, -39.493257047447, -38.992715621809, -38.495689616956,
          -38.002069351269, -37.511749852028, -37.024630568130, -36.540615104732,
          -36.059610977784, -35.581529386675, -35.106285003368, -34.633795776594,
          -34.163982749795, -33.696769891667, -33.232083938230, -32.769854245498,
          -32.310012651875, -31.852493349502, -31.397232763854, -30.944169440944,
          -30.493243941552, -30.044398741939, -29.597578140579, -29.152728170452,
          -28.709796516497, -28.268732437860, -27.829486694586, -27.392011478463,
          -26.956260347703, -26.522188165229, -26.089751040299, -25.658906273255,
          -25.229612303199, -24.801828658382, -24.375515909156, -23.950635623309,
          -23.527150323638, -23.105023447617, -22.684219309041, -22.264703061504,
          -21.846440663620, -21.429398845876, -21.013545079011, -20.598847543840,
          -20.185275102441, -19.772797270613, -19.361384191546, -18.951006610626,
          -18.541635851308, -18.133243792004, -17.725802843931, -17.319285929850,
