---
type: config
# Logging level can be one of:
# OFF, ERROR, WARN, INFO, DEBUG, DEBUG2 (case insensitive)
# Note DEBUG and DEBUG2 require a build with (-DCMAKE_BUILD_TYPE=Debug)
log_level: info

# Default buffer depth (number of frames in buffer)
buffer_depth: 8

# Default core assignments
cpu_affinity: [8,9,10,11,13,14,15]

samples_per_data_set: 49152
num_elements: 512
num_local_freq: 4

# Pool
main_pool:
    kotekan_metadata_pool: chimeMetadata
    num_metadata_objects: 15 * buffer_depth

sizeof_int: 4

{%- for id in range(4) %}
network_capture_buf_{{ id }}:
  kotekan_buffer: standard
  num_frames: buffer_depth
  frame_size: samples_per_data_set * num_elements * num_local_freq
  metadata_pool: main_pool
  numa_node: 0
{%- endfor %}



buffer_recv_0:
    kotekan_stage: bufferRecv
    log_level: warn
    buf: network_capture_buf_0
    listen_port: 11027
    num_threads: 1

buffer_recv_1:
    kotekan_stage: bufferRecv
    log_level: warn
    buf: network_capture_buf_1
    listen_port: 11028
    num_threads: 1
  
buffer_recv_2:
    kotekan_stage: bufferRecv
    log_level: warn
    buf: network_capture_buf_2
    listen_port: 11029
    num_threads: 1

buffer_recv_3:
    kotekan_stage: bufferRecv
    log_level: warn
    buf: network_capture_buf_3
    listen_port: 11030
    num_threads: 1