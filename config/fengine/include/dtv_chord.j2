# -*-yaml-*-

# CHORD DTV pilot-tone detector (PilotProxy) setup
#
# Runs the PilotProxy ATSC pilot F-statistic detector
# (lib/cuda/cudaPilotProxyDetector.cpp; vendored kernel in
# external/pilotproxy/) on the voltage ring buffer. At its first detector
# block the stage reads the chordMetadata coarse_freq identifiers and binds
# any of this node's coarse channels that appear as `chord_channel_id` in
# the PilotProxy runtime bundle; nodes carrying no DTV pilot channel run
# DISABLED and emit all-zero products.
#
# The runtime bundle (pilot_profiles.json + weights.bin) is exported from
# the pilot-proxy repository:
#
#   pilot-proxy export-runtime-weight-bundle \
#     --receiver-profile configs/receiver_profiles/chord_dtv_fengine.json \
#     --detector-core-profile configs/detector_core/pilotproxy_cuda_fstat_v1.json \
#     --weight-coordinate-system post_spectral_sense_normalization \
#     --physical-channel-range 14:36 \
#     --output-dir <dtv_runtime_bundle_dir>
#
#   pilot-proxy validate-runtime-weight-bundle --bundle-dir <dtv_runtime_bundle_dir>
#
# Kotekan can run this export as part of the build: configure with
# -DPILOTPROXY_EXPORT_BUNDLE=ON (or AUTO) with the pilot-proxy CLI on
# PATH, and the bundle lands in <build>/pilotproxy_bundle (see
# cmake/Features/FeaturePilotProxyBundle.cmake; export + validation take
# seconds). Production deployments should keep pinning a released bundle
# via dtv_runtime_bundle_dir: the bundle is survey calibration data with
# epoch semantics, not a build product.
#
# For the ATSC 14-36 pilot range the bundle covers CHORD coarse channels
# (freq_ids) 2408-3084 (470.3-602.3 MHz).
#
# Frame geometry. Three distinct "frames" are involved; keep them separate:
#   * channelized sample  5.12 us on CHORD's 195.3125 kHz coarse raster
#                         (2.56 us on CHIME's 390.625 kHz raster)
#   * GPU ring frame      num_times = 8192 samples = 41.94304 ms; the
#                         producer's ring advance unit, not a decision unit
#   * detector block      samples_per_detector_frame = 16384 samples
#                         = 83.88608 ms = two GPU ring frames
#
# The detector block is the decision unit: one mask bit per block per
# channel. It yields windows_per_stream = 16384 / detector_window_samples
# = 128, the frozen fine-reduction transform length
# (FSTAT_FINE_WINDOWS_PER_STREAM).
#
# NOTE: CHORD's visibility integration (n2k_samples_per_data_set) is 8192
# samples, so one mask currently spans exactly two integrations. Moving to
# 1:1 alignment means samples_per_detector_frame = 8192, which requires a
# matching detector_window_samples = 64 in the compiled core to keep
# windows_per_stream = 128; the two must change together.

{% if dtv_runtime_bundle_dir is not defined %}
{% set dtv_runtime_bundle_dir = "data/pilotproxy_bundle" %}
{% endif %}

################################################################################

# Buffers

host_dtv_mask_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: int8
    extents: [num_frequencies]
    quantity_name: "dtv_mask"
    dimnames: ["F"]
    dimscalings: [1]
    metadata_pool: main_pool

host_dtv_powers_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: uint64
    extents: [num_frequencies, 3]
    quantity_name: "dtv_powers"
    dimnames: ["F", "W"]
    dimscalings: [1, 1]
    metadata_pool: main_pool

################################################################################

# Stages

run_dtv_detector:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer
        out_buffers:
            host_dtv_mask: host_dtv_mask_buffer
            host_dtv_powers: host_dtv_powers_buffer
        commands:
        - name: cudaPilotProxyDetector
          voltage_name: voltage
          dtv_mask_name: dtv_mask
          dtv_powers_name: dtv_powers
          # Decision unit: one mask bit per this many channelized samples,
          # per channel. 16384 samples = 83.88608 ms = two 8192-sample GPU
          # ring frames. Must be a multiple of the compiled core's
          # detector_window_samples, and the quotient (windows_per_stream)
          # must equal FSTAT_FINE_WINDOWS_PER_STREAM or the fine CFAR path
          # is unavailable -- see decision_mode below.
          samples_per_detector_frame: 16384
          # "auto": fine designated-set CFAR mask for channels whose bundle
          # fine_calibration.status is "calibrated", coarse rational mask
          # otherwise. "coarse" forces the coarse mask everywhere.
          decision_mode: auto
          pilot_profiles_path: {{ dtv_runtime_bundle_dir }}/pilot_profiles.json
          weights_path: {{ dtv_runtime_bundle_dir }}/weights.bin
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: dtv_mask_buffer
          out_buf: host_dtv_mask
        - name: cudaOutputData
          gpu_mem: dtv_powers_buffer
          out_buf: host_dtv_powers
