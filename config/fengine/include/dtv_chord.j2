# -*-yaml-*-

# CHORD DTV pilot-tone detector (PilotProxy) setup
#
# Runs the PilotProxy ATSC pilot F-statistic detector
# (lib/cuda/cudaPilotProxyDetector.cpp; vendored kernel in
# lib/cuda/pilotproxy/) on the voltage ring buffer. At its first detector
# block the stage reads the chordMetadata coarse_freq identifiers and binds
# any of this node's coarse channels that appear as `chord_channel_id` in
# the PilotProxy runtime bundle; nodes carrying no DTV pilot channel run
# DISABLED and emit all-zero products.
#
# The runtime bundle (pilot_profiles.json + weights.bin) is exported from
# the pilot-proxy repository:
#
#   pilot-proxy export-runtime-weight-bundle \
#     --receiver-profile configs/receiver_profiles/chord_dtv_fengine.json \
#     --detector-core-profile configs/detector_core/pilotproxy_cuda_fstat_v1.json \
#     --weight-coordinate-system post_spectral_sense_normalization \
#     --physical-channel-range 14:36 \
#     --output-dir <dtv_runtime_bundle_dir>
#
#   pilot-proxy validate-runtime-weight-bundle --bundle-dir <dtv_runtime_bundle_dir>
#
# For the ATSC 14-36 pilot range the bundle covers CHORD coarse channels
# (freq_ids) 2408-3084 (470.3-602.3 MHz); one detector block is
# samples_per_detector_frame = 16384 samples = 2 GPU frames = 83.88608 ms,
# giving the frozen 128 windows/stream fine-reduction geometry.

{% if dtv_runtime_bundle_dir is not defined %}
{% set dtv_runtime_bundle_dir = "data/pilotproxy_bundle" %}
{% endif %}

################################################################################

# Buffers

host_dtv_mask_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: int8
    extents: [num_frequencies]
    quantity_name: "dtv_mask"
    dimnames: ["F"]
    dimscalings: [1]
    metadata_pool: main_pool

host_dtv_powers_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: uint64
    extents: [num_frequencies, 3]
    quantity_name: "dtv_powers"
    dimnames: ["F", "W"]
    dimscalings: [1, 1]
    metadata_pool: main_pool

################################################################################

# Stages

run_dtv_detector:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer
        out_buffers:
            host_dtv_mask: host_dtv_mask_buffer
            host_dtv_powers: host_dtv_powers_buffer
        commands:
        - name: cudaPilotProxyDetector
          voltage_name: voltage
          dtv_mask_name: dtv_mask
          dtv_powers_name: dtv_powers
          # Upstream ring advance unit (samples per producer GPU frame).
          num_times: num_times
          # One detector decision per 16384 samples (2 GPU frames); the
          # frozen fine-transform geometry (128 windows/stream).
          samples_per_detector_frame: 16384
          num_frequencies: num_frequencies
          # "auto": fine designated-set CFAR mask for channels whose bundle
          # fine_calibration.status is "calibrated", coarse rational mask
          # otherwise. "coarse" forces the coarse mask everywhere.
          decision_mode: auto
          pilot_profiles_path: {{ dtv_runtime_bundle_dir }}/pilot_profiles.json
          weights_path: {{ dtv_runtime_bundle_dir }}/weights.bin
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: dtv_mask_buffer
          out_buf: host_dtv_mask
        - name: cudaOutputData
          gpu_mem: dtv_powers_buffer
          out_buf: host_dtv_powers
