# -*-yaml-*-

# CHORD pathfinder RFI setup

################################################################################

# from 5.12 μs to 1.31072 ms
rfi_downsampling_factor: 256
# from  1.31072 ms to 31.45728 ms
rfi_second_downsampling_factor: 24

rfi_sk_rfimask_sigmas: 5.0
rfi_single_feed_min_good_frac: 0.8
rfi_feed_averaged_min_good_frac: 0.8
rfi_mu_min: 2.0
rfi_mu_max: 20.0

################################################################################

# Buffers

rfi_num_times: num_times / rfi_downsampling_factor
rfi_num_times_tilde: rfi_num_times

host_rfi_S012_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: sizeof_uint64 * num_dishes * num_polarizations * 3 * num_frequencies * rfi_num_times
    metadata_pool: main_pool
host_rfi_S012_ringbuffer:
    kotekan_buffer: ring
    num_frames: buffer_depth
    ring_buffer_size: buffer_depth * sizeof_uint64 * num_dishes * num_polarizations * 3 * num_frequencies * rfi_num_times
    metadata_pool: main_pool

host_rfi_S012tilde_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: sizeof_uint64 * 3 * num_frequencies * rfi_num_times_tilde
    metadata_pool: main_pool
host_rfi_S012tilde_ringbuffer:
    kotekan_buffer: ring
    num_frames: buffer_depth
    ring_buffer_size: buffer_depth * sizeof_uint64 * 3 * num_frequencies * rfi_num_times_tilde
    metadata_pool: main_pool

################################################################################

# Stages

run_rfi_S012:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
            host_voltage_ringbuffer: host_voltage_ringbuffer
        out_buffers:
            host_rfi_S012_ringbuffer: host_rfi_S012_ringbuffer
        commands:
        - name: cudaRFIS012
          pl_mask_name: pl_mask
          voltage_name: voltage
          rfi_S012_name: rfi_S012

run_rfi_S012tilde:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_bf_mask_buffer: host_bf_mask_buffer
            host_rfi_S012_ringbuffer: host_rfi_S012_ringbuffer
        out_buffers:
            host_rfi_S012tilde_ringbuffer: host_rfi_S012tilde_ringbuffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_bf_mask_buffer
          gpu_mem: bf_mask_buffer
        - name: cudaSyncInput
        - name: cudaRFIS012tilde
          bf_mask_name: bf_mask
          rfi_S012_name: rfi_S012
          rfi_S012tilde_name: rfi_S012tilde
