# -*-yaml-*-

# CHORD pathfinder RFI setup

################################################################################

# from 5.12 μs to 1.31072 ms
rfi_downsampling_factor: 256

rfi_sk_rfimask_sigmas: 5.0
rfi_single_feed_min_good_frac: 0.8
rfi_feed_averaged_min_good_frac: 0.8
rfi_mu_min: 2.0
rfi_mu_max: 20.0

################################################################################

# Buffers

host_rfi_S012_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: sizeof_uint64 * num_dishes * num_polarizations * 3 * num_frequencies * num_times / rfi_downsampling_factor
    metadata_pool: main_pool
host_rfi_S012_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * sizeof_uint64 * num_dishes * num_polarizations * 3 * num_frequencies * num_times / rfi_downsampling_factor
    metadata_pool: main_pool

host_rfi_S012tilde_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: sizeof_uint64 * 3 * num_frequencies * num_times / rfi_downsampling_factor
    metadata_pool: main_pool
host_rfi_S012tilde_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * sizeof_uint64 * 3 * num_frequencies * num_times / rfi_downsampling_factor
    metadata_pool: main_pool

################################################################################

# Stages

run_rfi:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_bf_mask_buffer_in: host_bf_mask_buffer
            host_pl_mask_ringbuffer_in: host_pl_mask_ringbuffer
            host_voltage_ringbuffer_in: host_voltage_ringbuffer
        out_buffers:
            host_rfi_S012_ringbuffer_out: host_rfi_S012_ringbuffer
            host_rfi_S012tilde_ringbuffer_out: host_rfi_S012tilde_ringbuffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_bf_mask_buffer_in
          gpu_mem: bf_mask_buffer
        - name: cudaSyncInput
        - name: S012Kernel
          bf_mask: bf_mask_buffer
          pl_mask: pl_mask_buffer
          gpu_mem_voltage: voltage_buffer
          accumulant: rfi_S012_buffer
          averaged_accumulant: rfi_S012tilde_buffer
          pl_mask_in_signal: host_pl_mask_ringbuffer_in
          voltage_in_signal: host_voltage_ringbuffer_in
          rfi_S012_out_signal: host_rfi_S012_ringbuffer_out
          rfi_S012tilde_out_signal: host_rfi_S012tilde_ringbuffer_out
          max_num_times: buffer_depth * num_times
