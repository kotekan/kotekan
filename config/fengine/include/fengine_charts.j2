# -*-yaml-*-

# CHARTS F-Engine setup

################################################################################

# Pathfinder:
#             quantity   frequency    east-west   east-west   north-south   north-south
# 
# THESE ARE ALL WRONG THEY ARE FOR CHORD PATHFINDER
#   angular resolution     300 MHz    14.4 mrad       0.83°     19.6 mrad         1.12°
#   angular resolution    1500 MHz     2.9 mrad       0.17°      3.9 mrad         0.22°
#        field of view     300 MHz   158.6 mrad       9.09°    117.6 mrad         6.74°
#        field of view    1500 MHz    31.7 mrad       1.82°     23.5 mrad         1.35°

# Dishes

num_dishes_x: 8
num_dishes_y: 8
num_dishes: 64

# Telescope

telescope:
    name: CHORDTelescope
    require_gps: false
    origin_itrs_lat_deg: -33.42125
    origin_itrs_lon_deg: -70.86370
    # altitude: 458
    grid_x_axis: [1.0, 0.0, 0.0]
    grid_y_axis: [0.0, 1.0, 0.0]
    dish_elev_axis: [1.0, 0.0, 0.0]
    dish_vert_axis: [0.0, 0.0, 1.0]
    dish_coelev_deg: 0.0

    require_eop: false

    dish_separation_x_m: 0.6
    dish_separation_y_m: 0.6

    dish_inputs:
{% for y in range(0, 8) %}
{%   for x in range(0, 8) %}
    - dish_idx: {{x+8*y}}
      grid_x_idx: {{x}}
      grid_y_idx: {{y}}
      feed_pos_disp_m: [0.0, 0.0, 0.0]
      coelev_disp_deg: 0.0
      type: ArrayDish
      label: CHARTS-{{"ABCDEFGHIJKLMNOPQRSTUVWXYZ"[y]}}{{"{:02d}".format(x+1)}}
{%   endfor %}
{% endfor %}

################################################################################

# ADC

adc_frequency: 4.9152e+9        # [Hz]

################################################################################

# PFB

num_taps: 4
num_samples_per_frame: 16384

frequency_pool_rank: 0
frequency_pool_size: 16

num_frequencies: 336            # 672 frequencies / 2 gpus
# The frequency channels we keep.
#     A channel's frequency is   freq = channel * adc_frequency / num_samples_per_frame
#     Note that   channel = freq = 0   is the DC channel.
# TODO FIX THESE NUMBERS THEY ARE FROM CHORD
#     Channel 1536 has 300 MHz for CHORD, channel 7680 has 1500 MHz.
#     There are 5.12 channels per MHz, with a channel width of 195312.5 Hz.
# (These particular channels were chosen with a fixed step size between these channel boundaries.)
frequency_channels: [
    1000, 1002, 1004, 1006, 1008, 1010, 1012, 1014, 1016, 1018, 1020, 1022, 1024, 1026, 1028, 1030,
    1032, 1034, 1036, 1038, 1040, 1042, 1044, 1046, 1048, 1050, 1052, 1054, 1056, 1058, 1060, 1062,
    1064, 1066, 1068, 1070, 1072, 1074, 1076, 1078, 1080, 1082, 1084, 1086, 1088, 1090, 1092, 1094,
    1096, 1098, 1100, 1102, 1104, 1106, 1108, 1110, 1112, 1114, 1116, 1118, 1120, 1122, 1124, 1126,
    1128, 1130, 1132, 1134, 1136, 1138, 1140, 1142, 1144, 1146, 1148, 1150, 1152, 1154, 1156, 1158,
    1160, 1162, 1164, 1166, 1168, 1170, 1172, 1174, 1176, 1178, 1180, 1182, 1184, 1186, 1188, 1190,
    1192, 1194, 1196, 1198, 1200, 1202, 1204, 1206, 1208, 1210, 1212, 1214, 1216, 1218, 1220, 1222,
    1224, 1226, 1228, 1230, 1232, 1234, 1236, 1238, 1240, 1242, 1244, 1246, 1248, 1250, 1252, 1254,
    1256, 1258, 1260, 1262, 1264, 1266, 1268, 1270, 1272, 1274, 1276, 1278, 1280, 1282, 1284, 1286,
    1288, 1290, 1292, 1294, 1296, 1298, 1300, 1302, 1304, 1306, 1308, 1310, 1312, 1314, 1316, 1318,
    1320, 1322, 1324, 1326, 1328, 1330, 1332, 1334, 1336, 1338, 1340, 1342, 1344, 1346, 1348, 1350,
    1352, 1354, 1356, 1358, 1360, 1362, 1364, 1366, 1368, 1370, 1372, 1374, 1376, 1378, 1380, 1382,
    1384, 1386, 1388, 1390, 1392, 1394, 1396, 1398, 1400, 1402, 1404, 1406, 1408, 1410, 1412, 1414,
    1416, 1418, 1420, 1422, 1424, 1426, 1428, 1430, 1432, 1434, 1436, 1438, 1440, 1442, 1444, 1446,
    1448, 1450, 1452, 1454, 1456, 1458, 1460, 1462, 1464, 1466, 1468, 1470, 1472, 1474, 1476, 1478,
    1480, 1482, 1484, 1486, 1488, 1490, 1492, 1494, 1496, 1498, 1500, 1502, 1504, 1506, 1508, 1510,
    1512, 1514, 1516, 1518, 1520, 1522, 1524, 1526, 1528, 1530, 1532, 1534, 1536, 1538, 1540, 1542,
    1544, 1546, 1548, 1550, 1552, 1554, 1556, 1558, 1560, 1562, 1564, 1566, 1568, 1570, 1572, 1574,
    1576, 1578, 1580, 1582, 1584, 1586, 1588, 1590, 1592, 1594, 1596, 1598, 1600, 1602, 1604, 1606,
    1608, 1610, 1612, 1614, 1616, 1618, 1620, 1622, 1624, 1626, 1628, 1630, 1632, 1634, 1636, 1638,
    1640, 1642, 1644, 1646, 1648, 1650, 1652, 1654, 1656, 1658, 1660, 1662, 1664, 1666, 1668, 1670,
]

################################################################################

# Input frames

num_times: 16384                 # frame length is 16384 * 3.333 us = 54.613 ms

################################################################################

# Buffers

host_bf_mask_buffer:
    kotekan_buffer: standard
    num_frames: 1
    frame_size: sizeof_int8 * num_dishes * num_polarizations
    metadata_pool: main_pool

host_pl_mask_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: (64 / 8) * (num_dishes / 8) * num_polarizations * (num_frequencies / 4) * (num_times / 2 / 64)
    metadata_pool: main_pool
host_pl_mask_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (64 / 8) * (num_dishes / 8) * num_polarizations * (num_frequencies / 4) * (num_times / 2 / 64)
    metadata_pool: main_pool

host_pl_expanded_mask_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: (64 / 8) * (num_dishes / 8) * num_polarizations * num_frequencies * (num_times / 64)
    metadata_pool: main_pool
host_pl_expanded_mask_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (64 / 8) * (num_dishes / 8) * num_polarizations * num_frequencies * (num_times / 64)
    metadata_pool: main_pool

host_voltage_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: num_dishes * num_polarizations * num_frequencies * num_times
    metadata_pool: main_pool
host_voltage_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * num_dishes * num_polarizations * num_frequencies * num_times
    metadata_pool: main_pool

################################################################################

# Stages

run_invent_bf_mask:
    kotekan_stage: inventBFMask
    bf_mask: host_bf_mask_buffer

run_invent_pl_mask:
    kotekan_stage: inventPLMask
    pl_mask: host_pl_mask_buffer

# run_send_bf_mask:
#     gpu_0:
#         kotekan_stage: cudaProcess
#         gpu_id: 0
#         in_buffers:
#             host_bf_mask_buffer: host_bf_mask_buffer
#         out_buffers:
#         commands:
#         - name: cudaInputData
#           do_once: true
#           in_buf: host_bf_mask_buffer
#           gpu_mem: bf_mask_buffer
#         - name: cudaSyncInput

run_send_pl_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_mask_buffer: host_pl_mask_buffer
        out_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: (64 / 8) * (num_dishes / 8) * num_polarizations * (num_frequencies / 4) * (num_times / 2 / 64)
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_pl_mask_buffer
          signal_buf: host_pl_mask_ringbuffer
          gpu_mem_output: pl_mask_buffer

run_expand_pl_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
        out_buffers:
            host_pl_expanded_mask_ringbuffer: host_pl_expanded_mask_ringbuffer
        commands:
        - name: cudaPLMaskExpander
          pl_mask_name: pl_mask
          pl_expanded_mask_name: pl_expanded_mask

run_send_voltage:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_voltage_buffer: host_voltage_buffer
        out_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: num_dishes * num_polarizations * num_frequencies * num_times
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_voltage_buffer
          signal_buf: host_voltage_ringbuffer
          gpu_mem_output: voltage_buffer
