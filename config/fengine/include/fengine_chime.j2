# -*-yaml-*-

# CHIME F-Engine setup

# The pipeline follows config/chime_upgrade_frb.j2, the CHIME production X-engine, but reads its
# input from files (include/input_chime.j2) or invents it (include/invent_voltage_chime.j2), and
# writes its output to files.

################################################################################

# CHIME:
#             quantity   frequency   east-west   east-west   north-south   north-south
# 
#   angular resolution     400 MHz    9.4 mrad       0.54°      7.5 mrad         0.43°
#   angular resolution     800 MHz    4.7 mrad       0.27°      3.7 mrad         0.21°
#        field of view     400 MHz   37.5 mrad       2.15°   1918.7 mrad       109.93°
#        field of view     800 MHz   18.7 mrad       1.07°    959.3 mrad        54.97°

# Dishes

num_dishes_x: 4
num_dishes_y: 256
num_dishes: 1024

# Telescope

# As in config/chime_upgrade_frb.j2, but with the static time origin /gps_time and the default
# frequency map instead of asking the FPGA controller.
telescope:
    name: CHIMETelescope
    require_gps: true
    query_gps: false
    query_frequency_map: false
    require_frequency_map: false
    allow_default_frequency_map: true
    eop_updatable_config: /earth_rotation_data
    origin_itrs_lat_deg: +49.32070922 # centre of the array
    origin_itrs_lon_deg: -119.62367743
    grid_x_axis: [1.0, 0.0, 0.0]
    grid_y_axis: [0.0, 1.0, 0.0]
    dish_elev_axis: [1.0, 0.0, 0.0]
    dish_vert_axis: [0.0, 0.0, 1.0]
    dish_coelev_deg: 0.0

    require_eop: false

    dish_grid_size_x: num_dishes_x
    dish_grid_size_y: num_dishes_y
    dish_separation_x_m: 22.0
    dish_separation_y_m: 0.3048

    dish_inputs:
{% for x in range(0, 4) %}
{%   for y in range(0, 256) %}
    - dish_idx: {{y+256*x}}
      grid_x_idx: {{x}}
      grid_y_idx: {{y}}
      feed_pos_disp_m: [0.0, 0.0, 0.0]
      coelev_disp_deg: 0.0
      type: ArrayDish
      label: CHIME-{{"ABCD"[x]}}{{"{:04d}".format(y+1)}}
{%   endfor %}
{% endfor %}

    sampling_rate_MHz: adc_frequency / 1.0e+6
    fft_length: num_samples_per_frame
    min_science_freq_MHz: (2048 - 1023) * adc_frequency / num_samples_per_frame / 1.0e+6
    max_science_freq_MHz: (2048 -    0) * adc_frequency / num_samples_per_frame / 1.0e+6

gps_time:
    frame0_nano: 1767225600000000000 # 2026-01-01T00:00:00Z

earth_rotation_data:
    kotekan_update_endpoint: json
    earth_orientation_parameter_table:
    - {t_inst_ns: 0, delta_UT1_inst: 0.0, xp_as: 0.0, yp_as: 0.0}

################################################################################

# ADC

adc_frequency: 0.8e+9           # [Hz]

################################################################################

# PFB

num_taps: 4
num_samples_per_frame: 2048

frequency_pool_rank: 0
frequency_pool_size: 64

num_frequencies: 16       # 2048 frequencies / 64 gpus * 50% coverage
# The frequency channels we keep (include/frequency_channels_chime.j2).
#     A channel's frequency is   freq = (2048 - channel) * adc_frequency / num_samples_per_frame
#     Channel 2048 has 400 MHz for CHIME, channel 1024 has 800 MHz.
#     There are 2.56 channels per MHz, with a channel width of 390625 Hz.
{% from "include/frequency_channels_chime.j2" import frequency_channels %}
frequency_channels: {{ frequency_channels }}

################################################################################

# Input frames

num_times: 16384                # frame length is 16384 * 2.56 us = 41.94304 ms

# The bad feed mask is valid for this many input samples, about one second. This must be a
# multiple of num_times: rfi_downsampling_factor (and rfi_downsampling_factor *
# rfi_second_downsampling_factor) has to divide it, and the quotient has to be a multiple of
# rfi_num_times.
bf_mask_lifetime_in_samples: 24 * num_times

# The names config/chime_upgrade_frb.j2 uses, for the stages that read them
samples_per_data_set: num_times
num_local_freq: num_frequencies
num_elements: num_polarizations * num_dishes

################################################################################

# Updatable config. The REST endpoints are those of config/chime_upgrade_frb.j2.

updatable_config:
    # Bad input mask, in cylinder order (bufferBadInputs `input_order`)
    bad_inputs:
        kotekan_update_endpoint: json
        # yamlfix:off
        bad_inputs: &bad_inputs [
              46,   84,  107,  136,  142,  256,  257,  319,  348,  357,  369,
             370,  453,  550,  551,  579,  638,  688,  739,  742,  768,  784,
             807,  855,  944,  960,  967,  971,  981,  986, 1005, 1010, 1020,
            1023, 1058, 1141, 1166, 1225, 1280, 1281, 1285, 1311, 1314, 1343,
            1380, 1381, 1479, 1521, 1523, 1543, 1642, 1684, 1687, 1738, 1792,
            1794, 1910, 1912, 1943, 1945, 1950, 1982, 1984, 1987, 2032, 2034]
        # yamlfix:on
        start_time: 1535048997.
        update_id: "initial_flags"
    # RFI excision (include/rfi_chime.j2, include/n2k_chime.j2). 0 is a special case which
    # indicates that the `enabled` state is valid since startup (sequence number 0).
    rfi_first_stage_enabled:
        kotekan_update_endpoint: json
        enabled: true
        valid_at_time_ns: 0
    rfi_second_stage_enabled:
        kotekan_update_endpoint: json
        enabled: true
        valid_at_time_ns: 0
    rfi_second_stage_thresholds:
        kotekan_update_endpoint: json
        thresholds: []
        valid_at_time_ns: 0
    # FRB beamforming gains (include/frb_chime.j2). By default there are no gain files and
    # loadFeedGains uses its `default_gains`; the jinja variable `frb_gain_directory` sets the
    # directory, which is /mnt/frb-archiver/daily_gain_solutions/Latest_FRB in production.
    frb_gain:
        0:
            kotekan_update_endpoint: json
            gain_directory: "{{ frb_gain_directory | default('') }}"

################################################################################

# Buffers

host_bf_mask_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: int8
    extents: [1, num_polarizations, num_dishes]
    quantity_name: "bf_mask"
    dimnames: ["Tbf", "P", "D"]
    dimscalings: [bf_mask_lifetime_in_samples, 1, 1]
    metadata_pool: main_pool
host_bf_mask_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * num_dishes * num_polarizations * 1
    metadata_pool: main_pool

host_pl_mask_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: uint1x8
    extents: [num_times / 2 / 64, num_frequencies / 4, num_polarizations, num_dishes / 8, 64 / 8]
    quantity_name: "pl_mask"
    dimnames: ["T2hi64", "F4", "P", "D8", "T2lo64"]
    dimscalings: [128, 4, 1, 8, 16]
    metadata_pool: main_pool
host_pl_mask_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (64 / 8) * (num_dishes / 8) * num_polarizations * (num_frequencies / 4) * (num_times / 2 / 64)
    metadata_pool: main_pool

host_pl_expanded_mask_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (64 / 8) * (num_dishes / 8) * num_polarizations * num_frequencies * (num_times / 64)
    metadata_pool: main_pool

host_voltage_buffers:
    num_frames: buffer_depth
    value_type: int4x2_swapped_withoffset
    extents: [1, num_times, num_polarizations * num_dishes]
    quantity_name: "E"
    dimnames: ["F", "T", "E"]
    dimscalings: [1, 1, 1]
    metadata_pool: main_pool
    numa_0:
{% for id in range(16) %}   # num_frequencies = 16
        host_voltage_buffer_{{ id }}:
            kotekan_buffer: ndarray
{% endfor %}

host_voltage_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * num_dishes * num_polarizations * num_frequencies * num_times
    metadata_pool: main_pool

# The lost samples, one byte (1 = lost) per sample, for all dishes and polarizations of a group of
# 4 frequencies: lost_samples_buffer_<k> serves host_voltage_buffer_<4k> to <4k+3>.
# config/chime_upgrade_frb.j2 also zeroes the lost voltages with zeroSamples. zeroSamples is a
# second producer of the voltage buffers and relies on the lost samples being marked full after the
# voltages are written, as dpdk does. The file input and the generators produce the two streams
# independently, so there is no zeroSamples here; no samples are lost.
{% for id in range(16 // 4) %}   # num_frequencies = 16
lost_samples_buffer_{{ id }}:
    kotekan_buffer: ndarray
    num_frames: 6 * buffer_depth
    value_type: uint8
    extents: [num_times]
    quantity_name: "lost_samples"
    dimnames: ["T"]
    dimscalings: [1]
    metadata_pool: main_pool
{% endfor %}

################################################################################

# Stages

# The packet loss mask: a lost sample is lost for all dishes, polarizations and the 4 frequencies
# of its group
run_lost_samples_to_pl_mask:
    kotekan_stage: lostSamplesToPLMask
    pl_mask_buf: host_pl_mask_buffer
    lost_samples_buffers:
{% for id in range(16 // 4) %}   # num_frequencies = 16
    - lost_samples_buffer_{{ id }}
{% endfor %}

# The bad feed masks from /updatable_config/bad_inputs. N2Accumulate needs one mask frame per
# correlation frame, BB and FRB1 need the mask lifetime to equal their phase lifetimes, so there
# are two streams with the same content (include/n2k_chime.j2). Both apply an update at the same
# beamformer lifetime boundary.
set_bf_mask:
    updatable_config:
        bad_inputs: /updatable_config/bad_inputs
    # The mask streams start at the sequence number of the first voltage frame
    metadata_source: host_voltage_buffer_0
    bf_mask_update_alignment_in_samples: bf_mask_lifetime_in_samples
    for_beamformers:
        kotekan_stage: bufferBadInputs
        out_buf: host_bf_mask_buffer
    for_n2:
        kotekan_stage: bufferBadInputs
        out_buf: host_n2_bf_mask_buffer
        bf_mask_lifetime_in_samples: n2k_samples_per_data_set

run_send_bf_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_bf_mask_buffer: host_bf_mask_buffer
        out_buffers:
            host_bf_mask_ringbuffer: host_bf_mask_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: num_dishes * num_polarizations
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_bf_mask_buffer
          signal_buf: host_bf_mask_ringbuffer
          gpu_mem_output: bf_mask_buffer

run_send_pl_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_mask_buffer: host_pl_mask_buffer
        out_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: (64 / 8) * (num_dishes / 8) * num_polarizations * (num_frequencies / 4) * (num_times / 2 / 64)
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_pl_mask_buffer
          signal_buf: host_pl_mask_ringbuffer
          gpu_mem_output: pl_mask_buffer

run_expand_pl_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer
        out_buffers:
            host_pl_expanded_mask_ringbuffer: host_pl_expanded_mask_ringbuffer
        commands:
        - name: cudaPLMaskExpander
          pl_mask_name: pl_mask
          pl_expanded_mask_name: pl_expanded_mask

run_send_voltage:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
{% for id in range(16) %}   # num_frequencies = 16
            host_voltage_buffer_{{ id }}: host_voltage_buffer_{{ id }}
{% endfor %}
        out_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer
        commands:
        - name: cudaCopyNToRingbuffer
          ring_buffer_size: buffer_depth * input_size
          in_bufs: 
{% for id in range(16) %}   # num_frequencies = 16
          - host_voltage_buffer_{{ id }}
{% endfor %}
          signal_buf: host_voltage_ringbuffer
          gpu_mem_output: voltage_buffer
