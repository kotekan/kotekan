# -*-yaml-*-

# CHIME read initial conditions

################################################################################

# Stages

{% from "include/frequency_channels_chime.j2" import frequency_channels %}

read_data:
{% for id in range(16) %}   # num_frequencies = 16
    read_voltage_{{ id }}:
        kotekan_stage: hdf5FileReadSingleFile
        file_name: voltage
        frequency_channels: [{{ frequency_channels[id] }}]
        combine_dishes_and_polarizations: true
        transpose_frequency_and_time: true
        out_buf: host_voltage_buffer_{{ id }}
{% endfor %}

