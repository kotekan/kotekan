          gpu_mem_input: rfi_S012_buffer
          output_size: sizeof_uint64 * num_dishes * num_polarizations * 3 * num_frequencies * rfi_num_times
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_S012_buffer

