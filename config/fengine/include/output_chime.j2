        file_name: rfi_SKtilde
    write_rfi_RFImask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_RFImask_buffer
        file_name: rfi_RFImask
    write_rfi_SKbar:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_SKbar_buffer
        file_name: rfi_SKbar
    write_rfi_SKbartilde:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_SKbartilde_buffer
        file_name: rfi_SKbartilde
    write_n2k_correlation:
        kotekan_stage: hdf5FileWrite
        in_buf: host_n2k_correlation_buffer
        file_name: n2k_correlation
    write_n2k_counts:
        kotekan_stage: hdf5FileWrite
        in_buf: host_n2k_counts_buffer
        file_name: n2k_counts
    write_n2k_plcounts:
        kotekan_stage: hdf5FileWrite
        in_buf: host_n2k_plcounts_buffer
        file_name: n2k_plcounts
    write_n2k_rficounts:
