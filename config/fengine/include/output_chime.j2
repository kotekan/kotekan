# Output

write_data:
    create_single_file: true
    write_bf_mask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_bf_mask_buffer
        file_name: bf_mask
    write_pl_mask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_pl_mask_buffer
        file_name: pl_mask
    write_pl_expanded_mask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_pl_expanded_mask_buffer
        file_name: pl_expanded_mask
{% for id in range(16) %}
    write_voltage_{{ id }}:
        kotekan_stage: hdf5FileWrite
        in_buf: host_voltage_buffer_{{ id }}
        file_name: voltage_{{ id }}
        create_single_file: false  # not time-major
{% endfor %}
    write_scatter_indices:
        kotekan_stage: hdf5FileWrite
        in_buf: host_scatter_indices_buffer
        file_name: scatter_indices
        create_single_file: false  # not time-major
