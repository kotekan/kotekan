        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_S012bar_ringbuffer
          gpu_mem_input: rfi_S012bar_buffer
          output_size: sizeof_uint64 * num_dishes * num_polarizations * 3 * num_frequencies * rfi_num_times_bar
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_S012bar_buffer

run_recv_rfi_SKbar:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_rfi_SKbar_ringbuffer: host_rfi_SKbar_ringbuffer
        out_buffers:
