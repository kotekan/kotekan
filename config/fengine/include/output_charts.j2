# -*-yaml-*-

# CHARTS test output

################################################################################

# Buffers

# Host copies of GPU data, filled by the run_recv_* and run_frb23 stages for write_data

host_pl_expanded_mask_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    # frame_size: (64 / 8) * (num_dishes / 8) * num_polarizations * num_frequencies * (num_times / 64)
    value_type: uint1x8
    extents: [num_times / 64, num_frequencies, num_polarizations, num_dishes / 8, 64 / 8]
    quantity_name: "pl_mask_exp"
    dimnames: ["Thi64", "F", "P", "D8", "Tlo64"]
    dimscalings: [64, 1, 1, 8, 8]
    metadata_pool: main_pool

host_rfi_S012_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: uint64
    extents: [rfi_num_times, num_frequencies, 3, num_polarizations, num_dishes]
    quantity_name: "S012"
    dimnames: ["Trfi", "F", "S", "P", "D"]
    dimscalings: [rfi_downsampling_factor, 1, 1, 1, 1]
    metadata_pool: main_pool

host_rfi_S012bar_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: uint64
    extents: [rfi_num_times_bar, num_frequencies, 3, num_polarizations, num_dishes]
    quantity_name: "S012bar"
    dimnames: ["Trfibar", "F", "S", "P", "D"]
    dimscalings: [rfi_downsampling_factor * rfi_second_downsampling_factor, 1, 1, 1, 1]
    metadata_pool: main_pool

host_rfi_S012tilde_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: uint64
    extents: [rfi_num_times, num_frequencies, 3]
    quantity_name: "S012tilde"
    dimnames: ["Trfi", "F", "S"]
    dimscalings: [rfi_downsampling_factor, 1, 1]
    metadata_pool: main_pool

host_rfi_SKbar_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: float32
    extents: [rfi_num_times_bar, num_frequencies, 3, num_polarizations, num_dishes]
    quantity_name: "SKbar"
    dimnames: ["Trfibar", "F", "SK", "P", "D"]
    dimscalings: [rfi_downsampling_factor * rfi_second_downsampling_factor, 1, 1, 1, 1]
    metadata_pool: main_pool

host_rfi_SKbartilde_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: float32
    extents: [rfi_num_times_bar, num_frequencies, 3]
    quantity_name: "SKbartilde"
    dimnames: ["Trfibar", "F", "SK"]
    dimscalings: [rfi_downsampling_factor * rfi_second_downsampling_factor, 1, 1]
    metadata_pool: main_pool

host_frb1_beams_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    # frame_size: sizeof_float16 * frb1_num_beams_P * frb1_num_beams_Q * upchan_all_max_num_output_channels * frb_num_output_times
    value_type: float16
    extents: [frb_num_output_times, upchan_all_max_num_output_channels, frb1_num_beams_Q, frb1_num_beams_P]
    quantity_name: "I"
    dimnames: ["Ttilde", "Fbar", "beamQ", "beamP"]
    dimscalings: [frb_downsampling_factor, 1, 1, 1]
    metadata_pool: main_pool

host_frb2_beams_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    # frame_size: sizeof_float16 * frb2_num_beams * (upchan_all_max_output_channel - upchan_all_min_output_channel) * frb_num_output_times
    value_type: float16
    extents: [1, frb2_num_beams, upchan_all_max_output_channel - upchan_all_min_output_channel, frb_num_output_times]
    quantity_name: "I2"
    dimnames: ["Ttildehi256", "R", "Fbar", "Ttildelo256"]
    dimscalings: [frb_downsampling_factor * 256, 1, 1, frb_downsampling_factor]
    metadata_pool: main_pool

host_upchan_U32_expanded_pl_mask_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: (64 / 8) * (num_dishes / 8) * num_polarizations * upchan_U32_max_num_channels * (num_times / 64 / 32)
    metadata_pool: main_pool

host_upchan_U32_voltage_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    # frame_size: num_dishes * num_polarizations * (upchan_U32_max_num_channels * 32) * (num_times / 32)
    value_type: int4x2_swapped_withoffset
    extents: [num_times / 32, upchan_U32_max_num_channels * 32, num_polarizations, num_dishes]
    quantity_name: "Ebar"
    dimnames: ["Tbar", "Fbar", "P", "D"]
    dimscalings: [32, 1, 1, 1]
    metadata_pool: main_pool

################################################################################

# Stages

run_recv_pl_expanded_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_pl_expanded_mask_ringbuffer: host_pl_expanded_mask_ringbuffer
        out_buffers:
            host_pl_expanded_mask_buffer: host_pl_expanded_mask_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_pl_expanded_mask_ringbuffer
          gpu_mem_input: pl_expanded_mask_buffer
          output_size: (64 / 8) * (num_dishes / 8) * num_polarizations * num_frequencies * (num_times / 64)
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_pl_expanded_mask_buffer

run_recv_rfi_S012:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_rfi_S012_ringbuffer: host_rfi_S012_ringbuffer
        out_buffers:
            host_rfi_S012_buffer: host_rfi_S012_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_S012_ringbuffer
          gpu_mem_input: rfi_S012_buffer
          output_size: sizeof_uint64 * num_dishes * num_polarizations * 3 * num_frequencies * rfi_num_times
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_S012_buffer

run_recv_rfi_S012tilde:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_rfi_S012tilde_ringbuffer: host_rfi_S012tilde_ringbuffer
        out_buffers:
            host_rfi_S012tilde_buffer: host_rfi_S012tilde_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_S012tilde_ringbuffer
          gpu_mem_input: rfi_S012tilde_buffer
          output_size: sizeof_uint64 * 3 * num_frequencies * rfi_num_times
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_S012tilde_buffer

run_recv_rfi_S012bar:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_rfi_S012bar_ringbuffer: host_rfi_S012bar_ringbuffer
        out_buffers:
            host_rfi_S012bar_buffer: host_rfi_S012bar_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_S012bar_ringbuffer
          gpu_mem_input: rfi_S012bar_buffer
          output_size: sizeof_uint64 * num_dishes * num_polarizations * 3 * num_frequencies * rfi_num_times_bar
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_S012bar_buffer

run_recv_rfi_SKbar:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_rfi_SKbar_ringbuffer: host_rfi_SKbar_ringbuffer
        out_buffers:
            host_rfi_SKbar_buffer: host_rfi_SKbar_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_SKbar_ringbuffer
          gpu_mem_input: rfi_SKbar_buffer
          output_size: sizeof_float32 * num_dishes * num_polarizations * 3 * num_frequencies * rfi_num_times_bar
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_SKbar_buffer

run_recv_rfi_SKbarbartilde:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_rfi_SKbartilde_ringbuffer: host_rfi_SKbartilde_ringbuffer
        out_buffers:
            host_rfi_SKbartilde_buffer: host_rfi_SKbartilde_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_SKbartilde_ringbuffer
          gpu_mem_input: rfi_SKbartilde_buffer
          output_size: sizeof_float32 * 3 * num_frequencies * rfi_num_times_bar
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_SKbartilde_buffer

run_recv_upchan_U32_expanded_pl_mask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_upchan_U32_expanded_pl_mask_ringbuffer: host_upchan_U32_expanded_pl_mask_ringbuffer
        out_buffers:
            host_upchan_U32_expanded_pl_mask_buffer: host_upchan_U32_expanded_pl_mask_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_upchan_U32_expanded_pl_mask_ringbuffer
          gpu_mem_input: upchan_U32_expanded_pl_mask_buffer
          output_size: (64 / 8) * (num_dishes / 8) * num_polarizations * upchan_U32_max_num_channels * (num_times / 64 / 32)
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_upchan_U32_expanded_pl_mask_buffer

run_recv_upchan_U32_voltage:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_upchan_U32_voltage_ringbuffer: host_upchan_U32_voltage_ringbuffer
        out_buffers:
            host_upchan_U32_voltage_buffer: host_upchan_U32_voltage_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_upchan_U32_voltage_ringbuffer
          gpu_mem_input: upchan_U32_voltage_buffer
          output_size: num_dishes * num_polarizations * (upchan_U32_max_num_channels * 32) * (num_times / 32)
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_upchan_U32_voltage_buffer

run_recv_frb1_beams:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
        out_buffers:
            host_frb1_beams_buffer: host_frb1_beams_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_frb1_beams_ringbuffer
          gpu_mem_input: frb1_beams_buffer
          output_size: sizeof_float16 * frb1_num_beams_P * frb1_num_beams_Q * upchan_all_max_num_output_channels * frb_num_output_times
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_frb1_beams_buffer

# Output

write_data:
    create_single_file: true
    write_bf_mask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_bf_mask_buffer
        file_name: bf_mask
    write_pl_mask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_pl_mask_buffer
        file_name: pl_mask
    write_pl_expanded_mask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_pl_expanded_mask_buffer
        file_name: pl_expanded_mask
    write_voltage:
        kotekan_stage: hdf5FileWrite
        in_buf: host_voltage_buffer
        file_name: voltage
    write_rfi_S012:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_S012_buffer
        file_name: rfi_S012
    write_rfi_S012tilde:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_S012tilde_buffer
        file_name: rfi_S012tilde
    write_rfi_S012bar:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_S012bar_buffer
        file_name: rfi_S012bar
    write_rfi_SKtilde:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_SKtilde_buffer
        file_name: rfi_SKtilde
    write_rfi_RFImask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_RFImask_buffer
        file_name: rfi_RFImask
    write_rfi_SKbar:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_SKbar_buffer
        file_name: rfi_SKbar
    write_rfi_SKbartilde:
        kotekan_stage: hdf5FileWrite
        in_buf: host_rfi_SKbartilde_buffer
        file_name: rfi_SKbartilde
    write_n2k_correlation:
        kotekan_stage: hdf5FileWrite
        in_buf: host_n2k_correlation_buffer
        file_name: n2k_correlation
    write_n2k_counts:
        kotekan_stage: hdf5FileWrite
        in_buf: host_n2k_counts_buffer
        file_name: n2k_counts
    write_n2k_plcounts:
        kotekan_stage: hdf5FileWrite
        in_buf: host_n2k_plcounts_buffer
        file_name: n2k_plcounts
    write_n2k_rficounts:
        kotekan_stage: hdf5FileWrite
        in_buf: host_n2k_rficounts_buffer
        file_name: n2k_rficounts
    write_n2k_rfiframemask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_n2k_rfiframemask_buffer
        file_name: n2k_rfiframemask
    write_n2_vis:
        kotekan_stage: hdf5FileWrite
        in_buf: host_n2_vis_buffer
        file_name: n2_vis
        create_single_file: false # not implemented
        max_frames: 1 * num_frequencies
    write_bb_beam_positions:
        kotekan_stage: hdf5FileWrite
        in_buf: host_bb_beam_positions_buffer
        file_name: bb_beam_positions
        create_single_file: false  # not time-major
    write_bb_beam_ids:
        kotekan_stage: hdf5FileWrite
        in_buf: host_bb_beam_ids_buffer
        file_name: bb_beam_ids
        create_single_file: false  # not time-major
    write_bb_phase:
        kotekan_stage: hdf5FileWrite
        in_buf: host_bb_phase_buffer
        file_name: bb_phase
        create_single_file: true
    write_bb_shift:
        kotekan_stage: hdf5FileWrite
        in_buf: host_bb_shift_buffer
        file_name: bb_shift
        create_single_file: false  # not time-major
    write_bb_beams:
        kotekan_stage: hdf5FileWrite
        in_buf: host_bb_beams_buffer
        file_name: bb_beams
        create_single_file: false  # dim 0 has extent 1; single file needs a gap-free stream
    write_upchan_U32_gain:
        kotekan_stage: hdf5FileWrite
        in_buf: host_upchan_U32_gain_buffer
        file_name: upchan_U32_gain
        create_single_file: false  # not time-major
    write_upchan_U32_expanded_pl_mask:
        kotekan_stage: hdf5FileWrite
        in_buf: host_upchan_U32_expanded_pl_mask_buffer
        file_name: upchan_U32_expanded_pl_mask
    write_upchan_U32_voltage:
        kotekan_stage: hdf5FileWrite
        in_buf: host_upchan_U32_voltage_buffer
        file_name: upchan_U32_voltage
    write_frb1_U32_phase:
        kotekan_stage: hdf5FileWrite
        in_buf: host_frb1_U32_phase_buffer
        file_name: frb1_U32_phase
        create_single_file: true
    write_frb2_beam_positions:
        kotekan_stage: hdf5FileWrite
        in_buf: host_frb2_beam_positions_buffer
        file_name: frb2_beam_positions
        create_single_file: false  # not time-major
    write_frb1_beams:
        kotekan_stage: hdf5FileWrite
        in_buf: host_frb1_beams_buffer
        file_name: frb1_beams
    write_frb2_beams:
        kotekan_stage: hdf5FileWrite
        in_buf: host_frb2_beams_buffer
        file_name: frb2_beams
        max_frames: 3
        create_single_file: false  # dim 0 has extent 1; single file needs a gap-free stream
