# -*-yaml-*-

# HIRAX FRB beamformer setup

################################################################################

# cudaQuantize requires `frb_num_output_times` to be a multiple of 256
frb_num_output_times: 256
frb1_num_beams_P: 2 * num_dishes_x
frb1_num_beams_Q: 2 * num_dishes_y
frb1_input_scale: 1.0 / 32

frb2_num_beams_x: 32
frb2_num_beams_y: 32
frb2_num_beams: frb2_num_beams_x * frb2_num_beams_y
frb2_beam_separation_x: 5.0 / 32
frb2_beam_separation_y: 5.0 / 32

frb_chunk_size: 256

################################################################################

# Buffers

# Phases

host_frb1_U8_phase_buffer:
    kotekan_buffer: standard
    num_frames: 1
    frame_size: sizeof_float16 * num_components * num_dishes_y * num_dishes_x * upchan_U8_max_num_channels * 8 * num_polarizations
    metadata_pool: main_pool

host_frb1_U16_phase_buffer:
    kotekan_buffer: standard
    num_frames: 1
    frame_size: sizeof_float16 * num_components * num_dishes_y * num_dishes_x * upchan_U16_max_num_channels * 16 * num_polarizations
    metadata_pool: main_pool

host_frb1_U32_phase_buffer:
    kotekan_buffer: standard
    num_frames: 1
    frame_size: sizeof_float16 * num_components * num_dishes_y * num_dishes_x * upchan_U32_max_num_channels * 32 * num_polarizations
    metadata_pool: main_pool

host_frb2_beam_positions_buffer:
    kotekan_buffer: standard
    num_frames: 1
    frame_size: sizeof_float32 * 2 * frb2_num_beams
    metadata_pool: main_pool

host_frb2_beam_ids_buffer:
    kotekan_buffer: standard
    num_frames: 1
    frame_size: sizeof_uint64 * frb2_num_beams
    metadata_pool: main_pool

host_frb2_weights_buffer:
    kotekan_buffer: standard
    num_frames: 1
    frame_size: sizeof_float16 * (2 * num_dishes_y) * (2 * num_dishes_x) * (frb2_num_beams_x * frb2_num_beams_y) * (upchan_all_max_output_channel - upchan_all_min_output_channel)
    metadata_pool: main_pool

# Beams

host_frb1_beams_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: sizeof_float16 * frb1_num_beams_P * frb1_num_beams_Q * upchan_all_max_num_output_channels * frb_num_output_times
    metadata_pool: main_pool
host_frb1_beams_ringbuffer:
    kotekan_buffer: ring
    num_frames: buffer_depth
    ring_buffer_size: buffer_depth * sizeof_float16 * frb1_num_beams_P * frb1_num_beams_Q * upchan_all_max_num_output_channels * frb_num_output_times
    metadata_pool: main_pool

host_frb2_beams_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: sizeof_float16 * frb2_num_beams * (upchan_all_max_output_channel - upchan_all_min_output_channel) * frb_num_output_times
    metadata_pool: main_pool

host_frb3_beams_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    # `1/2` because the output is of type `int4`
    frame_size: frb2_num_beams * (upchan_all_max_output_channel - upchan_all_min_output_channel) * frb_num_output_times / 2
    metadata_pool: main_pool

host_frb3_beams_offsetscale_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    # the output is quantized in chunks of `frb_chunk_size`
    frame_size: sizeof_float16 * 2 * frb2_num_beams * (upchan_all_max_output_channel - upchan_all_min_output_channel) * frb_num_output_times / frb_chunk_size
    metadata_pool: main_pool

################################################################################

# Stages

# FRB 1

run_set_frb1_U8_phase:
    kotekan_stage: setFRB1Phase
    upchan_factor: 8
    upchan_min_channel: upchan_U8_min_channel
    upchan_max_channel: upchan_U8_max_channel
    upchan_max_num_channels: upchan_U8_max_num_channels
    frb1_phase: host_frb1_U8_phase_buffer

run_set_frb1_U16_phase:
    kotekan_stage: setFRB1Phase
    upchan_factor: 16
    upchan_min_channel: upchan_U16_min_channel
    upchan_max_channel: upchan_U16_max_channel
    upchan_max_num_channels: upchan_U16_max_num_channels
    frb1_phase: host_frb1_U16_phase_buffer

run_set_frb1_U32_phase:
    kotekan_stage: setFRB1Phase
    upchan_factor: 32
    upchan_min_channel: upchan_U32_min_channel
    upchan_max_channel: upchan_U32_max_channel
    upchan_max_num_channels: upchan_U32_max_num_channels
    frb1_phase: host_frb1_U32_phase_buffer

run_frb1_U8:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_upchan_U8_voltage_ringbuffer: host_upchan_U8_voltage_ringbuffer
            host_frb1_U8_phase_buffer: host_frb1_U8_phase_buffer
        out_buffers:
            host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_frb1_U8_phase_buffer
          gpu_mem: frb1_U8_phase_buffer
        - name: cudaSyncInput
        - name: cudaFRBBeamformer_hirax_U8
          voltage_name: upchan_U8_voltage
          frb_phase_name: frb1_U8_phase
          frb_beamgrid_name: frb1_beams
          Fbar_in_min: 0
          Fbar_in_max: upchan_U8_max_output_channel - upchan_U8_min_output_channel
          Fbar_out_min: upchan_U8_min_output_channel
          Fbar_out_max: upchan_U8_max_output_channel

run_frb1_U16:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_upchan_U16_voltage_ringbuffer: host_upchan_U16_voltage_ringbuffer
            host_frb1_U16_phase_buffer: host_frb1_U16_phase_buffer
        out_buffers:
            host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_frb1_U16_phase_buffer
          gpu_mem: frb1_U16_phase_buffer
        - name: cudaSyncInput
        - name: cudaFRBBeamformer_hirax_U16
          voltage_name: upchan_U16_voltage
          frb_phase_name: frb1_U16_phase
          frb_beamgrid_name: frb1_beams
          Fbar_in_min: 0
          Fbar_in_max: upchan_U16_max_output_channel - upchan_U16_min_output_channel
          Fbar_out_min: upchan_U16_min_output_channel
          Fbar_out_max: upchan_U16_max_output_channel

run_frb1_U32:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_upchan_U32_voltage_ringbuffer: host_upchan_U32_voltage_ringbuffer
            host_frb1_U32_phase_buffer: host_frb1_U32_phase_buffer
        out_buffers:
            host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_frb1_U32_phase_buffer
          gpu_mem: frb1_U32_phase_buffer
        - name: cudaSyncInput
        - name: cudaFRBBeamformer_hirax_U32
          voltage_name: upchan_U32_voltage
          frb_phase_name: frb1_U32_phase
          frb_beamgrid_name: frb1_beams
          Fbar_in_min: 0
          Fbar_in_max: upchan_U32_max_output_channel - upchan_U32_min_output_channel
          Fbar_out_min: upchan_U32_min_output_channel
          Fbar_out_max: upchan_U32_max_output_channel

# FRB 2 and 3

run_set_frb2_beams:
    kotekan_stage: setFRBBeams
    out_pos_buf: host_frb2_beam_positions_buffer
    out_id_buf: host_frb2_beam_ids_buffer
    mode: grid_degrees
    num_beams: frb2_num_beams
    num_x: frb2_num_beams_x
    num_y: frb2_num_beams_y
    x_min: -frb2_beam_separation_x * (frb2_num_beams_x - 1) / 2.0
    x_max: frb2_beam_separation_x * (frb2_num_beams_x - 1) / 2.0
    y_min: -frb2_beam_separation_y * (frb2_num_beams_y - 1) / 2.0
    y_max: frb2_beam_separation_y * (frb2_num_beams_y - 1) / 2.0

run_calc_frb2_weights:
    kotekan_stage: calcFRB2Weights
    frb2_num_frequencies: upchan_all_max_output_channel - upchan_all_min_output_channel
    frb2_beam_positions: host_frb2_beam_positions_buffer
    frb2_weights: host_frb2_weights_buffer
    num_threads: 32

run_frb23:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
            host_frb2_weights_buffer: host_frb2_weights_buffer
        out_buffers:
            host_frb2_beams_buffer: host_frb2_beams_buffer
            host_frb3_beams_buffer: host_frb3_beams_buffer
            host_frb3_beams_offsetscale_buffer: host_frb3_beams_offsetscale_buffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_frb2_weights_buffer
          gpu_mem: frb2_weights_buffer
        - name: cudaSyncInput
        - name: cudaFRBBeamReformer
          frb1_max_num_frequencies: upchan_all_max_num_output_channels
          frb1_max_num_times: buffer_depth * frb_num_output_times
          frb2_num_frequencies: upchan_all_max_output_channel - upchan_all_min_output_channel
          frb2_num_times: frb_num_output_times
          in_signal: host_frb1_beams_ringbuffer
          frb1_beams_name: frb1_beams
          frb2_weights_name: frb2_weights
          frb2_beams_name: frb2_beams
        - name: cudaQuantize4
          # the output is quantized in chunks of `frb_chunk_size`
          num_beams: frb2_num_beams
          num_frequencies: upchan_all_max_output_channel - upchan_all_min_output_channel
          num_times: frb_num_output_times
          stddev_cutoff: 3.0
          gpu_mem_input: frb2_beams
          gpu_mem_output: frb3_beams
          gpu_mem_offsetscale: frb3_beams_offsetscale
        - name: cudaSyncOutput
        - name: cudaOutputData
          # TODO: Don't do this in production
          gpu_mem: frb2_beams_buffer
          out_buf: host_frb2_beams_buffer
        - name: cudaOutputData
          gpu_mem: frb3_beams_buffer
          out_buf: host_frb3_beams_buffer
        - name: cudaOutputData
          gpu_mem: frb3_beams_offsetscale_buffer
          out_buf: host_frb3_beams_offsetscale_buffer
