run_frb1_U1:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer
            host_frb1_U1_phase_buffer: host_frb1_U1_phase_buffer
        out_buffers:
            host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_frb1_U1_phase_buffer
          gpu_mem: frb1_U1_phase_buffer
        - name: cudaSyncInput
        - name: cudaFRBBeamformer_pathfinder_U1
          voltage_name: voltage
          frb_phase_name: frb1_U1_phase
          frb_beamgrid_name: frb1_beams
          Fbar_in_min: upchan_U1_min_channel
          Fbar_in_max: upchan_U1_max_channel
          Fbar_out_min: upchan_U1_min_output_channel
          Fbar_out_max: upchan_U1_max_output_channel

