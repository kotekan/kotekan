# FRB 2 and 3

run_calc_frb2_weights:
    # kotekan_stage: calcFRB2Weights
    kotekan_stage: calcFRB2Weights_Seth
    frb2_num_frequencies: upchan_all_max_output_channel - upchan_all_min_output_channel
    frb2_beam_positions: host_frb2_beam_positions_buffer
    frb2_beam_ids: host_frb2_beam_ids_buffer
    frb2_weights: host_frb2_weights_buffer

run_frb23:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
            host_frb2_weights_buffer: host_frb2_weights_buffer
        out_buffers:
            host_frb2_beams_buffer: host_frb2_beams_buffer
            host_frb3_beams_buffer: host_frb3_beams_buffer
            host_frb3_beams_meanstd_buffer: host_frb3_beams_meanstd_buffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_frb2_weights_buffer
          gpu_mem: frb2_weights_buffer
        - name: cudaFRBBeamReformer
          max_num_local_freq: upchan_all_max_num_output_channels
          num_local_freq: upchan_all_max_output_channel - upchan_all_min_output_channel
          beam_grid_size_P: frb_num_beams_P
          beam_grid_size_Q: frb_num_beams_Q
          num_beams: frb2_num_beams
          samples_per_data_set: frb_num_output_times
          in_signal: host_frb1_beams_ringbuffer
          gpu_mem_beamgrid: frb1_beams
          gpu_mem_weights: frb2_weights
          gpu_mem_beamout: frb2_beams
        - name: cudaQuantize
          # the output is quantized in chunks of `frb_chunk_size`
          num_beams: frb2_num_beams
          num_frequencies: upchan_all_max_output_channel - upchan_all_min_output_channel
          num_times: frb_num_output_times
          gpu_mem_input: frb2_beams
          gpu_mem_output: frb3_beams
          gpu_mem_meanstd: frb3_beams_meanstd
        - name: cudaSyncOutput
        - name: cudaOutputData
          # TODO: Don't do this in production
          gpu_mem: frb2_beams_buffer
          out_buf: host_frb2_beams_buffer
        - name: cudaOutputData
          gpu_mem: frb3_beams_buffer
          out_buf: host_frb3_beams_buffer
        - name: cudaOutputData
          gpu_mem: frb3_beams_meanstd_buffer
          out_buf: host_frb3_beams_meanstd_buffer

# Network send

send_frb:
    kotekan_stage: pirateFrbSend
    intensity: host_frb3_beams_buffer
    offset_scale: host_frb3_beams_meanstd_buffer
    beam_positions: host_frb2_beam_positions_buffer
    beam_ids: host_frb2_beam_ids_buffer

