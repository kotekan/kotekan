# -*-yaml-*-

# CHIME n2k setup

# The N2 chain of config/chime_upgrade_frb.j2: counts from the lost samples (lostSamplesToN2Counts),
# integrations with CHIMEv1 variance, eigendecomposition and conversion to visibility frames. As
# in the pathfinder and CHORD, N2Accumulate also reads the bad feed mask, which
# config/chime_upgrade_frb.j2 does not. The integrations are 1 s instead of production's 10 s, so
# that a short input file gives an integration.

################################################################################

# Correlator setup
n2k_sub_integration_ntime: 16384
# n2k_samples_per_data_set = max(num_times, n2k_sub_integration_ntime)
n2k_samples_per_data_set: 16384

################################################################################

# Buffers

n2k_num_subintegrations: n2k_samples_per_data_set / n2k_sub_integration_ntime

n2k_correlation_blocksize: 16
n2k_correlation_num_elements: num_dishes * num_polarizations
n2k_correlation_linear_num_blocks: (n2k_correlation_num_elements + 1) / n2k_correlation_blocksize
n2k_correlation_triangle_num_blocks: n2k_correlation_linear_num_blocks * (n2k_correlation_linear_num_blocks + 1) / 2
n2k_correlation_triangle_size: n2k_correlation_blocksize * n2k_correlation_blocksize * n2k_correlation_triangle_num_blocks

n2k_counts_blocksize: 8
n2k_counts_num_elements: num_dishes / 8 * num_polarizations
n2k_counts_linear_num_blocks: (n2k_counts_num_elements + 1) / n2k_counts_blocksize
n2k_counts_triangle_num_blocks: n2k_counts_linear_num_blocks * (n2k_counts_linear_num_blocks + 1) / 2
n2k_counts_triangle_size: n2k_counts_blocksize * n2k_counts_blocksize * n2k_counts_triangle_num_blocks

host_n2k_correlation_buffer:
    kotekan_buffer: ndarray
    num_frames: 4 * buffer_depth # 4 times larger as buffer for a slow N2Accumulate
    value_type: int32
    extents: [n2k_num_subintegrations, num_frequencies, n2k_correlation_triangle_num_blocks, n2k_correlation_blocksize, n2k_correlation_blocksize, 2]
    quantity_name: "n2k_correlation"
    dimnames: ["Tc", "F", "DPhi", "DPlo1", "DPlo2", "C"]
    dimscalings: [n2k_sub_integration_ntime, 1, 16, 1, 1, 1]
    metadata_pool: main_pool

host_n2k_counts_buffer:
    kotekan_buffer: ndarray
    num_frames: 4 * buffer_depth # 4 times larger as buffer for a slow N2Accumulate
    value_type: int32
    extents: [n2k_num_subintegrations, num_frequencies, n2k_counts_triangle_num_blocks, n2k_counts_blocksize, n2k_counts_blocksize]
    quantity_name: "n2k_counts"
    dimnames: ["Tc", "F", "D8Phi", "D8Plo1", "D8Plo2"]
    dimscalings: [n2k_sub_integration_ntime, 1, 64, 8, 8]
    metadata_pool: main_pool

host_n2k_plcounts_buffer:
    kotekan_buffer: ndarray
    num_frames: 4 * buffer_depth # 4 times larger as buffer for a slow N2Accumulate
    value_type: int32
    extents: [n2k_num_subintegrations, num_frequencies]
    quantity_name: "pl_lost_counts_scalar"
    dimnames: ["Tc", "F"]
    dimscalings: [n2k_sub_integration_ntime, 1]
    metadata_pool: main_pool

host_n2k_rficounts_buffer:
    kotekan_buffer: ndarray
    num_frames: 4 * buffer_depth # 4 times larger as buffer for a slow N2Accumulate
    value_type: int32
    extents: [n2k_num_subintegrations, num_frequencies]
    quantity_name: "RFImask_counts"
    dimnames: ["Tc", "F"]
    dimscalings: [n2k_sub_integration_ntime, 1]
    metadata_pool: main_pool

host_n2k_rfiframemask_buffer:
    kotekan_buffer: ndarray
    num_frames: 4 * buffer_depth # 4 times larger as buffer for a slow N2Accumulate
    value_type: uint8
    extents: [n2k_num_subintegrations, num_frequencies]
    quantity_name: "RFIFrameMask"
    dimnames: ["Tc", "F"]
    dimscalings: [n2k_sub_integration_ntime, 1]
    metadata_pool: main_pool

host_n2_vis_buffer:
    kotekan_buffer: N2
    n2_layout: "FullUpperTri"
    num_elements: n2k_correlation_num_elements
    num_frames: buffer_depth * num_frequencies
    num_ev: 0
    metadata_pool: n2_pool

# Bad feed mask for N2Accumulate, which needs one mask frame per correlation frame. BB and FRB1
# need the mask lifetime to equal their phase lifetimes, a multiple of the FRB processing quantum,
# so they cannot share this stream. It carries the same mask as host_bf_mask_buffer
# (include/fengine_chime.j2). N2Accumulate holds each mask frame until its correlation frame is
# accumulated, so the depth bounds the GPU's lead over it.
n2_bf_mask_buffer_depth: 12 * buffer_depth
n2_bf_mask_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: n2_bf_mask_buffer_depth + 4 * buffer_depth
host_n2_bf_mask_buffer:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: n2_bf_mask_buffer_depth
    value_type: int8
    extents: [1, num_polarizations, num_dishes]
    quantity_name: "bf_mask"
    dimnames: ["Tbf", "P", "D"]
    dimscalings: [n2k_samples_per_data_set, 1, 1]
    metadata_pool: n2_bf_mask_pool

# Visibility matrix and eigendecomposition

num_ev_to_calculate: 4

vis_pool:
    kotekan_metadata_pool: VisMetadata
    num_metadata_objects: buffer_depth * num_frequencies

eig_buffer:
    kotekan_buffer: N2
    num_ev: num_ev_to_calculate
    n2_layout: "FullUpperTri"
    num_frames: buffer_depth * num_frequencies
    metadata_pool: n2_pool

failed_buffer:
    kotekan_buffer: N2
    num_ev: 0
    n2_layout: "FullUpperTri"
    num_frames: buffer_depth * num_frequencies
    metadata_pool: n2_pool

vis_buffer:
    kotekan_buffer: vis
    num_ev: num_ev_to_calculate
    num_frames: buffer_depth * num_frequencies
    metadata_pool: vis_pool

################################################################################

# Stages

run_n2k_correlation:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_xposed_voltage_ringbuffer: host_xposed_voltage_ringbuffer
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer
        out_buffers:
            host_n2k_correlation_buffer: host_n2k_correlation_buffer
        commands:
        - name: cudaCorrelator
          num_elements: num_dishes * num_polarizations
          num_local_freq: num_frequencies
          samples_per_data_set: n2k_samples_per_data_set
          sub_integration_ntime: n2k_sub_integration_ntime
          voltage_name: xposed_voltage
          rfi_RFImask_name: rfi_RFImask
          n2k_correlation_name: n2k_correlation
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: n2k_correlation_buffer
          out_buf: host_n2k_correlation_buffer

# The valid sample counts of the correlator products, from the lost samples (which hold for all
# inputs) and the RFI mask
run_n2k_counts:
    kotekan_stage: lostSamplesToN2Counts
    num_n2k_freq: num_frequencies
    sub_integration_ntime: n2k_sub_integration_ntime
    rfi_mask_buf: host_rfi_RFImask_buffer
    lost_samples_buffers:
{% for id in range(16 // 4) %}   # num_frequencies = 16
    - lost_samples_buffer_{{ id }}
{% endfor %}
    n2k_counts_buf: host_n2k_counts_buffer

run_n2_counting:
    num_local_freq: num_frequencies
    samples_per_data_set: n2k_samples_per_data_set
    sub_integration_ntime: n2k_sub_integration_ntime

    count_rfi_mask:
        kotekan_stage: RfiMaskSum
        in_buf: host_rfi_RFImask_buffer
        out_buf: host_n2k_rficounts_buffer

    count_pl:
        kotekan_stage: CountLostPLSamplesScalar
        in_buf: host_pl_mask_buffer
        out_buf: host_n2k_plcounts_buffer
        packet_loss_is_scalar: true

    compute_RFI_frame_mask:
        kotekan_stage: RfiFrameMask
        in_buf: host_rfi_SKtilde_buffer
        out_buf: host_n2k_rfiframemask_buffer
        enabled_updatable_config: /updatable_config/rfi_second_stage_enabled
        thresholds_updatable_config: /updatable_config/rfi_second_stage_thresholds

run_N2_accumulate:
    kotekan_stage: N2Accumulate
    samples_per_data_set: n2k_samples_per_data_set
    sub_integration_ntime: n2k_sub_integration_ntime
    # About 1 s; production (config/chime_upgrade_frb.j2) uses 240 frames, about 10 s
    num_subintegrations_per_bin: 24
    num_elements: n2k_correlation_num_elements
    num_freq_per_n2k_frame: num_frequencies
    packet_loss_is_scalar: true
    input_order: CHIMEBeamformer
    num_ev: 0 # only allowed value
    variance_mode: CHIMEv1
    num_workers: 3
    in_buf: host_n2k_correlation_buffer
    in_counts_buf: host_n2k_counts_buffer
    in_plcounts_buf: host_n2k_plcounts_buffer
    in_rficounts_buf: host_n2k_rficounts_buffer
    in_rfiframemask_buf: host_n2k_rfiframemask_buffer
    in_bad_feed_mask_buf: host_n2_bf_mask_buffer
    out_buf: host_n2_vis_buffer

dataset_manager:
    use_dataset_broker: False

{% from "include/frequency_channels_chime.j2" import frequency_channels %}

eigencalc:
    kotekan_stage: EigenN2Iter
    num_blaze_workers: 3
    num_ev: num_ev_to_calculate
    in_buf: host_n2_vis_buffer
    out_buf: eig_buffer
    failed_buf: failed_buffer
    # Convergence config from chime science run
    tol_eval: 0.00001
    tol_evec: 0.0001
    max_iterations: 19
    num_ev_conv: 2
    krylov: 2
    subspace: 1
    # Masking config from chime science run
    diagonal_bands_filled: [ [0, 30], [251, 262] ]
    # The initial bad inputs of /updatable_config/bad_inputs (include/fengine_chime.j2), in
    # cylinder order, as in config/chime_upgrade_frb.j2.
    # TODO: Check that this is the input order EigenN2Iter expects.
    exclude_inputs: *bad_inputs

vis_convert:
    kotekan_stage: n2FrameToVisFrame
    n2_buf: eig_buffer
    vis_buf: vis_buffer
    freq_ids: {{ frequency_channels }}
