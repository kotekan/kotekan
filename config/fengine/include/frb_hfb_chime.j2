# Stages

# FRB 1

run_set_frb1_hfb_U128_phase:
    kotekan_stage: setFRB1Phase
    num_dishes_x: 256           # tranposed dish layout
    num_dishes_y: 4
    upchan_factor: 128
    upchan_min_channel: upchan_hfb_upchan_U128_min_channel
    upchan_max_channel: upchan_hfb_upchan_U128_max_channel
    upchan_max_num_channels: upchan_hfb_upchan_U128_max_num_channels
    frb1_phase: host_frb1_hfb_U128_phase_buffer

run_frb1_hfb_U128:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_upchan_U128_voltage_ringbuffer: host_upchan_U128_voltage_ringbuffer
            host_frb1_hfb_U128_phase_buffer: host_frb1_hfb_U128_phase_buffer
        out_buffers:
            host_frb1_hfb_beams_ringbuffer: host_frb1_hfb_beams_ringbuffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_frb1_hfb_U128_phase_buffer
          gpu_mem: frb1_hfb_U128_phase_buffer
        - name: cudaSyncInput
        - name: cudaCHIMEFRBBeamformer_chime_U128
          voltage_name: upchan_U128_voltage
          frb_phase_name: frb1_hfb_U128_phase
          frb_beamgrid_name: frb1_hfb_beams

