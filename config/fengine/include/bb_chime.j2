# -*-yaml-*-

# CHIME baseband beamformer setup

################################################################################

bb_num_beams_x: 1
bb_num_beams_y: 32              # 16
bb_num_beams: bb_num_beams_x * bb_num_beams_y
bb_beam_separation_x: 1.3       # 1.3 degrees
bb_beam_separation_y: 90.0 / 32 # 90 degrees

# The baseband beams are formed as "incoherent sum" over dishes dishes
# (sqrt(num_dishes)), and are multiplied by 127 (the scaling of the
# phase matrix). Thus:
#     log2(sqrt(num_dishes)) + 7
bb_scale: 12

################################################################################

# Buffers

host_bb_beam_positions_buffer:
    kotekan_buffer: ndarray
    num_frames: 1
    value_type: float32
    extents: [bb_num_beams, 2]
    metadata_pool: main_pool

host_bb_beam_ids_buffer:
    kotekan_buffer: ndarray
    num_frames: 1
    value_type: uint64
    extents: [bb_num_beams]
    metadata_pool: main_pool

host_bb_phase_buffer:
    kotekan_buffer: ndarray
    num_frames: 1
    value_type: int8
    extents: [num_frequencies, num_polarizations, bb_num_beams, num_dishes, num_components]
    metadata_pool: main_pool

host_bb_shift_buffer:
    kotekan_buffer: ndarray
    num_frames: 1
    value_type: int32
    extents: [num_frequencies, num_polarizations, bb_num_beams]
    metadata_pool: main_pool

host_bb_beams_buffer:
    kotekan_buffer: standard
    num_frames: buffer_depth
    frame_size: num_times * num_polarizations * num_frequencies * bb_num_beams
    metadata_pool: main_pool

################################################################################

# Stages

run_set_bb_beams:
    kotekan_stage: setBBBeams
    in_clock_buf: host_xposed_voltage_buffer
    out_pos_buf: host_bb_beam_positions_buffer
    out_id_buf: host_bb_beam_ids_buffer
    fixed_mode: grid_degrees
    time_downsampling_fpga: 1
    num_x: bb_num_beams_x
    num_y: bb_num_beams_y
    x_min: -bb_beam_separation_x * (bb_num_beams_x - 1) / 2.0
    x_max: bb_beam_separation_x * (bb_num_beams_x - 1) / 2.0
    y_min: -bb_beam_separation_y * (bb_num_beams_y - 1) / 2.0
    y_max: bb_beam_separation_y * (bb_num_beams_y - 1) / 2.0
    tracking_beams: []
    num_beams: bb_num_beams + 0

run_calc_bb_phase:
    kotekan_stage: calcBBPhase
    bb_beam_positions: host_bb_beam_positions_buffer
    bb_phase: host_bb_phase_buffer
    bb_shift: host_bb_shift_buffer

run_bb:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_xposed_voltage_ringbuffer: host_xposed_voltage_ringbuffer
            host_bb_phase_buffer: host_bb_phase_buffer
            host_bb_shift_buffer: host_bb_shift_buffer
        out_buffers:
            host_bb_beams_buffer: host_bb_beams_buffer
        commands:
        - name: cudaInputData
          do_once: true
          in_buf: host_bb_phase_buffer
          gpu_mem: bb_phase_buffer
        - name: cudaInputData
          do_once: true
          in_buf: host_bb_shift_buffer
          gpu_mem: bb_shift_buffer
        - name: cudaSyncInput
        - name: cudaBasebandBeamformer_chime
          voltage_name: xposed_voltage
          bb_phase_name: bb_phase
          bb_shift_name: bb_shift
          bb_beams_name: bb_beams
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: bb_beams_buffer
          out_buf: host_bb_beams_buffer
