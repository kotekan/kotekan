# -*-yaml-*-

################################################################################
#
# Run a CHORD pathfinder test
#
################################################################################

---
log_level: debug
poison_buffers: true

fengine_num_frames: 25
fengine_repeat_count: 1

skip_julia: false

base_dir: data/fengine_frb_pathfinder
prefix_hostname: false
prefix_host_rank: true

# The largest upchannelization factor used in this run. All upchannelizers delay their
# output so that it is aligned in time with that of the largest factor.
max_upchannelization_factor: 64

{% include "include/defs.j2" %}
{% include "include/fengine_pathfinder.j2" %}

{% include "include/rfi_pathfinder.j2" %}
{% include "include/n2k_pathfinder.j2" %}
{% include "include/bb_pathfinder.j2" %}
{% include "include/upchan_pathfinder.j2" %}
{% include "include/frb_pathfinder.j2" %}
...
