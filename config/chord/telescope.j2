{#-
  telescope.j2
  The CHORD pathfinder telescope: site geometry, the dish table and the EOP hook.
  Included by pathfinder.j2 (X-engine) and recv.j2 (receiver) so both label the same
  element axis from one dish_inputs table; the receiver's hdf5N2Write would write files
  mislabeled if its table ever diverged from the X-engine's at the same connected count.
-#}
telescope:
    name: CHORDTelescope
    sampling_rate_MHz: 3200.0
    fft_length: 16384
    nyquist_zone: 1
    min_science_freq_MHz: 300
    max_science_freq_MHz: 1500

    origin_itrs_lat_deg: 49.32075144444
    origin_itrs_lon_deg: -119.62081125

    grid_x_axis: [ 0.999974342398359362,
                -0.000037539331442772,
                -0.007163318767675494]
    grid_y_axis: [0.000065403387739210,
                0.999992433220348809,
                0.003889630373557614]

    dish_elev_axis: [0.99999999838132391,
                   -0.000056897733584327,
                   0.0]
    dish_vert_axis: [0.0, 0.0, 1.0]

    dish_coelev_deg: -27.3  # Approx Tau A (Crab) pointing
    check_duplicate_dish_grid: true  # Only ArrayDish entries are checked; Missing and RFIDish rows are exempt

    dish_grid_size_x: 8
    dish_grid_size_y: 12
    dish_separation_x_m: 6.300156854906823
    dish_separation_y_m: 8.500057809796308
    # Live wiring (Oct 1 2026): 6 CRS boards x 8 ADCs = 48 inputs, dishes A01-A08 and B01-B08
    # (source_id 0-3, dish slots 0-15) plus the RFI antennas in dish slots 56-63 (source_id
    # 14-15). Element order is [P][D] (CHORDBeamformer): the X-engine's crs_board_remap groups
    # the polarizations and this table defines the D axis. RFIDish rows are correlated but
    # always masked on the X-engine and kept in the DishInputs subset; Missing rows are not
    # connected, flip to ArrayDish when wired.
    dish_inputs: [
        {dish_idx:  0, grid_x_idx: 0,  grid_y_idx: 0,  feed_pos_disp_m: [0.0, 0.0, 0.0], coelev_disp_deg: 0.0, type: ArrayDish, label: A01},
        {dish_idx:  1, grid_x_idx: 1,  grid_y_idx: 0,  feed_pos_disp_m: [0.0, 0.0, 0.0], coelev_disp_deg: 0.0, type: ArrayDish, label: A02},
        {dish_idx:  2, grid_x_idx: 2,  grid_y_idx: 0,  feed_pos_disp_m: [0.0, 0.0, 0.0], coelev_disp_deg: 0.0, type: ArrayDish, label: A03},
