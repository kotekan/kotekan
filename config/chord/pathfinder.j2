{#-
  pathfinder.j2
  Basic N2 pipeline with F-engine packet capture
-#}


# num_local_freq: number of frequency IDs processed on this GPU;
#    must be divisible by 4 because pl_mask shapes use num_local_freq/4.
{% set num_local_freq = 384 %}


# num_dishes: dishes/antennas to simulate.
# With 2 polarizations, num_elements = 2 * num_dishes, which the n2k correlator requires to be a multiple of 128
# (CorrelatorParams::ns_divisor). That means num_dishes must be a multiple of 64. This also satisfies the counts
# block (num_elements/8 divisible by 8) and the packet-loss mask’s dish/8 grouping.
{% set num_dishes = 64 %}

# fpga time samples per generated frame (data_set), per frequency/polarization/dish;
# effectively "fpga_ticks_per_full_frame". This is the frame length seen by testDataGen and the n2k correlator.
# Must be divisible by sub_integration_ntime for the correlator output, by 1024 for the RFI mask downsample,
# and by 128 for the packet-loss mask layout.
{% set samples_per_data_set = 8192 %}

# fpga samples collapsed by the GPU correlator into one n2k sub-integration/visibility sample.
# Distinct from samples_per_data_set (the total frame length); samples_per_data_set / sub_integration_ntime is the number
# of sub-integrations produced per frame. Choose any positive divisor of samples_per_data_set (does not need to be 1024).
{% set sub_integration_ntime = 8192 %}

# n2k sub-integrations to combine into each output N2 frame by N2Accumulate. 238 ~= 10 seconds.
{% set num_subintegrations_per_bin = 238 %}

# RFI Detection Parameters
{% set rfi_downsampling_factor = 256 %}
{% set rfi_second_downsampling_factor = 32 %}
{% set rfi_num_times = samples_per_data_set // rfi_downsampling_factor %}  {# = 32 #}
{% set rfi_num_times_bar = rfi_num_times //  rfi_second_downsampling_factor %}  {# = 1 #}

# The two NUMA halves. Each owns a NIC port, a GPU and a set of cores, and every per-half
# buffer and stage below loops over this table; a block that exists once per half is
# named <block>_<id> (sfx), so half 0's buffers and stages end in _0 and half 1's in _1.
{% set numa_halves = [
    {"id": 0, "sfx": "_0", "mask_cpu": 1,  "transpose_cpus": [2, 3],   "frame_service_cpu": 4,
     "gpu_cpus": [12, 13, 14], "accum_cpu": 9,  "subset_cpu": 11, "eigen_cpu": 10},
    {"id": 1, "sfx": "_1", "mask_cpu": 16, "transpose_cpus": [17, 18], "frame_service_cpu": 20,
     "gpu_cpus": [25, 26, 27], "accum_cpu": 28, "subset_cpu": 29, "eigen_cpu": 30},
] %}

---
{% include "common.j2" %}

num_local_freq: {{ num_local_freq }}

numa_node: 0

num_gpu_frames: 4
host_side_buffer_depth: buffer_depth * 6
cpu_affinity: [0,1,8,11,12,13,14,15]
frame_arrival_period: 5.12e-6 * {{ samples_per_data_set }}
sizeof_gpu_int: 4 # bytes
sizeof_int8: 1
sizeof_int32: 4
sizeof_uint64: 8
sizeof_float32: 4

sub_integration_ntime: {{ sub_integration_ntime }}
samples_per_data_set: {{ samples_per_data_set }}
rfi_downsampling_factor: {{ rfi_downsampling_factor }}
rfi_second_downsampling_factor: {{ rfi_second_downsampling_factor }}
rfi_num_times: {{ rfi_num_times }}
rfi_num_times_bar: {{ rfi_num_times_bar }}
# First-stage mask threshold, in feed-averaged SK standard deviations from 1 (sigma ~ 0.021
# with 32 good feeds). Measured Sep 2 2026: 3.0 flags ~7% of cells vs ~6% at 5.0.
rfi_sk_rfimask_sigmas: 3.0
rfi_single_feed_min_good_frac: 0.25     # Wide open (0.25) so most feeds are good
# Feed-averaged SK validity gate: the S0 sum over bf_mask-good, sf_valid feeds must reach
# num_elements*Nds*frac; at 0.1 that is ~13 fully valid feeds. A failed gate writes SKtilde
# invalid (sigma=-1) and flags the bin in the first-stage RFI mask.
rfi_feed_averaged_min_good_frac: 0.1
rfi_mu_min: 2.0       # Minimum accepted average signal (|E|^2)  Kendrick's RFI Notes recommends 2.0
rfi_mu_max: 50.0      # Maximum accepted average signal (|E|^2)  Kendrick's RFI Notes recommends 50.0
# First-stage (GPU, SK-based) RFI excision: the correlator excises the samples cudaRFISKtilde
# flags. With false the RFImask is all-good; SKtilde is computed either way, so second-stage
# excision (RfiFrameMask -> N2Accumulate) keeps working.
rfi_first_stage_excision_enabled: true


# DPDK related parameters
dpdk_output_frame_size: samples_per_data_set * num_local_freq * num_elements
num_crs_boards: 16  # Number of F-engine boards sending data
time_samples_per_packet: 16
time_short: 16
time_long: samples_per_data_set / time_short
element_short: 8
element_long: num_elements / element_short

{% include "telescope.j2" %}

updatable_config:
    # Bad feed list, POSTed to /updatable_config/bad_inputs (e.g. by bffs via choco):
    # element indices in [P][D] (CHORDBeamformer) order, i.e. positions in dish_inputs.
    # Every update must carry all three keys.
    bad_inputs:
        kotekan_update_endpoint: json
        bad_inputs: []
        start_time: 1752451200.
        update_id: "initial_flags"


# Pools
main_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: 15 * buffer_depth

n2_pool:
    kotekan_metadata_pool: N2Metadata
    num_metadata_objects: 16 * buffer_depth

# Bad feed mask buffers (see host_bf_mask_buffer_<n>). N2Accumulate holds each mask frame until
# its correlation frame is accumulated, so the depth bounds the GPU's lead over it; the send
# copies must ride out bufferSend's 20 s send_timeout at one frame per ~42 ms. The frames
# get their own metadata pool: one object each, hundreds alive at a time.
bad_feed_mask_buffer_depth: 2 * host_side_buffer_depth
bad_feed_mask_send_buffer_depth: 512
bad_feed_mask_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: 2 * (bad_feed_mask_buffer_depth + bad_feed_mask_send_buffer_depth) + 4 * buffer_depth

# The bad feed mask is valid for this many input samples: one frame (~42 ms), so each
# correlation frame is gated by exactly one mask element, which N2Accumulate requires.
bf_mask_lifetime_in_samples: samples_per_data_set

# Bad feed mask - marks which feeds to exclude from RFI calculations.
# bufferBadInputs output: int8 "bad_feed_mask" [1, P, D], 1 = good, one element per frame, stamped
# with the FPGA seq it applies from. One stream per NUMA half, clocked to that half's voltage
# stream (the two DPDK captures can start frames apart) and feeding only that half's GPU copy
# (run_send_bf_mask), N2Accumulate and recv-node send. Never cross the halves: the GPU and
# N2Accumulate seq checks catch it unless both halves happened to start on the same frame.
{% for n in numa_halves %}
host_bf_mask_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: bad_feed_mask_buffer_depth
    value_type: int8
    extents: [1, num_polarizations, num_dishes]
    quantity_name: "bf_mask"
    dimnames: ["Tbf", "P", "D"]
    dimscalings: [bf_mask_lifetime_in_samples, 1, 1]
    metadata_pool: bad_feed_mask_pool
    numa_node: {{ n.id }}
{% endfor %}

# Private copies of the mask streams for the recv-node sends: bufferSend drops frames
# when its buffer looks congested, and host_bf_mask_buffer_<n> always does (N2Accumulate
# holds its frames), so the sends get their own buffers.
{% for n in numa_halves %}
host_bad_feed_mask_send_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    num_frames: bad_feed_mask_send_buffer_depth
    value_type: int8
    extents: [1, num_polarizations, num_dishes]
    quantity_name: "bf_mask"
    dimnames: ["Tbf", "P", "D"]
    dimscalings: [bf_mask_lifetime_in_samples, 1, 1]
    metadata_pool: bad_feed_mask_pool
    numa_node: {{ n.id }}
{% endfor %}

# Buffers
network_input_buffers:
    num_frames: host_side_buffer_depth
    peek_hold: true
    frame_size: dpdk_output_frame_size
    metadata_pool: main_pool
    use_hugepages: true

    # The workers share an output buffer.
    # Fed by dpdkCore (crs16BoardCaptureWorker handler) -> leave standard.
{% for n in numa_halves %}
    network_input_buffer_{{ n.id }}:
        zero_new_frames: true
        numa_node: {{ n.id }}
        zero_value: 0x88
        kotekan_buffer: standard
{% endfor %}

# Main voltage buffer after transpose.
# Produced by TransposeBasebandArray: int4x2_swapped_withoffset "E"
# [timesamples_per_frame, NUM_LOCAL_FREQ, 2, NUM_ELEMENTS/2] = [samples_per_data_set, 384, 2, 64].
# The stage uses compile-time macros NUM_LOCAL_FREQ=384, NUM_ELEMENTS=128 (it fatally checks the
# config num_local_freq/num_elements equal them); this config sets num_local_freq=384,
# num_elements=128, so the static extents below are valid. These live outside the
# network_input_buffers group: that group's frame_size is for the dpdk buffers, while
# ndarray buffers derive their size from the descriptor.
{% for n in numa_halves %}
host_voltage_buffer_{{ n.id }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: int4x2_swapped_withoffset
    extents: [samples_per_data_set, num_local_freq, 2, num_elements / 2]
    metadata_pool: main_pool
    use_hugepages: true
    numa_node: {{ n.id }}
{% endfor %}

# One receipt bitmap per capture worker (two per half), combined by that half's
# process_packet_mask stage.
packet_receipt_bitmap_buffers:
    num_frames: host_side_buffer_depth
    peek_hold: true
    frame_size: (samples_per_data_set / time_samples_per_packet) * num_crs_boards  # One bit per stream
    metadata_pool: main_pool
    use_hugepages: true
{% for n in numa_halves %}
    packet_receipt_bitmap_buffer_{{ 2 * n.id }}:
        kotekan_buffer: standard
{%- if n.id %}
        numa_node: {{ n.id }}
{%- endif %}
    packet_receipt_bitmap_buffer_{{ 2 * n.id + 1 }}:
        kotekan_buffer: standard
{%- if n.id %}
        numa_node: {{ n.id }}
{%- endif %}
    combined_receipt_bitmap_buffer_{{ n.id }}:
        kotekan_buffer: standard
{%- if n.id %}
        numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# Note this is the expanded version of the pl_mask, produced by ProcessPacketMask (pl_mask_buf).
# It will be compressed to the normal PL mask before being sent to the GPU.
# uint1x8 "pl_mask_exp" [samples_per_data_set/64, num_local_freq, 2, num_elements/8/2, 8]
# {Thi64, F, P, D8, Tlo64}.
{% for n in numa_halves %}
host_pl_mask_exp_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: uint1x8
    extents: [samples_per_data_set / 64, num_local_freq, 2, num_elements / 8 / 2, 8]
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# This is the PL mask, sent to GPU and used for n2k_counts and the RFI SK system.
# Produced by PLMaskExpandedToCompact (out_buf): uint1x8 "pl_mask"
# [samples_per_data_set/128, (num_local_freq+3)/4, 2, (num_elements/8)/2, 8]
# {T2hi64, F4, P, D8, T2lo64}. num_local_freq=384 -> (384+3)/4 = 96 = num_local_freq/4.
{% for n in numa_halves %}
host_pl_mask_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: uint1x8
    extents: [samples_per_data_set / 128, (num_local_freq + 3) / 4, 2, (num_elements / 8) / 2, 8]
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# This contains the SK statistics averaged over elements.
# GPU output (cudaCopyFromRingbuffer of cudaRFISKtilde rfi_SKtilde) and consumed by RfiFrameMask:
# float32 "SKtilde" [samples_per_data_set/rfi_downsampling_factor, num_local_freq, 3] {Trfi, F, SK}.
{% for n in numa_halves %}
host_rfi_sktilde_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: float32
    extents: [samples_per_data_set / rfi_downsampling_factor, num_local_freq, 3]
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# Per-feed SK from the second-stage RFI kernel (cudaRFISKbar rfi_skbar), consumed by
# RfiSKMetrics: float32 "SKbar" [rfi_num_times_bar, num_local_freq, 3, P, D], the 3 being
# {SK, b, sigma}; sigma < 0 marks an invalid cell.
{% for n in numa_halves %}
host_rfi_skbar_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: float32
    extents: [rfi_num_times_bar, num_local_freq, 3, num_polarizations, num_dishes]
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# This is the RFI Mask recieved from the GPU, that was applied to produce n2k_correlation & n2k_counts.
# It contains the mask computed by SKtilde (all-good if rfi_first_stage_excision_enabled is false).
# GPU output (cudaCopyFromRingbuffer of rfi_RFImask) and consumed by RfiMaskSum:
# uint1x8 "RFImask" [samples_per_data_set/1024, num_local_freq, 128] {T8hi128, F, T8lo128}.
{% for n in numa_halves %}
host_rfi_RFImask_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: uint1x8
    extents: [samples_per_data_set / 1024, num_local_freq, 128]
    zero_new_frames: true
    zero_value: 0xFF
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# Produced by RfiMaskSum (out_buf): int32 "RFImask_counts"
# [samples_per_data_set/sub_integration_ntime, num_local_freq] {Tc, F}.
{% for n in numa_halves %}
host_rfi_RFImask_counts_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: int32
    extents: [samples_per_data_set / sub_integration_ntime, num_local_freq]
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# Produced by CountLostPLSamplesScalar (out_buf): int32 "pl_lost_counts_scalar"
# [samples_per_data_set/sub_integration_ntime, num_local_freq] {Tc, F}.
{% for n in numa_halves %}
host_pl_counts_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: int32
    extents: [samples_per_data_set / sub_integration_ntime, num_local_freq]
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# The mask for second stage RFI excision.
# Produced by RfiFrameMask (out_buf): uint8 "RFIFrameMask"
# [samples_per_data_set/sub_integration_ntime, num_local_freq] {Tc, F}.
{% for n in numa_halves %}
host_rfi_RFIframemask_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: uint8
    extents: [samples_per_data_set / sub_integration_ntime, num_local_freq]
    zero_new_frames: true
    zero_value: 0xFF
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

vis_blocksize: 16
vis_num_blocks_lin: num_elements / vis_blocksize
vis_num_blocks: vis_num_blocks_lin * (vis_num_blocks_lin + 1) / 2
# GPU output (cudaOutputData of cudaCorrelator n2k_correlation): int32 "n2k_correlation"
# [samples_per_data_set/sub_integration_ntime, num_local_freq, vis_num_blocks, 16, 16, 2]
# {Tc, F, DPhi, DPlo1, DPlo2, C}. Block-count note: cudaCorrelator uses (num_elements+1)/16
# while the CPU side uses num_elements/16; at num_elements=128 both equal 8, so vis_num_blocks=36
# matches the kernel's triangle_num_blocks.
{% for n in numa_halves %}
host_correlation_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: int32
    extents: [samples_per_data_set / sub_integration_ntime, num_local_freq, vis_num_blocks, vis_blocksize, vis_blocksize, 2]
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

counts_blocksize: 8
counts_num_blocks_lin: (num_elements / 8) / counts_blocksize
counts_num_blocks: (counts_num_blocks_lin * (counts_num_blocks_lin + 1)) / 2
# GPU output (cudaOutputData of cudaPL1bitCorrelator n2k_counts): int32 "n2k_counts"
# [samples_per_data_set/sub_integration_ntime, num_local_freq, counts_num_blocks, 8, 8]
# {Tc, F, D8Phi, D8Plo1, D8Plo2}. Block-count note: cudaPL1bitCorrelator uses
# (num_elements/8+1)/8 while the CPU side uses (num_elements/8)/8; at num_elements=128 both equal 2,
# so counts_num_blocks=3 matches the kernel's triangle_num_blocks.
{% for n in numa_halves %}
host_counts_buffer{{ n.sfx }}:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: host_side_buffer_depth
    value_type: int32
    extents: [samples_per_data_set / sub_integration_ntime, num_local_freq, counts_num_blocks, counts_blocksize, counts_blocksize]
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

{% for n in numa_halves %}
n2_buffer{{ n.sfx }}:
    kotekan_buffer: N2
    peek_hold: true
    num_ev: 0
    n2_layout: "FullUpperTri"
    num_frames: host_side_buffer_depth * num_local_freq
    metadata_pool: n2_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# DishInputs: compact frames over the connected (non-Missing) elements, derived from the
# telescope's dish table; num_elements is the full count they are selected from. Element
# identities are derived where needed (N2Subset, hdf5N2Write), not carried on the descriptor.
{% for n in numa_halves %}
n2_subset_buffer{{ n.sfx }}:
    kotekan_buffer: N2
    peek_hold: true
    num_ev: 0
    n2_layout: "DishInputs"
    num_frames: buffer_depth * num_local_freq
    metadata_pool: n2_pool

n2_eigen_buffer{{ n.sfx }}:
    kotekan_buffer: N2
    peek_hold: true
    num_ev: num_ev_to_calculate
    n2_layout: "DishInputs"
    num_frames: buffer_depth * num_local_freq
    metadata_pool: n2_pool
{% endfor %}

# Ringbuffer signalling buffers, one set per half.
# cudaRFISKbar always writes its feed-averaged output (rfi_skbartilde), so the
# skbartilde rings must exist, but nothing consumes them yet — a consumerless ring
# auto-drains on finish_write, so they are intentionally unread.
{% for n in numa_halves %}
host_voltage_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * samples_per_data_set * num_elements * num_local_freq
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}

host_rfi_RFImask_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * num_local_freq * samples_per_data_set / 8
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}

host_pl_mask_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * ((samples_per_data_set / 2) * (num_local_freq / 4) * (num_elements / 8)) / 8
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}

host_pl_mask_exp_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (samples_per_data_set * num_local_freq * (num_elements / 8)) / 8
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}

host_bf_mask_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * num_polarizations * num_dishes * sizeof_int8
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}

host_rfi_s012_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (samples_per_data_set / rfi_downsampling_factor) * num_local_freq * 3 * num_elements * sizeof_uint64
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}

host_rfi_sktilde_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * (samples_per_data_set / rfi_downsampling_factor) * num_local_freq * 3 * sizeof_float32
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}

host_rfi_s012bar_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * rfi_num_times_bar * num_local_freq * 3 * num_elements * sizeof_uint64
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}

host_rfi_skbar_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * rfi_num_times_bar * num_local_freq * 3 * num_elements * sizeof_float32
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}

host_rfi_skbartilde_ringbuffer{{ n.sfx }}:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * rfi_num_times_bar * num_local_freq * 3 * sizeof_float32
    metadata_pool: main_pool
{%- if n.id %}
    numa_node: {{ n.id }}
{%- endif %}
{% endfor %}

# Stages

##  Packet capture from the F-engine ##
dpdk:
    kotekan_stage: dpdkCore
    # Format is index = lcore, value = cpu core
    # lcore 1 -> cpu 21 (NUMA 1) so port-1's RX lcore is local to its NIC a0:00.0 (NUMA 1)
    lcore_cpu_map: [5, 21, 7, 6, 22, 23] # [5,6,7]
    main_lcore_cpu: 4
    num_mbufs: 16384
    rx_ring_size: 4096
    mbuf_cache_size: 512
    packet_size: 6208
    payload_size: 6144
    max_rx_pkt_len: 6208
    burst_size: 32
    # Reordering map index by output location.
    # So [2, ...], maps CRS board with source_id 2 to output location 0, and so on.
    # Slots 0-7 are pol 0 and 8-15 pol 1 of dish groups 0-7. Dish boards send pol 0 from
    # even and pol 1 from odd source_ids; the RFI-antenna boards are cabled the other way
    # round (source_id 15 -> slot 7, 14 -> slot 15).
    crs_board_remap: [0, 2, 4, 6, 8, 10, 12, 15, 1, 3, 5, 7, 9, 11, 13, 14]
    # The number of stream IDs expected per worker
    num_expected_stream_ids: 4
    lcore_start_delay: 10
    # List of PCIe addresses to block from DPDK use
    pcie_block_list:
        - "0000:37:00.0"
        - "0000:37:00.1"
        - "0000:b5:00.0"
        - "0000:b5:00.1"
    # Two worker rings per half (2n, 2n+1), on that half's socket.
    worker_ring_map:
{% for n in numa_halves %}
        - name: worker_ring_{{ 2 * n.id }}
          num_slots: 512
          socket_id: {{ n.id }}
        - name: worker_ring_{{ 2 * n.id + 1 }}
          num_slots: 512
          socket_id: {{ n.id }}
{% endfor %}
    # Format is index = lcore, value = array of port IDs
    # so [[0,1],[2,3]] maps lcore 0 to service ports 0 and 1,
    # and lcore 1 to service ports 2 and 3. Here each half's port has its own lcore.
    lcore_port_map:
{% for n in numa_halves %}
        - [{{ n.id }}]
{% endfor %}
    # One handler must be given per port
    handlers:
{% for n in numa_halves %}
        - dpdk_handler: crs16BoardDistributor
          worker_rings: [{{ 2 * n.id }},{{ 2 * n.id + 1 }}]
{% endfor %}
    # Exactly One worker must be given per worker ring
    workers:
{% for n in numa_halves %}
        - dpdk_handler: crs16BoardCaptureWorker
          frame_service_cpu_affinity: [{{ n.frame_service_cpu }}]
          worker_ring: {{ 2 * n.id }}
          port: {{ n.id }}
          allocate_metadata: true
          out_buf: network_input_buffer_{{ n.id }}
          receipt_bitmap_buf: packet_receipt_bitmap_buffer_{{ 2 * n.id }}
        - dpdk_handler: crs16BoardCaptureWorker
          frame_service_cpu_affinity: [{{ n.frame_service_cpu }}]
          worker_ring: {{ 2 * n.id + 1 }}
          port: {{ n.id }}
          out_buf: network_input_buffer_{{ n.id }}
          receipt_bitmap_buf: packet_receipt_bitmap_buffer_{{ 2 * n.id + 1 }}
{% endfor %}


# Output slots (after crs_board_remap, not raw source_ids) with no CRS board behind them:
# ProcessPacketMask marks them fully received so an absent board is not 100% packet loss.
# Listing a slot that has a board disables its packet-loss accounting, so update this as
# boards come and go. Populated (Sep 2 2026): slots 0, 1, 8, 9 (dishes) and 7, 15 (RFI).
missing_source_ids: [2, 3, 4, 5, 6, 10, 11, 12, 13, 14]

# Combine packet receipt bitmaps and generate packet-loss masks
{% for n in numa_halves %}
process_packet_mask_{{ n.id }}:
    kotekan_stage: ProcessPacketMask
    cpu_affinity: [{{ n.mask_cpu }}]
    voltage_buf: network_input_buffer_{{ n.id }}
    receipt_bitmap_bufs:
        - packet_receipt_bitmap_buffer_{{ 2 * n.id }}
        - packet_receipt_bitmap_buffer_{{ 2 * n.id + 1 }}
    combined_receipt_bitmap_buf: combined_receipt_bitmap_buffer_{{ n.id }}
    pl_mask_buf: host_pl_mask_exp_buffer{{ n.sfx }}
    num_frequency: num_local_freq
    num_source_ids: num_crs_boards
{% endfor %}

# Transpose the voltage data from the network input buffer into a more convenient layout
# for the GPU and baseband dump processing.
# This also applies the packet-loss mask to the data.
# Two per half, one for even and one for odd frames.
{% for n in numa_halves %}
{% for parity in ["even", "odd"] %}
transpose_voltage_{{ 2 * n.id + loop.index0 }}:
    kotekan_stage: TransposeBasebandArray
    cpu_affinity: [{{ n.transpose_cpus[loop.index0] }}]
    timesamples_per_frame: samples_per_data_set
    in_buf: network_input_buffer_{{ n.id }}
    pl_mask_buf: host_pl_mask_exp_buffer{{ n.sfx }}
    out_buf: host_voltage_buffer_{{ n.id }}
    frame_mode: {{ parity }}
{% endfor %}
{% endfor %}

# Downsample the PL mask to its "normal" form, which will be sent to the GPU.
{% for n in numa_halves %}
PL_mask_compactor{{ n.sfx }}:
    kotekan_stage: PLMaskExpandedToCompact
    cpu_affinity: [{{ n.mask_cpu }}]
    in_buf: host_pl_mask_exp_buffer{{ n.sfx }}
    out_buf: host_pl_mask_buffer{{ n.sfx }}
{% endfor %}

# Bad feed mask from /updatable_config/bad_inputs (fed by bffs via choco). One instance per
# NUMA half, clocked to that half's voltage buffer (see host_bf_mask_buffer_<n>); both apply the
# same posted list, though an update can land one frame apart between the halves. CHORD
# flags and masks share the [P][D] order, so no reorder. Non-ArrayDish elements (Missing, RFI
# antennas) are always masked, whatever the posted list says.
set_bf_mask:
    input_order: CHORDBeamformer
    output_order: CHORDBeamformer
{% for n in numa_halves %}
    bf_mask_{{ n.id }}:
        kotekan_stage: bufferBadInputs
        updatable_config:
            bad_inputs: /updatable_config/bad_inputs
        metadata_source: host_voltage_buffer_{{ n.id }}
        out_buf: host_bf_mask_buffer{{ n.sfx }}
{% endfor %}

## Send data to GPU ringbuffers ##
# Every cudaProcess stage below runs once per half, gpu_<n> on GPU n with that half's
# buffers; the in_buffers/out_buffers keys are the names the commands refer to.

run_send_voltage:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        cpu_affinity: {{ n.gpu_cpus }}
        in_buffers:
            host_voltage_buffer_in: host_voltage_buffer_{{ n.id }}
        out_buffers:
            host_voltage_ringbuffer_out: host_voltage_ringbuffer{{ n.sfx }}
        commands:
        - name: cudaCopyToRingbuffer
          input_size: samples_per_data_set * num_elements * num_local_freq
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_voltage_buffer_in
          signal_buf: host_voltage_ringbuffer_out
          gpu_mem_output: voltage_buffer
{% endfor %}

run_send_bf_mask:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        cpu_affinity: {{ n.gpu_cpus }}
        in_buffers:
            host_bf_mask_buffer_in: host_bf_mask_buffer{{ n.sfx }}
        out_buffers:
            host_bf_mask_ringbuffer: host_bf_mask_ringbuffer{{ n.sfx }}
        commands:
        - name: cudaCopyToRingbuffer
          input_size: num_polarizations * num_dishes * sizeof_int8
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_bf_mask_buffer_in
          signal_buf: host_bf_mask_ringbuffer
          gpu_mem_output: bf_mask_buffer
{% endfor %}

run_send_pl_mask:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        cpu_affinity: {{ n.gpu_cpus }}
        in_buffers:
            host_pl_mask_buffer_in: host_pl_mask_buffer{{ n.sfx }}
        out_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer{{ n.sfx }}
        commands:
        - name: cudaCopyToRingbuffer
          input_size: (samples_per_data_set / 128) * (num_local_freq / 4) * (num_elements / 8) * 8
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_pl_mask_buffer_in
          signal_buf: host_pl_mask_ringbuffer
          gpu_mem_output: pl_mask_buffer
{% endfor %}

run_rfi_s012:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        in_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer{{ n.sfx }}
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer{{ n.sfx }}
        out_buffers:
            host_rfi_s012_ringbuffer: host_rfi_s012_ringbuffer{{ n.sfx }}
        commands:
        - name: cudaRFIS012
          voltage_name: voltage
          pl_mask_name: pl_mask
          rfi_S012_name: rfi_s012
          num_times: samples_per_data_set
          num_frequencies: num_local_freq
          rfi_num_times: samples_per_data_set / rfi_downsampling_factor
{% endfor %}

# This stage produces SK statistics averaged over all input elements and the RFI mask.
# When rfi_first_stage_excision_enabled is false, the mask is written as all-good (no excision)
# but the SK statistics are still computed for second-stage excision.
run_rfi_sktilde:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        in_buffers:
            host_bf_mask_ringbuffer: host_bf_mask_ringbuffer{{ n.sfx }}
            host_rfi_s012_ringbuffer: host_rfi_s012_ringbuffer{{ n.sfx }}
        out_buffers:
            host_rfi_sktilde_ringbuffer: host_rfi_sktilde_ringbuffer{{ n.sfx }}
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer{{ n.sfx }}
        commands:
        - name: cudaRFISKtilde
          rfi_S012_name: rfi_s012
          bf_mask_name: bf_mask
          rfi_SKtilde_name: rfi_sktilde
          rfi_RFImask_name: rfi_RFImask
          num_times: samples_per_data_set
          num_frequencies: num_local_freq
          rfi_num_times: samples_per_data_set / rfi_downsampling_factor
{% endfor %}

run_recv_rfi_sktilde:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        in_buffers:
            host_rfi_sktilde_ringbuffer_in: host_rfi_sktilde_ringbuffer{{ n.sfx }}
        out_buffers:
            host_rfi_sktilde_buffer_out: host_rfi_sktilde_buffer{{ n.sfx }}
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_sktilde_ringbuffer_in
          gpu_mem_input: rfi_sktilde_buffer
          output_size: (samples_per_data_set / rfi_downsampling_factor) * num_local_freq * 3 * sizeof_float32
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_sktilde_buffer_out
{% endfor %}

# Second-stage (time-downsampled) per-feed RFI statistics: S012 -> S012bar -> SKbar.
# rfi_skbar is computed for every feed regardless of the bad feed mask, so a flagged feed
# keeps being measured and can heal; rfi_skbartilde is its feed average.
run_rfi_s012bar:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        in_buffers:
            host_rfi_s012_ringbuffer: host_rfi_s012_ringbuffer{{ n.sfx }}
        out_buffers:
            host_rfi_s012bar_ringbuffer: host_rfi_s012bar_ringbuffer{{ n.sfx }}
        commands:
        - name: cudaRFIS012bar
          rfi_S012_name: rfi_s012
          rfi_S012bar_name: rfi_s012bar
          num_frequencies: num_local_freq
          rfi_num_times: samples_per_data_set / rfi_downsampling_factor
{% endfor %}

run_rfi_skbar:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        in_buffers:
            host_bf_mask_ringbuffer: host_bf_mask_ringbuffer{{ n.sfx }}
            host_rfi_s012bar_ringbuffer: host_rfi_s012bar_ringbuffer{{ n.sfx }}
        out_buffers:
            host_rfi_skbar_ringbuffer: host_rfi_skbar_ringbuffer{{ n.sfx }}
            host_rfi_skbartilde_ringbuffer: host_rfi_skbartilde_ringbuffer{{ n.sfx }}
        commands:
        - name: cudaRFISKbar
          bf_mask_name: bf_mask
          rfi_S012bar_name: rfi_s012bar
          rfi_SKbar_name: rfi_skbar
          rfi_SKbartilde_name: rfi_skbartilde
          num_frequencies: num_local_freq
{% endfor %}

run_recv_rfi_skbar:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        in_buffers:
            host_rfi_skbar_ringbuffer_in: host_rfi_skbar_ringbuffer{{ n.sfx }}
        out_buffers:
            host_rfi_skbar_buffer_out: host_rfi_skbar_buffer{{ n.sfx }}
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_skbar_ringbuffer_in
          gpu_mem_input: rfi_skbar_buffer
          output_size: rfi_num_times_bar * num_local_freq * 3 * num_elements * sizeof_float32
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_skbar_buffer_out
{% endfor %}

# Export the per-feed SK: a JSON GET endpoint per instance (bffs polls
# /rfi_sk_metrics/sk_metrics_<n>/sk) plus prometheus gauges. Elements are indexed by their
# flat [P][D] index, the same as /updatable_config/bad_inputs.
rfi_sk_metrics:
{% for n in numa_halves %}
    sk_metrics_{{ n.id }}:
        kotekan_stage: RfiSKMetrics
        in_buf: host_rfi_skbar_buffer{{ n.sfx }}
{% endfor %}

# This copies the RFI Mask that was used in N2K kernels back out to the CPU into
# host_rfi_RFImask_buffer_<n>. It contains the SKtilde-produced mask (all-good if
# rfi_first_stage_excision_enabled is false).
run_recv_rfi_RFImask:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        in_buffers:
            host_rfi_RFImask_ringbuffer_in: host_rfi_RFImask_ringbuffer{{ n.sfx }}
        out_buffers:
            host_rfi_RFImask_buffer_out: host_rfi_RFImask_buffer{{ n.sfx }}
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_RFImask_ringbuffer_in
          gpu_mem_input: rfi_RFImask_buffer
          output_size: samples_per_data_set * num_local_freq / 8
          ring_buffer_size: buffer_depth * output_size
          out_buf: host_rfi_RFImask_buffer_out
{% endfor %}

# Only the "normal" (downsampled) PL mask is sent to the GPU. This expands that mask for
# the 1 bit correlator kernel. Other stages use the downsampled mask directly.
run_pl_expand:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        in_buffers:
            host_pl_mask_ringbuffer: host_pl_mask_ringbuffer{{ n.sfx }}
        out_buffers:
            host_pl_mask_exp_ringbuffer: host_pl_mask_exp_ringbuffer{{ n.sfx }}
        commands:
        - name: cudaPLMaskExpander
          num_frequencies: num_local_freq
          pl_mask_name: pl_mask
          pl_expanded_mask_name: pl_mask_exp
{% endfor %}

# Packet-loss correlator to produce counts for N2Accumulate

run_pl_corr:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        in_buffers:
            host_pl_mask_exp_ringbuffer: host_pl_mask_exp_ringbuffer{{ n.sfx }}
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer{{ n.sfx }}
        out_buffers:
            host_counts_buffer: host_counts_buffer{{ n.sfx }}
        commands:
        - name: cudaPL1bitCorrelator
          num_frequencies: num_local_freq
          pl_expanded_mask_name: pl_mask_exp
          rfi_RFImask_name: rfi_RFImask
          n2k_counts_name: counts
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: counts_buffer
          out_buf: host_counts_buffer
{% endfor %}

# Run N2K correlator

run_n2k:
{% for n in numa_halves %}
    gpu_{{ n.id }}:
        kotekan_stage: cudaProcess
        gpu_id: {{ n.id }}
        cpu_affinity: {{ n.gpu_cpus }}
        in_buffers:
            host_voltage_ringbuffer: host_voltage_ringbuffer{{ n.sfx }}
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer{{ n.sfx }}
        out_buffers:
            host_correlation: host_correlation_buffer{{ n.sfx }}
        commands:
        - name: cudaCorrelator
          n2k_correlation_name: correlation
          voltage_name: voltage
          rfi_RFImask_name: rfi_RFImask
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: correlation_buffer
          out_buf: host_correlation
{% endfor %}


# Accumulate N2K visibilities on CPU

hex_dump:
    #kotekan_stage: hexDump
    cpu_affinity: [29]
    in_buf: n2_buffer_1
    len: 4096

{% for n in numa_halves %}
count_rfi_mask{{ n.sfx }}:
    kotekan_stage: RfiMaskSum
    in_buf: host_rfi_RFImask_buffer{{ n.sfx }}
    out_buf: host_rfi_RFImask_counts_buffer{{ n.sfx }}

count_PL{{ n.sfx }}:
    kotekan_stage: CountLostPLSamplesScalar
    in_buf: host_pl_mask_buffer{{ n.sfx }}
    out_buf: host_pl_counts_buffer{{ n.sfx }}
    packet_loss_is_scalar: true

# This computes the second stage RFI excision mask.
compute_RFI_frame_mask{{ n.sfx }}:
    kotekan_stage: RfiFrameMask
    in_buf: host_rfi_sktilde_buffer{{ n.sfx }}
    out_buf: host_rfi_RFIframemask_buffer{{ n.sfx }}
    enabled_updatable_config: /rfi_second_stage_enabled
    thresholds_updatable_config: /rfi_second_stage_thresholds
{% endfor %}

# Updatable Config for second stage RFI excision.
rfi_second_stage_enabled:
    kotekan_update_endpoint: json
    enabled: false
    valid_at_time_ns: 0

rfi_second_stage_thresholds:
    kotekan_update_endpoint: json
    thresholds: []
    valid_at_time_ns: 0

n2_accumulate:
    num_freq_per_n2k_frame: num_local_freq
    packet_loss_is_scalar: true
    num_subintegrations_per_bin: {{ num_subintegrations_per_bin }}
    # Correlation frames and the bad feed mask both arrive in [P][D] (CHORDBeamformer)
    # order and the output stays in it, so the mask maps onto the flags without reordering.
    input_order: CHORDBeamformer
    variance_mode: EvenOddPosDef
    bin_in_ERA: true
    num_bins_per_rotation: 8640
    do_fringestop: false
    num_workers: 1
{% for n in numa_halves %}
    accum_{{ n.id }}:
        kotekan_stage: N2Accumulate
        cpu_affinity: [{{ n.accum_cpu }}]
        in_buf: host_correlation_buffer{{ n.sfx }}
        in_counts_buf: host_counts_buffer{{ n.sfx }}
        in_rficounts_buf: host_rfi_RFImask_counts_buffer{{ n.sfx }}
        in_plcounts_buf: host_pl_counts_buffer{{ n.sfx }}
        in_rfiframemask_buf: host_rfi_RFIframemask_buffer{{ n.sfx }}
        in_bad_feed_mask_buf: host_bf_mask_buffer{{ n.sfx }}
        out_buf: n2_buffer{{ n.sfx }}
{% endfor %}


# Subset to the connected (non-Missing) feeds: DishInputs frames are compact over products and
# per-element fields alike.
{% for n in numa_halves %}
n2_subset{{ n.sfx }}:
    kotekan_stage: N2Subset
    cpu_affinity: [{{ n.subset_cpu }}]
    in_buf: n2_buffer{{ n.sfx }}
    out_buf: n2_subset_buffer{{ n.sfx }}
{% endfor %}

# Add eigen calculation (runs on subsetted data)
{% for n in numa_halves %}
eigencalc{{ n.sfx }}:
    kotekan_stage: EigenN2Iter
    num_ev: num_ev_to_calculate
    cpu_affinity: [{{ n.eigen_cpu }}]
    num_blaze_workers: 1
    in_buf: n2_subset_buffer{{ n.sfx }}
    out_buf: n2_eigen_buffer{{ n.sfx }}
    # Mask the elements bufferBadInputs flags as bad, on top of the subset itself.
    mask_flagged_inputs: true
    # Convergence config
    tol_eval: 0.0001
    tol_evec: 0.001
    max_iterations: 10
    num_ev_conv: 2
    krylov: 2
    subspace: 2
{% endfor %}

# Ship each half's mask stream to the recv node, where hdf5N2Write records it in the vis
# files' /bad_feed_mask group. Through a private copy so bufferSend's congestion heuristic sees only
# its own backlog (see host_bad_feed_mask_send_buffer_<n>); a dropped frame shows up there as a -1 row.
copy_bad_feed_mask:
{% for n in numa_halves %}
    copy_{{ n.id }}:
        kotekan_stage: bufferCopy
        in_buf: host_bf_mask_buffer{{ n.sfx }}
        out_bufs:
            - host_bad_feed_mask_send_buffer{{ n.sfx }}
{% endfor %}

# Both halves send to the same port; the recv node tells the streams apart by their
# coarse_freq metadata.
{% for n in numa_halves %}
buffer_send_bad_feed_mask{{ n.sfx }}:
    kotekan_stage: bufferSend
    use_frame_desc: true
    buf: host_bad_feed_mask_send_buffer{{ n.sfx }}
    server_ip: 10.222.0.51
    server_port: 11029
    reconnect_time: 10
    drop_frames: true
{% endfor %}

# Buffer sends. use_frame_desc sends the frame descriptor once per connection, so the receiver
# checks layout and element count, not just the frame size; must match recv.j2.
{% for n in numa_halves %}
buffer_send_n2_subset{{ n.sfx }}:
    kotekan_stage: bufferSend
    use_frame_desc: true
    buf: n2_eigen_buffer{{ n.sfx }}
    server_ip: 10.222.0.51
    server_port: 11025
    reconnect_time: 10
    drop_frames: true

buffer_send_n2_full{{ n.sfx }}:
    kotekan_stage: bufferSend
    use_frame_desc: true
    buf: n2_buffer{{ n.sfx }}
    server_ip: 10.222.0.51
    server_port: 11027
    reconnect_time: 10
    drop_frames: true
{% endfor %}
