{#-
  recv.j2
  Basic N2 receiver config.
-#}


# Frames per buffer_depth in the receive buffers: one per sent frequency ID (num_sent_freq),
# plus headroom for late frames.
{% set num_recv_frames = 6550 %}

# Depth of the subset receive buffer, in accumulation bins. hdf5N2Write writes a whole file
# when it finalizes it (late_frame_grace_seconds after its last frame) and takes no frames
# meanwhile: ~90 s for a 40-bin, 20 GB file. At buffer_depth (4 bins) the buffer filled after
# ~45 s and bufferRecv dropped the next 3-4 bins of every file. 16 bins (337 s) covers the
# stall with margin, at ~0.7 GB per bin (recv1 has 1 TB).
{% set subset_recv_depth = 16 %}

# The frequency IDs the F-engine sends, 768 + 128 index + stream for 58 indices and 128
# streams: 768 to 8191, the 150-1600 MHz band in telescope.j2. Rows of the auto spectrum.
{% set first_freq_id = 768 %}
{% set num_sent_freq = 7424 %}


# num_dishes: dishes/antennas to simulate.
# With 2 polarizations, num_elements = 2 * num_dishes, which the n2k correlator requires to be a multiple of 128
# (CorrelatorParams::ns_divisor). That means num_dishes must be a multiple of 64. This also satisfies the counts
# block (num_elements/8 divisible by 8) and the packet-loss mask’s dish/8 grouping.
{% set num_dishes = 64 %}

# fpga time samples per X-engine correlation frame; the bad feed mask stream carries one frame
# per this many samples. Must match pathfinder.j2.
{% set samples_per_data_set = 8192 %}


# DTV detector products from the X-engine halves (dtv.j2): one frame of dtv_blocks_per_frame
# 8192-sample blocks per half. telescope.j2 holds the shapes and ports for both sides, and
# dtv_enabled false leaves the DTV buffers and stages out.
{% from "telescope.j2" import num_local_freq, dtv_enabled, dtv_blocks_per_frame, dtv_sent with context %}

---
{% include "common.j2" %}

cpu_affinity: [0,1,2,3]

# The element order of the received visibility matrices, used by hdf5N2Write to look up feed
# positions and dish grid indices. The correlated element axis comes from the voltage buffer's
# [..., P, D], so element index = polarization * num_dishes + dish, which is what
# CHORDTelescope encodes as a station id and what CHORDBeamformer indexes by.
input_order: CHORDBeamformer

# X-engine halves sending bad feed masks to hdf5N2Write. Each half takes 1/16 of the F-engine
# stream ids, spaced by 16 (crs16BoardCaptureWorker), so half k owns the frequency ids
# min_science_freq_id + k + 16 n.
num_bad_feed_mask_streams: 16

{% include "telescope.j2" %}

# Pools
n2_pool:
    kotekan_metadata_pool: N2Metadata
    num_metadata_objects: 16 * buffer_depth

chord_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: 4 * buffer_depth

# Metadata for the received bad feed mask frames: one object per frame in bad_feed_mask_buffer.
bad_feed_mask_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: 1024 + 4 * buffer_depth



# Receive subset N2 buffer: compact frames over the non-Missing elements, derived from this
# config's dish table, which must match the X-engine's (see use_frame_desc below).
n2_recv_subset_buffer:
    kotekan_buffer: N2
    peek_hold: true
    num_ev: num_ev_to_calculate
    n2_layout: "DishInputs"
    num_frames: {{ subset_recv_depth }} * {{ num_recv_frames }}
    metadata_pool: n2_pool

# Receive full N2 Buffer

n2_recv_full_buffer:
    kotekan_buffer: N2
    peek_hold: true
    num_elements: 128
    num_ev: 0
    n2_layout: "FullUpperTri"
    num_frames: buffer_depth * {{ num_recv_frames }}
    metadata_pool: n2_pool

# Autocorrelation power gathered across frequency, one frame per accumulation
# bin. Produced by N2AutoSpectrum: float32 "autospectrum"
# [num_sent_freq, num_elements] {F, E}, row 0 at first_freq_id; rows stay NaN
# until that freq_id arrives. No consumer: held for the /buffer/auto_spectrum_buffer/frame
# peek endpoint.
auto_spectrum_buffer:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: buffer_depth
    value_type: float32
    extents: [{{ num_sent_freq }}, num_elements]
    metadata_pool: chord_pool

# Bad feed mask streams from the X-engine, one frame per correlation frame per NUMA half,
# stamped with the FPGA seq it applies from and the half's coarse frequencies, which identify
# the stream. hdf5N2Write takes them in on their own thread, so the depth only has to cover
# that thread's latency; a full buffer drops frames, which the files record as -1 rows.
# Shape must match the X-engine's host_bf_mask_buffer_<n>.
bad_feed_mask_buffer:
    kotekan_buffer: ndarray
    num_frames: 1024
    value_type: int8
    quantity_name: "bf_mask"
    dimnames: ["Tbf", "P", "D"]
    dimscalings: [{{ samples_per_data_set }}, 1, 1]
    extents: [1, num_polarizations, num_dishes]
    metadata_pool: bad_feed_mask_pool

# DTV frames from all 16 halves share one buffer per product. Each half sends one frame per
# ~43 s, so 32 frames cover two rounds while the writer catches up.
{% for product, value_type, extents, dimnames, dimscalings, port in dtv_sent if dtv_enabled %}
dtv_{{ product }}_buffer:
    kotekan_buffer: ndarray
    num_frames: 32
    value_type: {{ value_type }}
    extents: [{{ dtv_blocks_per_frame }}, {{ extents }}]
    quantity_name: "dtv_{{ product }}"
    dimnames: ["T", {{ dimnames }}]
    dimscalings: [8192, {{ dimscalings }}]
    metadata_pool: chord_pool

{% endfor %}


## Receive data

# use_frame_desc checks the sender's frame descriptor (layout and element count) against the
# buffers above at connection time; must match the bufferSend stages in pathfinder.j2.
# Element identities are not on the descriptor: a dish table that diverges from the
# X-engine's at the same connected count would be written out mislabeled.

buffer_recv_subset_subset:
    kotekan_stage: bufferRecv
    use_frame_desc: true
    buf: n2_recv_subset_buffer
    listen_port: 11025

buffer_recv_full_n2:
    kotekan_stage: bufferRecv
    use_frame_desc: true
    buf: n2_recv_full_buffer
    listen_port: 11027

# hdf5N2Write records the mask frames in the vis files (each file's /bad_feed_mask group holds
# every stream's masks over its time span), so both writers consume this buffer.
buffer_recv_bad_feed_mask:
    kotekan_stage: bufferRecv
    use_frame_desc: true
    buf: bad_feed_mask_buffer
    listen_port: 11029

{% if dtv_enabled %}
buffer_recv_dtv:
{% for p in dtv_sent %}
    {{ p[0] }}:
        kotekan_stage: bufferRecv
        use_frame_desc: true
        buf: dtv_{{ p[0] }}_buffer
        listen_port: {{ p[5] }}
{% endfor %}
{% endif %}

# Live autocorrelation power vs frequency from the full N2 stream, for the
# peek endpoint. num_pending_bins is left at its default (2).
auto_spectrum:
    kotekan_stage: N2AutoSpectrum
    in_buf: n2_recv_full_buffer
    out_buf: auto_spectrum_buffer
    num_local_freq: {{ num_sent_freq }}
    freq_id_base: {{ first_freq_id }}



## Write out the visibilities using HDF5

# Subset visibilities
hdf5_N2_write_subset:
    kotekan_stage: hdf5N2Write
    cpu_affinity: [12]
    in_buf: n2_recv_subset_buffer
    in_bad_feed_mask_buf: bad_feed_mask_buffer
    input_order: CHORDBeamformer
    base_dir: /mnt/cs00/data/kotekan_vis_files/subset/
    baseband_gain_host_info: /fpga_controller
    use_bitshuffle: true
    compression: "lz4"
    compression_level: 3
    # Round vis and weights below their noise so bitshuffle drops the low bits.
    # Adds at most err_sq_lim / 3 (0.1%) to the vis noise variance, as in CHIME.
    err_sq_lim: 0.003
    weight_fixed_precision: 0.001
    # Chunk /vis as [16 freq, all prods, all 40 times]: readers take whole
    # product rows, and this keeps a file to a few hundred chunks.
    blocksize_f: 16
    blocksize_p: 0
    num_file_t: 40
    late_frame_grace_seconds: 30


# Full visibilities (all elements)
# hdf5_N2_write_full:
#     kotekan_stage: hdf5N2Write
#     cpu_affinity: [12]
#     in_buf: n2_recv_full_buffer
#     in_bad_feed_mask_buf: bad_feed_mask_buffer
#     input_order: CHORDBeamformer
#     base_dir: /mnt/cs00/data/kotekan_vis_files/full/
#     baseband_gain_host_info: /fpga_controller
#     use_bitshuffle: true
#     compression: "lz4"
#     compression_level: 3
#     # Chunking: ensure positive chunk sizes
#     blocksize_f: 32
#     late_frame_grace_seconds: 30
#     num_file_t: 20


# DTV products, 448 frames per file: 28 frames of ~43 s from each of the 16 halves, about 20
# minutes. Every half sends every product, whether or not it binds a channel, so that holds
# for each of them. The frames are in arrival order; frame_metadata/COARSE_FREQ and
# frame_metadata/FPGA_SEQ_NUM identify the half and the window of each.
{% if dtv_enabled %}
write_dtv:
{% for p in dtv_sent %}
    {{ p[0] }}:
        kotekan_stage: hdf5FileWrite
        log_level: warn
        in_buf: dtv_{{ p[0] }}_buffer
        base_dir: /mnt/cs00/data/dtv
        # One acq_<start time> directory per run, so a restart keeps the previous files.
        acq_dir: true
        file_name: dtv_{{ p[0] }}
        prefix_hostname: false
        frames_per_file: 448
        record_per_frame_metadata: true
{% endfor %}
{% endif %}

# Incoherent-beam power from the X-engine halves (incoherent.j2): frames of 32 time samples
# (1.31 ms each) over a half's num_local_freq frequencies, 24 per second from each of 16
# halves. The shape and the port must match incoherent.j2. All halves share one buffer; 1024
# frames are 2.6 s, which covers the search's passes (0.3 s of data each).
incoherent_power_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: 1100

incoherent_power_buffer:
    kotekan_buffer: ndarray
    num_frames: 1024
    value_type: uint16
    extents: [32, {{ num_local_freq }}]
    quantity_name: "incoherent_beam_power"
    dimnames: ["Trfi", "F"]
    dimscalings: [256, 1]
    metadata_pool: incoherent_power_pool

buffer_recv_incoherent_power:
    kotekan_stage: bufferRecv
    use_frame_desc: true
    buf: incoherent_power_buffer
    listen_port: 11039

# Pulse search of the summed power: 300-1600 MHz, DM 3-1500. The step between trial DMs is
# 0.12 up to DM 100 and grows to 0.56 at DM 1500: incoherent_num_dm trials (the stage logs the
# number). The fixed masks are listed with the stage. It needs 1 GB. Timed on recv1
# with 6144 channels and the 4281 trials from DM 100: 8 threads search 2.2 s of data per
# second (6 threads 1.8 s); the trials below DM 100 add 19 %.
{% set incoherent_num_dm = 5089 %}

# For monitoring: the highest S/N of each trial DM in each of the last 178 search passes
# (60 s), the newest row last. Nothing consumes it; peek_hold keeps the newest image for
# choco's pipeline page, which draws it. A pulse appears when the search has seen it, that
# is when its sweep has reached the bottom of the band.
incoherent_snr_buffer:
    kotekan_buffer: ndarray
    num_frames: 4
    peek_hold: true
    value_type: float32
    extents: [178, {{ incoherent_num_dm }}]
    quantity_name: "incoherent_beam_snr"
    dimnames: ["Tpass", "DM"]
    dimscalings: [65536, 1]
    metadata_pool: incoherent_power_pool

# For a live display: the samples of the last 20 s as the search saw them, after its masks, in
# bins of 32 samples (42 ms) by 8 channels (1.6 MHz), the newest row last. A value is in units
# of 1/16 sigma of its bin and -128 marks a bin with nothing in use. Nothing consumes it;
# peek_hold keeps the newest image for choco's beam page, which asks about three times a second
# and puts the frames together by their sequence numbers.
incoherent_waterfall_buffer:
    kotekan_buffer: ndarray
    num_frames: 4
    peek_hold: true
    value_type: int8
    extents: [480, 832]
    quantity_name: "incoherent_waterfall"
    dimnames: ["Trfi", "F"]
    dimscalings: [8192, 8]
    metadata_pool: incoherent_power_pool

# The samples around each candidate without a flag, as the search saw them and shifted by the
# candidate's DM: 1.7 MB before compression, one file per candidate. A pulse is a column in
# the middle. A file is cutouts/acq_<start of kotekan>/cutout.<UTC of its first sample>.<n>.h5
# with n the "cutout" of the candidate's line in candidates.jsonl, counted from the start.
incoherent_cutout_buffer:
    kotekan_buffer: ndarray
    num_frames: 8
    value_type: int8
    extents: [6656, 256]
    quantity_name: "incoherent_beam_cutout"
    dimnames: ["F", "Trfi"]
    dimscalings: [1, 256]
    metadata_pool: incoherent_power_pool

write_incoherent_cutouts:
    kotekan_stage: hdf5FileWrite
    log_level: warn
    in_buf: incoherent_cutout_buffer
    base_dir: /mnt/cs00/data/incoherent_beam_search/cutouts
    acq_dir: true
    file_name: cutout
    time_in_file_name: true
    prefix_hostname: false

incoherent_beam_search:
    kotekan_stage: IncoherentBeamSearch
    cpu_affinity: [4,5,6,7,8,9,10,11]
    num_threads: 8
    in_buf: incoherent_power_buffer
    snr_buf: incoherent_snr_buffer
    waterfall_buf: incoherent_waterfall_buffer
    cutout_buf: incoherent_cutout_buffer
    freq_id_base: 1536
    num_local_freq: 6656
    num_feeds: num_elements
    dm_min: 3
    dm_knee: 100
    # Candidates are listed from 5.5 sigma at every DM (the reporting cut), to see the
    # pulsars in the beam and what the flags in the candidate file take out; thermal noise
    # alone gives about 23000 a day. A candidate gets a cutout (the intensity dump cut) from
    # 6 sigma at DM 100 and above (the default of trigger_min_dm) when it has no other flag,
    # and from 6.5 sigma with any flag but "undispersed": about 1500 a day at the rates of
    # 2026-11-22, most of them thermal noise.
    threshold: 5.5
    trigger_min_snr: 6
    cutout_flagged_min_snr: 6.5
    # No cutouts of the Crab pulsar: its pulses were found at DM 56.2-56.9 and Earth rotation
    # angles 192-215 degrees on 2026-11-22, 1241 cutouts in the hour of its transit.
    cutout_exclude:
        - [54, 60, 192, 216]
    # CHORD's static RFI mask, chord_util.rfi.BAD_FREQUENCIES["chord"] (bdfd697), with two
    # changes for a search for pulses: all of 1010-1130 MHz, where aircraft transmit in
    # pulses, in place of its two Mode S lines, and GNSS L1, which is above its data.
    mask_bands_mhz:
        - [356, 390]        # mobile services
        - [449.41, 450.98]
        - [454.88, 456.05]
        - [457.62, 459.18]
        - [483.01, 485.35]
        - [487.70, 494.34]  # UHF TV channel 17
        - [517.97, 525]
        - [529.10, 536.52]  # UHF TV channel 24
        - [564.65, 578]     # UHF TV channels 30 and 31
        - [584, 590]        # UHF TV channel 33
        - [596, 602]        # UHF TV channel 35
        - [617, 652]        # 600 MHz mobile
        - [717, 728]        # 700 and 800 MHz cellular
        - [729, 745.12]
        - [746, 756]
        - [758, 768]
        - [824, 849]
        - [869, 894]
        - [1010, 1130]      # aircraft: DME, secondary radar, ADS-B
        - [1135, 1315]      # navigation, GNSS, the 23 cm amateur band
        - [1559, 1610]      # GNSS L1
    candidate_file: /mnt/cs00/data/incoherent_beam_search/candidates.jsonl
    dm_file: /mnt/cs00/data/incoherent_beam_search/trial_dms.json
{%- if incoherent_write_power | default(false) %}
    power_buf: incoherent_power_record_buffer
{%- endif %}
{%- if incoherent_write_sums | default(false) %}
    out_buf: incoherent_sums_buffer

# For tests: the dedispersed sum of every trial DM at every time sample, 13 MB/s (47 GB per
# hour) before compression. Render with incoherent_write_sums true for a run of an hour or so,
# not for normal operation. A file holds 64 search passes (21 s); a row of it is the time at
# the bottom of the band, and trial_dms.json gives each DM's sweep back to the top.
incoherent_sums_buffer:
    kotekan_buffer: ndarray
    num_frames: 8
    value_type: float32
    extents: [256, {{ incoherent_num_dm }}]
    quantity_name: "incoherent_beam_sums"
    dimnames: ["Trfi", "DM"]
    dimscalings: [256, 1]
    metadata_pool: incoherent_power_pool

write_incoherent_sums:
    kotekan_stage: hdf5FileWrite
    log_level: warn
    in_buf: incoherent_sums_buffer
    base_dir: /mnt/cs00/data/incoherent_beam_search
    acq_dir: true
    file_name: incoherent_sums
    prefix_hostname: false
    frames_per_file: 64
{%- endif %}
{%- if incoherent_write_power | default(false) %}

# For a run of a few days: the power of every time sample as the search received it, before any
# mask, 10 MB/s (880 GB a day) before compression. Render with incoherent_write_power true. The
# search can be run again on these files with other masks and cuts. A file is
# power/acq_<start of kotekan>/power.<UTC of its first sample>.<n>.h5 and holds 256 frames of
# 256 samples (86 s), [time, channel] with 0 for a missing value. The search does not wait for
# the writer: with the 600 frames (205 s, 2 GB) full a frame is left out, the stage counts it in
# power_skipped_total, and the next frame starts a new file. The writer stops for 60 to 80 s
# while hdf5N2Write finalizes a subset file, and 64 frames (21 s) lost 40 to 60 s each time.
incoherent_power_record_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: 610

incoherent_power_record_buffer:
    kotekan_buffer: ndarray
    num_frames: 600
    value_type: uint16
    extents: [256, 6656]
    quantity_name: "incoherent_beam_power"
    dimnames: ["Trfi", "F"]
    dimscalings: [256, 1]
    metadata_pool: incoherent_power_record_pool

write_incoherent_power:
    kotekan_stage: hdf5FileWrite
    log_level: warn
    in_buf: incoherent_power_record_buffer
    base_dir: /mnt/cs00/data/incoherent_beam_search/power
    acq_dir: true
    file_name: power
    time_in_file_name: true
    prefix_hostname: false
    frames_per_file: 256
{%- endif %}
