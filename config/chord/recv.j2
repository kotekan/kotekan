{#-
  recv.j2
  Basic N2 receiver config.
-#}


# Frames per buffer_depth in the receive buffers: one per sent frequency ID (num_sent_freq),
# plus headroom for late frames.
{% set num_recv_frames = 6550 %}

# The frequency IDs the F-engine sends, 1536 + 128 index + stream for 48 indices and 128
# streams: 1536 to 7679, the 300-1500 MHz band in telescope.j2. Rows of the auto spectrum.
{% set first_freq_id = 1536 %}
{% set num_sent_freq = 6144 %}


# num_dishes: dishes/antennas to simulate.
# With 2 polarizations, num_elements = 2 * num_dishes, which the n2k correlator requires to be a multiple of 128
# (CorrelatorParams::ns_divisor). That means num_dishes must be a multiple of 64. This also satisfies the counts
# block (num_elements/8 divisible by 8) and the packet-loss mask’s dish/8 grouping.
{% set num_dishes = 64 %}

# fpga time samples per X-engine correlation frame; the bad feed mask stream carries one frame
# per this many samples. Must match pathfinder.j2.
{% set samples_per_data_set = 8192 %}


---
{% include "common.j2" %}

cpu_affinity: [0,1,2,3]

# The element order of the received visibility matrices, used by hdf5N2Write to look up feed
# positions and dish grid indices. The correlated element axis comes from the voltage buffer's
# [..., P, D], so element index = polarization * num_dishes + dish, which is what
# CHORDTelescope encodes as a station id and what CHORDBeamformer indexes by.
input_order: CHORDBeamformer

# X-engine halves sending bad feed masks to hdf5N2Write. Each half takes 1/16 of the F-engine
# stream ids, spaced by 16 (crs16BoardCaptureWorker), so half k owns the frequency ids
# min_science_freq_id + k + 16 n.
num_bad_feed_mask_streams: 16

{% include "telescope.j2" %}

# Pools
n2_pool:
    kotekan_metadata_pool: N2Metadata
    num_metadata_objects: 16 * buffer_depth

chord_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: 4 * buffer_depth

# Metadata for the received bad feed mask frames: one object per frame in bad_feed_mask_buffer.
bad_feed_mask_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: 1024 + 4 * buffer_depth



# Receive subset N2 buffer: compact frames over the non-Missing elements, derived from this
# config's dish table, which must match the X-engine's (see use_frame_desc below).
n2_recv_subset_buffer:
    kotekan_buffer: N2
    peek_hold: true
    num_ev: num_ev_to_calculate
    n2_layout: "DishInputs"
    num_frames: buffer_depth * {{ num_recv_frames }}
    metadata_pool: n2_pool

# Receive full N2 Buffer

n2_recv_full_buffer:
    kotekan_buffer: N2
    peek_hold: true
    num_elements: 128
    num_ev: 0
    n2_layout: "FullUpperTri"
    num_frames: buffer_depth * {{ num_recv_frames }}
    metadata_pool: n2_pool

# Autocorrelation power gathered across frequency, one frame per accumulation
# bin. Produced by N2AutoSpectrum: float32 "autospectrum"
# [num_sent_freq, num_elements] {F, E}, row 0 at first_freq_id; rows stay NaN
# until that freq_id arrives. No consumer: held for the /buffer/auto_spectrum_buffer/frame
# peek endpoint.
auto_spectrum_buffer:
    kotekan_buffer: ndarray
    peek_hold: true
    num_frames: buffer_depth
    value_type: float32
    extents: [{{ num_sent_freq }}, num_elements]
    metadata_pool: chord_pool

# Bad feed mask streams from the X-engine, one frame per correlation frame per NUMA half,
# stamped with the FPGA seq it applies from and the half's coarse frequencies, which identify
# the stream. hdf5N2Write takes them in on their own thread, so the depth only has to cover
# that thread's latency; a full buffer drops frames, which the files record as -1 rows.
# Shape must match the X-engine's host_bf_mask_buffer_<n>.
bad_feed_mask_buffer:
    kotekan_buffer: ndarray
    num_frames: 1024
    value_type: int8
    quantity_name: "bf_mask"
    dimnames: ["Tbf", "P", "D"]
    dimscalings: [{{ samples_per_data_set }}, 1, 1]
    extents: [1, num_polarizations, num_dishes]
    metadata_pool: bad_feed_mask_pool



## Receive data

# use_frame_desc checks the sender's frame descriptor (layout and element count) against the
# buffers above at connection time; must match the bufferSend stages in pathfinder.j2.
# Element identities are not on the descriptor: a dish table that diverges from the
# X-engine's at the same connected count would be written out mislabeled.

buffer_recv_subset_subset:
    kotekan_stage: bufferRecv
    use_frame_desc: true
    buf: n2_recv_subset_buffer
    listen_port: 11025

buffer_recv_full_n2:
    kotekan_stage: bufferRecv
    use_frame_desc: true
    buf: n2_recv_full_buffer
    listen_port: 11027

# hdf5N2Write records the mask frames in the vis files (each file's /bad_feed_mask group holds
# every stream's masks over its time span), so both writers consume this buffer.
buffer_recv_bad_feed_mask:
    kotekan_stage: bufferRecv
    use_frame_desc: true
    buf: bad_feed_mask_buffer
    listen_port: 11029

# Live autocorrelation power vs frequency from the full N2 stream, for the
# peek endpoint. num_pending_bins is left at its default (2).
auto_spectrum:
    kotekan_stage: N2AutoSpectrum
    in_buf: n2_recv_full_buffer
    out_buf: auto_spectrum_buffer
    num_local_freq: {{ num_sent_freq }}
    freq_id_base: {{ first_freq_id }}



## Write out the visibilities using HDF5

# Subset visibilities
hdf5_N2_write_subset:
    kotekan_stage: hdf5N2Write
    cpu_affinity: [12]
    in_buf: n2_recv_subset_buffer
    in_bad_feed_mask_buf: bad_feed_mask_buffer
    input_order: CHORDBeamformer
    base_dir: /mnt/cs00/data/kotekan_vis_files/subset/
    baseband_gain_host_info: /fpga_controller
    use_bitshuffle: true
    compression: "lz4"
    compression_level: 3
    # Chunking: ensure positive chunk sizes
    blocksize_f: 16
    late_frame_grace_seconds: 30
    num_file_t: 20


