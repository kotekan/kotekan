{#-
  dtv_shared.j2: what pathfinder.j2 (with dtv.j2) and recv.j2 must agree on. Import it with
  context, so that both sides read the same two render variables:
  dtv_enabled (default true): false leaves the detector, the mask and the recording out of
  both configs.
  dtv_calibration_mode (default false): also send and write the powers, fine support and fine
  powers. Only the mask is sent without it.
-#}
{% from "telescope.j2" import num_local_freq %}
{% set dtv_enabled = dtv_enabled|default(true) %}
{#- Blocks of 8192 samples that NDArrayTimeConcat packs into one sent frame (~43 s). -#}
{% set dtv_blocks_per_frame = 1024 %}
{#- Product, value type, extents after the time axis, dimnames, dimscalings, recv port. -#}
{% set dtv_products = [
    ("mask", "int8", num_local_freq ~ "", '"F"', "1", 11031),
    ("powers", "uint64", num_local_freq ~ ", 3", '"F", "W"', "1, 1", 11033),
    ("fine_support", "int32", num_local_freq ~ ", 2", '"F", "S"', "1, 1", 11035),
    ("fine_powers", "uint64", "2, 3, 256", '"F", "W", "B"', "1, 1, 1", 11037),
] %}
{% set dtv_sent = dtv_products if dtv_calibration_mode|default(false) else dtv_products|selectattr("0", "equalto", "mask")|list %}
