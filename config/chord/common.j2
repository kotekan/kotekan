{#-
  common.j2
  Keys every CHORD pathfinder config shares (X-engine and receiver): kotekan's document
  type, logging, the F-engine controller and its tracker, the element counts, and the
  controller monitor stage.  Included right after the `---` document start; the includer
  sets num_dishes first (see pathfinder.j2 and recv.j2).
-#}
type: config

# Logging level can be one of:
# OFF, ERROR, WARN, INFO, DEBUG, DEBUG2 (case insensitive)
# Note DEBUG and DEBUG2 require a build with (-DCMAKE_BUILD_TYPE=Debug)
log_level: WARN

# Referenced by /CHORDTelescope/gps_host_info, /config_tracker/fpga_host_info,
# and per-stage baseband_gain_host_info (e.g. on hdf5N2Write).
fpga_controller:
    host: "chive"
    port: 54321
    config_endpoint: /config
    timing_endpoint: /get-frame0-time
    gains_endpoint: /get-current-gain-file

config_tracker:
    enabled: true
    fpga_host_info: /fpga_controller
    upstream_fetch_retries: 2
    upstream_fetch_timeout_seconds: 10

buffer_depth: 4

num_times: samples_per_data_set  # New N2K needs this.
num_polarizations: 2
num_dishes: {{ num_dishes }}
num_elements: num_polarizations * {{ num_dishes }}
num_ev_to_calculate: 2

## Monitor the F-engine for drift ##
# The config tracker reads the F-engine controller once at startup and hands
# that snapshot downstream; this re-reads it so a controller that is
# reprogrammed or resynced mid-acquisition is caught rather than silently
# invalidating every config already propagated.
fpga_monitor:
    kotekan_stage: FPGAMonitor
    poll_interval_seconds: 5
    fetch_timeout_seconds: 5
