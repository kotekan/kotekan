earth_rotation_data:
    kotekan_update_endpoint: json
    earth_orientation_parameter_table: []


# Pools
main_pool:
    kotekan_metadata_pool: chordMetadata
    num_metadata_objects: 40 * buffer_depth

n2_pool:
    kotekan_metadata_pool: N2Metadata
    num_metadata_objects: 16 * buffer_depth

# Buffers
network_input_buffers:
    num_frames: {{ num_capture_frames }}
    frame_size: dpdk_output_frame_size
    metadata_pool: main_pool
    use_hugepages: true

    # The workers share an output buffer.
    # Fed by dpdkCore (crs16BoardCaptureWorker handler) -> leave standard.
    network_input_buffer_0:
        zero_new_frames: true
        numa_node: 0
        zero_value: 0x88
        kotekan_buffer: standard
    network_input_buffer_1:
        zero_new_frames: true
        numa_node: 1
        zero_value: 0x88
        kotekan_buffer: standard

# Main voltage buffer after transpose.
# Produced by TransposeBasebandArray: int4x2_swapped_withoffset "E"
# [timesamples_per_frame, NUM_LOCAL_FREQ, 2, NUM_ELEMENTS/2] = [samples_per_data_set, 384, 2, 64].
# The stage uses compile-time macros NUM_LOCAL_FREQ=384, NUM_ELEMENTS=128 (it fatally checks the
# config num_local_freq/num_elements equal them); this config sets num_local_freq=384,
# num_elements=128, so the static extents below are valid. These live outside the
# network_input_buffers group: that group's frame_size is for the dpdk buffers, while
# ndarray buffers derive their size from the descriptor.
host_voltage_buffer_0:
    kotekan_buffer: ndarray
    num_frames: host_side_buffer_depth
    value_type: int4x2_swapped_withoffset
    extents: [samples_per_data_set, num_local_freq, 2, num_elements / 2]
    metadata_pool: main_pool
    use_hugepages: true
    numa_node: 0

host_voltage_buffer_1:
    kotekan_buffer: ndarray
    num_frames: host_side_buffer_depth
    value_type: int4x2_swapped_withoffset
    extents: [samples_per_data_set, num_local_freq, 2, num_elements / 2]
    metadata_pool: main_pool
    use_hugepages: true
    numa_node: 1


# Subset Buffers, one per NUMA domain.
# The extents must match what SubsetBaseband produces, which is why the trailing dish
# extent is derived from dish_blocks_subset above.
subset_voltage_buffer_0:
    kotekan_buffer: ndarray
    extents: [samples_per_data_set, num_local_freq, 2, {{ num_subset_dishes }}]
    value_type: int4x2_swapped_withoffset
    numa_node: 0
    num_frames: {{ subset_buffer_depth }}
    metadata_pool: main_pool

subset_voltage_buffer_1:
    kotekan_buffer: ndarray
    extents: [samples_per_data_set, num_local_freq, 2, {{ num_subset_dishes }}]
    value_type: int4x2_swapped_withoffset
    numa_node: 1
    num_frames: {{ subset_buffer_depth }}
    metadata_pool: main_pool

packet_receipt_bitmap_buffers:
    log_level: info
    num_frames: {{ num_capture_frames }}
    frame_size: (samples_per_data_set / time_samples_per_packet) * num_crs_boards  # One bit per stream
    metadata_pool: main_pool
    use_hugepages: true
    packet_receipt_bitmap_buffer_0:
        kotekan_buffer: standard
    packet_receipt_bitmap_buffer_1:
        kotekan_buffer: standard
    combined_receipt_bitmap_buffer_0:
        kotekan_buffer: standard
    packet_receipt_bitmap_buffer_2:
        kotekan_buffer: standard
        numa_node: 1
    packet_receipt_bitmap_buffer_3:
        kotekan_buffer: standard
        numa_node: 1
    combined_receipt_bitmap_buffer_1:
        kotekan_buffer: standard
        numa_node: 1

# This is the RFI Mask recieved from the GPU, that was applied to produce n2k_correlation & n2k_counts.
# It contains the mask computed by SKtilde (all-good if rfi_first_stage_excision_enabled is false).
# GPU output (cudaCopyFromRingbuffer of rfi_RFImask) and consumed by RfiMaskSum:
# uint1x8 "RFImask" [samples_per_data_set/1024, num_local_freq, 128] {T8hi128, F, T8lo128}.
host_rfi_RFImask_buffer:
    kotekan_buffer: ndarray
    num_frames: host_side_buffer_depth
    value_type: uint1x8
    extents: [samples_per_data_set / 1024, num_local_freq, 128]
    zero_new_frames: true
    zero_value: 0xFF
    metadata_pool: main_pool

host_rfi_RFImask_buffer_1:
    kotekan_buffer: ndarray
    num_frames: host_side_buffer_depth
    value_type: uint1x8
    extents: [samples_per_data_set / 1024, num_local_freq, 128]
    zero_new_frames: true
    zero_value: 0xFF
    numa_node: 1
    metadata_pool: main_pool

# Note this is the expanded version of the pl_mask, produced by ProcessPacketMask (pl_mask_buf).
# It will be compressed to the normal PL mask before being sent to the GPU.
# uint1x8 "pl_mask_exp" [samples_per_data_set/64, num_local_freq, 2, num_elements/8/2, 8]
# {Thi64, F, P, D8, Tlo64}.
host_pl_mask_exp_buffer:
    kotekan_buffer: ndarray
    num_frames: host_side_buffer_depth
    value_type: uint1x8
    extents: [samples_per_data_set / 64, num_local_freq, 2, num_elements / 8 / 2, 8]
    metadata_pool: main_pool

host_pl_mask_exp_buffer_1:
    kotekan_buffer: ndarray
    num_frames: host_side_buffer_depth
    value_type: uint1x8
    extents: [samples_per_data_set / 64, num_local_freq, 2, num_elements / 8 / 2, 8]
    metadata_pool: main_pool
    numa_node: 1


# Stages

##  Packet capture from the F-engine ##
dpdk:
    kotekan_stage: dpdkCore
    log_level: INFO
    # Format is index = lcore, value = cpu core
    lcore_cpu_map: [5, 6, 7, 21, 22, 23] # [5,6,7]
    main_lcore_cpu: 4
    num_mbufs: 16384
    rx_ring_size: 1024
    mbuf_cache_size: 512
    packet_size: 6208
    payload_size: 6144
    max_rx_pkt_len: 6208
    burst_size: 32
    max_link_start_delay: 10
    # The number of stream IDs expected per worker
    num_expected_stream_ids: 4
    # Capture scheduling. Both options are read by every capture worker below.
    #
    # capture_start_time_utc: hold off until this UTC wall clock time. The time is turned into
    # an FPGA seq number using the F-engine's GPS time (never the system clock) and rounded
    # down to the nearest frame edge, so all workers start on the same frame. It must be at
    # least 1 minute in the future, and a start more than 12 hours out only warns.
    # Commented out means start at the first frame edge ~2 s after packets begin arriving.
    # Worth keeping set while recording both NUMA domains: it is the only way the port 0 and
    # port 1 workers are guaranteed the same start seq, and hence the two writers the same
    # timestamped folder. Unscheduled, their starts can differ by one frame (~42 ms), which
    # now and then rounds to two different folder names. Harmless for merging (point
    # merge_baseband_freq.py at /scratch/baseband and it recurses into both), but untidy.
    capture_start_time_utc: "2026-09-04 18:18:00"
    # capture_n_frames: stop after this many frames, 0 = record until kotekan is stopped.
    capture_n_frames: {{ num_capture_frames }}
    # List of PCIe addresses to block from DPDK use
    pcie_block_list:
        - "0000:37:00.0"
        - "0000:37:00.1"
        - "0000:b5:00.0"
        - "0000:b5:00.1"
    worker_ring_map:
        - name: worker_ring_0
          num_slots: 512
          socket_id: 0
        - name: worker_ring_1
          num_slots: 512
          socket_id: 0
        - name: worker_ring_2
          num_slots: 512
          socket_id: 1
        - name: worker_ring_3
          num_slots: 512
          socket_id: 1
    # Format is index = lcore, value = array of port IDs
    # so [[0,1],[2,3]] maps lcore 0 to service ports 0 and 1,
    # and lcore 1 to service ports 2 and 3.
    lcore_port_map:
        - [0]
        - [1]
    # One handler must be given per port
    handlers:
        - dpdk_handler: crs16BoardDistributor
          worker_rings: [0,1]
        - dpdk_handler: crs16BoardDistributor
          worker_rings: [2,3]
    # Exactly One worker must be given per worker ring
    workers:
        - dpdk_handler: crs16BoardCaptureWorker
          frame_service_cpu_affinity: [4]
          worker_ring: 0
          port: 0
          allocate_metadata: true
          out_buf: network_input_buffer_0
          receipt_bitmap_buf: packet_receipt_bitmap_buffer_0
        - dpdk_handler: crs16BoardCaptureWorker
          frame_service_cpu_affinity: [4]
          worker_ring: 1
          port: 0
          out_buf: network_input_buffer_0
          receipt_bitmap_buf: packet_receipt_bitmap_buffer_1
        - dpdk_handler: crs16BoardCaptureWorker
          frame_service_cpu_affinity: [20]
          worker_ring: 2
          port: 1
          allocate_metadata: true
          out_buf: network_input_buffer_1
          receipt_bitmap_buf: packet_receipt_bitmap_buffer_2
        - dpdk_handler: crs16BoardCaptureWorker
          frame_service_cpu_affinity: [20]
          worker_ring: 3
          port: 1
          out_buf: network_input_buffer_1
          receipt_bitmap_buf: packet_receipt_bitmap_buffer_3

missing_source_ids: [2, 3, 4, 5, 6, 10, 11, 12, 13, 14]

# Combine packet receipt bitmaps and generate packet-loss masks
process_packet_mask_0:
    kotekan_stage: ProcessPacketMask
    voltage_buf: network_input_buffer_0
    receipt_bitmap_bufs:
        - packet_receipt_bitmap_buffer_0
        - packet_receipt_bitmap_buffer_1
    combined_receipt_bitmap_buf: combined_receipt_bitmap_buffer_0
    pl_mask_buf: host_pl_mask_exp_buffer
    rfi_mask_buf: host_rfi_RFImask_buffer
    num_frequency: num_local_freq
    num_source_ids: num_crs_boards

process_packet_mask_1:
    kotekan_stage: ProcessPacketMask
    cpu_affinity: [16]
    voltage_buf: network_input_buffer_1
    receipt_bitmap_bufs:
        - packet_receipt_bitmap_buffer_2
        - packet_receipt_bitmap_buffer_3
    combined_receipt_bitmap_buf: combined_receipt_bitmap_buffer_1
    pl_mask_buf: host_pl_mask_exp_buffer_1
    rfi_mask_buf: host_rfi_RFImask_buffer_1
    num_frequency: num_local_freq
    num_source_ids: num_crs_boards

# Transpose the voltage data from the network input buffer into a more convenient layout
# for the GPU and baseband dump processing. 
# This also applies the packet-loss mask to the data
transpose_voltage_0:
    kotekan_stage: TransposeBasebandArray
    cpu_affinity: [2]
    timesamples_per_frame: samples_per_data_set
    in_buf: network_input_buffer_0
    pl_mask_buf: host_pl_mask_exp_buffer
    out_buf: host_voltage_buffer_0
    frame_mode: even
    log_level: info

transpose_voltage_1:
    kotekan_stage: TransposeBasebandArray
    cpu_affinity: [3]
    timesamples_per_frame: samples_per_data_set
    in_buf: network_input_buffer_0
    pl_mask_buf: host_pl_mask_exp_buffer
    out_buf: host_voltage_buffer_0
    frame_mode: odd
    log_level: info

transpose_voltage_2:
    kotekan_stage: TransposeBasebandArray
    cpu_affinity: [17]
    timesamples_per_frame: samples_per_data_set
    in_buf: network_input_buffer_1
    pl_mask_buf: host_pl_mask_exp_buffer_1
    out_buf: host_voltage_buffer_1
    frame_mode: even
    log_level: info

transpose_voltage_3:
    kotekan_stage: TransposeBasebandArray
    cpu_affinity: [18]
    timesamples_per_frame: samples_per_data_set
    in_buf: network_input_buffer_1
    pl_mask_buf: host_pl_mask_exp_buffer_1
    out_buf: host_voltage_buffer_1
    frame_mode: odd
    log_level: info

subset_baseband_0:
    kotekan_stage: SubsetBaseband
    timesamples_per_frame: samples_per_data_set
    in_buf: host_voltage_buffer_0
    out_buf: subset_voltage_buffer_0
    log_level: info

# Same subset on the NUMA 1 half of the band. The default cpu_affinity is a NUMA 0 core
# list, which would pull this domain's 384 MiB input frames and push its {{ subset_frame_mib }} MiB output
# frames across the socket link, so pin the
# NUMA 1 stages to free cores on node 1 (16-31; 16-18 and 20-23 are taken by the packet
# mask, transposes, frame service and DPDK lcores).
subset_baseband_1:
    kotekan_stage: SubsetBaseband
    cpu_affinity: [24, 25, 26, 27, 28, 29, 30, 31]
    timesamples_per_frame: samples_per_data_set
    in_buf: host_voltage_buffer_1
    out_buf: subset_voltage_buffer_1
    log_level: info

# The two writers share a base_dir and a timestamped capture folder, so they need
# distinct file names. prefix_host_rank prepends "x<frequency_pool_rank:04d>_", giving
# <host>_x0000_baseband_subset.*.h5 and <host>_x0001_baseband_subset.*.h5. The dataset
# name inside the files stays "baseband_subset" for both, which is what
# python/scripts/merge_baseband_freq.py expects when it stitches the halves back
# together by their coarse_freq attributes.
hdf5_write_baseband_0:
    kotekan_stage: hdf5FileWrite
    in_buf: subset_voltage_buffer_0
    base_dir: /scratch/baseband
    # Put each capture in its own base_dir/<UTC start time> folder, created on the first
    # frame and named from that frame's FPGA seq number, e.g.
    # /scratch/baseband/20260811T031500Z/
    timestamp_subdir: true
    file_name: baseband_subset
    prefix_host_rank: true
    frequency_pool_rank: 0
    frequency_pool_size: 2
    # Capture this many frames (~42 ms / {{ subset_frame_mib }} MiB each), then shut down kotekan.
    # Matches the DPDK stage's capture_n_frames, so the writer flushes everything the
    # capture produced and then exits.
    max_frames: {{ num_capture_frames }}
    # Fetch the FPGA digital gains from the controller and copy them into every output file
    # as /digital_gains, so the recorded voltages can be interpreted without a side lookup.
    # Each writer caches its own copy under <capture dir>/.partial/, so the two do not race.
    baseband_gain_host_info: /fpga_controller
    # Frames appended to each file before rolling over to a new one
    frames_per_file: 20
    # bitshuffle+zstd cannot keep up with the full subset data rate
    use_compression: false
    log_level: info

hdf5_write_baseband_1:
    kotekan_stage: hdf5FileWrite
    cpu_affinity: [24, 25, 26, 27, 28, 29, 30, 31]
    in_buf: subset_voltage_buffer_1
    base_dir: /scratch/baseband
    timestamp_subdir: true
    file_name: baseband_subset
    prefix_host_rank: true
    frequency_pool_rank: 1
    frequency_pool_size: 2
    max_frames: {{ num_capture_frames }}
    baseband_gain_host_info: /fpga_controller
    frames_per_file: 20
    use_compression: false
    log_level: info

hex_dump_0:
    #kotekan_stage: hexDump
    in_buf: subset_voltage_buffer_0
    len: 512

hex_dump_1:
    #kotekan_stage: hexDump
    in_buf: host_voltage_buffer_1
    len: 8192


