# Accumulate N2K visibilities on CPU

hex_dump:
    #kotekan_stage: hexDump
    in_buf: n2_buffer
    len: 4096


n2_accumulate:
    kotekan_stage: N2Accumulate
    cpu_affinity: [9]
    in_buf: host_correlation_buffer
    in_counts_buf: host_counts_buffer
    in_rfimask_buf: host_rfi_RFImask_buffer
    out_buf: n2_buffer
    num_freq_per_n2k_frame: num_local_freq
    packet_loss_is_scalar: True
    num_n2k_samples_to_accumulate: {{ num_n2k_samples_to_accumulate }}


# Subset to first 12 elements (6 dishes x 2 polarizations)

n2_subset:
    kotekan_stage: N2Subset
    cpu_affinity: [11]
    in_buf: n2_buffer
    out_buf: n2_subset_buffer


