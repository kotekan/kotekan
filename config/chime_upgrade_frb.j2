        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer
        out_buffers:
            host_rfi_RFImask_buffer: host_rfi_RFImask_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_RFImask_ringbuffer
          gpu_mem_input: rfi_RFImask_buffer
          output_size: num_freq_gpu_buf * samples_per_data_set / 8
          ring_buffer_size: gpu_buffer_depth * output_size
          out_buf: host_rfi_RFImask_buffer

# Second-stage RFI flagging
compute_RFI_frame_mask:
    kotekan_stage: RfiFrameMask
    in_buf: host_rfi_SKtilde_buffer
    out_buf: host_rfi_RFIframemask_buffer
    sub_integration_ntime: n2k_sub_integration_ntime
    enabled_updatable_config: /updatable_config/rfi_second_stage_enabled
    thresholds_updatable_config: /updatable_config/rfi_second_stage_thresholds

rfi_broadcast:
    kotekan_stage: rfiBroadcast
    rfi_sktilde_buf: host_rfi_SKtilde_buffer
    rfi_skbar_buf: host_rfi_SKbar_buffer
    rfi_mask_buf: host_rfi_RFImask_buffer
    # Same value as legacy system. Can be increased or decreased based
    # on the rate at which we want to be sending packets
    frames_per_packet: 10
    destination_port: "3000"
    # This is the IP of `vm-steelpan-recv1`. Needs to be updated when
    # production aux nodes are available
    destination_ip: "10.5.60.1"

################################################################################
# n2k setup

# Correlator setup
n2k_sub_integration_ntime: samples_per_data_set
# n2k_samples_per_data_set = max(samples_per_data_set, n2k_sub_integration_ntime)
n2k_samples_per_data_set: samples_per_data_set

# Buffers

n2k_num_subintegrations: n2k_samples_per_data_set / n2k_sub_integration_ntime

n2k_correlation_blocksize: 16
n2k_correlation_num_elements: num_dishes * num_polarizations
n2k_correlation_linear_num_blocks: (n2k_correlation_num_elements + n2k_correlation_blocksize - 1) / n2k_correlation_blocksize
n2k_correlation_triangle_num_blocks: n2k_correlation_linear_num_blocks * (n2k_correlation_linear_num_blocks + 1) / 2
n2k_correlation_triangle_size: n2k_correlation_blocksize * n2k_correlation_blocksize * n2k_correlation_triangle_num_blocks

n2k_counts_blocksize: 8
n2k_counts_num_elements: num_dishes / 8 * num_polarizations
n2k_counts_linear_num_blocks: (n2k_counts_num_elements + n2k_counts_blocksize - 1) / n2k_counts_blocksize
n2k_counts_triangle_num_blocks: n2k_counts_linear_num_blocks * (n2k_counts_linear_num_blocks + 1) / 2
n2k_counts_triangle_size: n2k_counts_blocksize * n2k_counts_blocksize * n2k_counts_triangle_num_blocks

host_n2k_correlation_buffer:
    kotekan_buffer: ndarray
    num_frames: gpu_buffer_depth
    use_hugepages: true
    value_type: int32
    # produced by cudaCorrelator (n2k_correlation): NDArrayBuffer<int32,6>
    # cudaCorrelator uses (num_elements+1)/16 = (2048+1)/16 = 128 blocks, same as
    # CPU num_elements/16 = 128 (num_elements=2048 is a multiple of 16; no triangle divergence).
    extents: [n2k_num_subintegrations, num_freq_gpu_buf, n2k_correlation_triangle_num_blocks, n2k_correlation_blocksize, n2k_correlation_blocksize, num_components]
    metadata_pool: main_pool

host_n2k_counts_buffer:
    kotekan_buffer: ndarray
    num_frames: gpu_buffer_depth
    value_type: int32
    # produced by lostSamplesToN2Counts (n2k_counts): NDArrayBuffer<int32,5>
    # ntiles = (num_elements/64)*(1+num_elements/64)/2 = 32*33/2 = 528, matches
    # config n2k_counts_triangle_num_blocks (= (n2k_counts_num_elements+1)/8 triangle) since
    # num_elements=2048 makes both = 528 (no divergence).
    extents: [n2k_num_subintegrations, num_freq_gpu_buf, n2k_counts_triangle_num_blocks, n2k_counts_blocksize, n2k_counts_blocksize]
    metadata_pool: main_pool

host_n2k_RFIcounts_buffer:
    kotekan_buffer: ndarray
    num_frames: gpu_buffer_depth
    value_type: int32
    # produced by RfiMaskSum (out_buf): {num_integrations, num_local_freq}
    extents: [samples_per_data_set / n2k_sub_integration_ntime, num_freq_gpu_buf]
    metadata_pool: main_pool

host_n2k_PLcounts_buffer:
    kotekan_buffer: ndarray
    num_frames: gpu_buffer_depth
    value_type: int32
    # produced by CountLostPLSamplesScalar (out_buf): {num_integrations, num_local_freq}
    extents: [samples_per_data_set / n2k_sub_integration_ntime, num_freq_gpu_buf]
    quantity_name: "pl_lost_counts_scalar"
    dimnames: [ "Tc", "F" ]
    dimscalings: [ n2k_sub_integration_ntime, 1 ]
    metadata_pool: main_pool

# Stages

run_n2k_correlation:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_xposed_voltage_ringbuffer: host_xposed_voltage_ringbuffer
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer
        out_buffers:
            host_n2k_correlation_buffer: host_n2k_correlation_buffer
        commands:
        - name: cudaCorrelator
          num_elements: num_dishes * num_polarizations
          #samples_per_data_set: n2k_samples_per_data_set # global samples_per_data_set exists and is used in n2k_samples_per_data_set
          sub_integration_ntime: n2k_sub_integration_ntime
          voltage_name: xposed_voltage
          rfi_RFImask_name: rfi_RFImask
          n2k_correlation_name: n2k_correlation
        - name: cudaSyncOutput
        - name: cudaOutputData
          gpu_mem: n2k_correlation_buffer
          out_buf: host_n2k_correlation_buffer

run_n2k_counts:
        kotekan_stage: lostSamplesToN2Counts
        num_n2k_freq: num_freq_gpu_buf
        sub_integration_ntime: n2k_sub_integration_ntime
        # already set via global
        # samples_per_data_set: samples_per_data_set
        # already set via global
        # num_elements: num_elements
        rfi_mask_buf: host_rfi_RFImask_buffer
        lost_samples_buffers:
        # TODO: this likely is wrong for non-trivial shuffled_host_buffers
        # since it assumes a fixed relation between lost_samples and
        # host_voltage buffers
{%- for id in range(num_freq_gpu_buf // 4) %}
        - lost_samples_buffer_{{ id }}
{%- endfor %}
        n2k_counts_buf: host_n2k_counts_buffer

################################################################################
# visibility matrix and eigendecomposition

# Buffers

vis_10s_buffer:
    kotekan_buffer: N2
    num_ev: 0
    n2_layout: "FullUpperTri"
    num_frames: gpu_buffer_depth * num_freq_gpu_buf
    metadata_pool: n2_pool

eig_10s_buffer:
    kotekan_buffer: N2
    num_ev: num_ev_to_calculate
    n2_layout: "FullUpperTri"
    num_frames: gpu_buffer_depth * num_freq_gpu_buf
    metadata_pool: n2_pool

failed_10s_buffer:
    kotekan_buffer: N2
    num_ev: 0
    n2_layout: "FullUpperTri"
    num_frames: gpu_buffer_depth * num_freq_gpu_buf
    metadata_pool: n2_pool

vis_buffer:
    kotekan_buffer: vis
    num_ev: num_ev_to_calculate
    num_frames: gpu_buffer_depth * num_freq_gpu_buf
    metadata_pool: vis_pool

failed_vis_buffer:
    kotekan_buffer: vis
    num_ev: 0
    num_frames: gpu_buffer_depth * num_freq_gpu_buf
    metadata_pool: vis_pool

vis_buffer_post:
    kotekan_buffer: vis
    num_ev: num_ev_to_calculate
    num_frames: gpu_buffer_depth * num_freq_gpu_buf
    metadata_pool: vis_pool

failed_vis_buffer_post:
    kotekan_buffer: vis
    num_ev: 0
    num_frames: gpu_buffer_depth * num_freq_gpu_buf
    metadata_pool: vis_pool

# Stages

run_recv_rfi_RFImask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        # maybe? Depends on the chunking of the previous stage
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_rfi_RFImask_ringbuffer: host_rfi_RFImask_ringbuffer
        out_buffers:
            host_rfi_RFImask_buffer: host_rfi_RFImask_buffer
        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_RFImask_ringbuffer
          gpu_mem_input: rfi_RFImask_buffer
          output_size: num_freq_gpu_buf * samples_per_data_set / 8
          ring_buffer_size: gpu_buffer_depth * output_size
          out_buf: host_rfi_RFImask_buffer

rfi_RFImask_count:
    kotekan_stage: RfiMaskSum
    in_buf: host_rfi_RFImask_buffer
    out_buf: host_n2k_RFIcounts_buffer
    sub_integration_ntime: n2k_sub_integration_ntime

n2k_PLmask_count:
    kotekan_stage: CountLostPLSamplesScalar
    # this is pretty silly, the actual source of truth is
    # lost_samples_buffer_{{ id }} which are already scalars
    in_buf: host_pl_mask_buffer
    out_buf: host_n2k_PLcounts_buffer
    sub_integration_ntime: n2k_sub_integration_ntime
    packet_loss_is_scalar: True

vis_accumulate:
    kotekan_stage: N2Accumulate
    in_buf: host_n2k_correlation_buffer
    in_counts_buf: host_n2k_counts_buffer
    in_rficounts_buf: host_n2k_RFIcounts_buffer
    in_plcounts_buf: host_n2k_PLcounts_buffer
    in_rfiframemask_buf: host_rfi_RFIframemask_buffer
    out_buf: vis_10s_buffer
    packet_loss_is_scalar: True
    cpu_affinity: [17, 18, 19]
    num_workers: 3
    input_order: CHIMEBeamformer
    output_order: CHIMECylinder
    # round_to_even(10e9 / ( n2k_samples_per_data_set * frame_arrival_period_ns ) * n2k_num_subintegrations)
    # round_up_to_even(10s / ( 16384 * 2.56us ) * 1) = 240
    # num_subintegrations_per_bin_maybe_odd: 10e9 / ( n2k_samples_per_data_set * frame_arrival_period_ns ) * n2k_num_subintegrations)
    # num_subintegrations_per_bin: (num_subintegrations_per_bin_maybe_odd + 1) / 2 * 2
    num_subintegrations_per_bin: 240
    # these recap values from cudaCorrelator
    num_freq_per_n2k_frame: num_freq_gpu_buf
    #samples_per_data_set: n2k_samples_per_data_set # a global of this nam exists used by n2k_samples_per_data_set
    sub_integration_ntime: n2k_sub_integration_ntime
    # set as global variable of same name
    #rfi_downsampling_factor: rfi_downsampling_factor
    num_elements: n2k_correlation_num_elements
    num_ev: 0 # only allowed value
    variance_mode: CHIMEv1

eigencalc:
    kotekan_stage: EigenN2Iter
    cpu_affinity: [14, 15, 16] # for blaze
    num_blaze_workers: 3
    num_ev: num_ev_to_calculate
    in_buf: vis_10s_buffer
    out_buf: eig_10s_buffer
    failed_buf: failed_10s_buffer
    # Convergence config from chime science run
    tol_eval: 0.00001
    tol_evec: 0.0001
    max_iterations: 19
    num_ev_conv: 2
    krylov: 2
    subspace: 1
    # Masking config from chime science run
    # TODO: these are (Roland assumes) in CHIME cylinder order but data is in
    # CHIME beamformer order (after xpose2048)
    diagonal_bands_filled: [ [0, 30], [251, 262] ]
    exclude_inputs: [  46,   84,  107,  136,  142,  256,  257,  319,  348,  357,  369,
                      370,  453,  550,  551,  579,  638,  688,  739,  742,  768,  784,
                      807,  855,  944,  960,  967,  971,  981,  986, 1005, 1010, 1020,
                     1023, 1058, 1141, 1166, 1225, 1280, 1281, 1285, 1311, 1314, 1343,
                     1380, 1381, 1479, 1521, 1523, 1543, 1642, 1684, 1687, 1738, 1792,
                     1794, 1910, 1912, 1943, 1945, 1950, 1982, 1984, 1987, 2032, 2034]

vis_convert:
    kotekan_stage: n2FrameToVisFrame
    n2_buf: eig_10s_buffer
    vis_buf: vis_buffer
    freq_ids: [ 58, 66, 234, 666, 698, 730, 738, 746, 802, 818, 826, 898, 906, 954, 962, 978 ]

failed_vis_convert:
    kotekan_stage: n2FrameToVisFrame
    n2_buf: failed_10s_buffer
    vis_buf: failed_vis_buffer
    freq_ids: [ 58, 66, 234, 666, 698, 730, 738, 746, 802, 818, 826, 898, 906, 954, 962, 978 ]

switch_vis_out:
    kotekan_stage: bufferSwitch
    in_bufs:
      - enabled: vis_buffer
    out_buf: vis_buffer_post
    updatable_config: /updatable_config/enable_vis_out

switch_failed_out:
    kotekan_stage: bufferSwitch
    in_bufs:
      - enabled: failed_vis_buffer
    out_buf: failed_vis_buffer_post
    updatable_config: /updatable_config/enable_failed_out

################################################################################
# FRB beamforming

# UpchannelizationSchedule (used by setUpchanGain) expects these in the root level of the config tree.
upchan_factors: [16]
# ranges are [min, max)
upchan_channel_ranges:
    16: [0, 2048]

FRB:
    # cudaQuantize requires `frb_num_output_times` to be a multiple of 256
    frb_num_output_times: 256
    frb_chunk_size: 256
    frb_downsampling_factor: 24 * 16 # 384

    # The GPU-local (not global) channel index range for each upchannelization factor

    # actual = 16, scaled = 256
    factor_upchan_out: 16
    upchan_U16_max_num_channels: 16 # probably should be {{ num_freq_gpu_buf }}
    upchan_U16_min_channel: 0
    upchan_U16_max_channel: 16 # probably should be {{ num_freq_gpu_buf }}
    upchan_U16_min_output_channel: 0
    upchan_U16_max_output_channel: (upchan_U16_max_channel - upchan_U16_min_channel) * 16
    upchan_U16_max_num_output_channels: upchan_U16_max_output_channel - upchan_U16_min_output_channel

    # TODO: remove
    frb1_num_beams_P: 2 * num_dishes_y
    frb1_num_beams_Q: 2 * num_dishes_x

    {%- set frb2_num_beams_x = 4 %}
    {%- set frb2_num_beams_y = 256 %}
    {%- set frb2_num_beams = frb2_num_beams_x * frb2_num_beams_y %}
    frb2_num_beams_x: {{ frb2_num_beams_x }}
    frb2_num_beams_y: {{ frb2_num_beams_y }}
    frb2_num_beams: {{ frb2_num_beams }}

    # Buffers

    # Upchanneling Gains
    # Per-frequency real multiplier for each upchannelized frequency. This is _not_
    # the complex feed gains
    host_upchan_U16_gain_buffer:
        kotekan_buffer: ndarray
        num_frames: 1
        # TODO: check if factor_upchan_out was the correct 16 to use here
        value_type: float16
        extents: [upchan_U16_max_num_channels * 16]
        quantity_name: "G"
        dimnames: ["Fbar"]
        dimscalings: [1]
        metadata_pool: main_pool

    # Upchannelized voltages
    host_upchan_U16_voltage_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: int4x2_swapped_withoffset
        extents: [samples_per_data_set / 16, upchan_U16_max_num_channels * 16, num_polarizations, num_dishes]
        quantity_name: "Ebar"
        dimnames: ["Tbar", "Fbar", "P", "D"]
        dimscalings: [16, 1, 1, 1]
        metadata_pool: main_pool
    host_upchan_U16_voltage_ringbuffer:
        kotekan_buffer: ring
        ring_buffer_size: gpu_buffer_depth * num_dishes * num_polarizations * (upchan_U16_max_num_channels * factor_upchan_out) * (samples_per_data_set / factor_upchan_out)
        metadata_pool: main_pool

    # Beam locations

    host_frb2_beam_positions_buffer:
        kotekan_buffer: ndarray
        num_frames: 1
        value_type: float32
        extents: [num_freq_gpu_buf, frb2_num_beams, 2]
        quantity_name: "frb2_beam_positions"
        dimnames: ["F", "R", "X/Y"]
        dimscalings: [1, 1, 1]
        metadata_pool: main_pool

    # Beamforming gains at coarse frequency resolution
    host_frb1_phase_buffer:
        kotekan_buffer: ndarray
        num_frames: 1
        value_type: float32
        extents: [num_freq_gpu_buf, num_elements, num_components]
        quantity_name: "gain"
        dimnames: ["F", "E", "C"]
        dimscalings: [1, 1, 1]
        metadata_pool: main_pool

    # Beamforming gains at upchannelized frequency resolution
    host_frb1_U16_phase_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: float16
        extents: [num_freq_gpu_buf * factor_upchan_out, num_polarizations, num_dishes_x, num_dishes_y, num_components]
        quantity_name: "W"  # also referred to as weights, hence the name
        dimnames: ["Fbar", "P", "dishN", "dishM", "C"]
        dimscalings: [1, 1, 1, 1, 1]
        metadata_pool: main_pool

    host_frb2_weights_buffer:
        kotekan_buffer: ndarray
        num_frames: 1
        value_type: float16
        extents: [upchan_U16_max_num_output_channels, frb2_num_beams, frb1_num_beams_Q, frb1_num_beams_P]
        quantity_name: "W2"
        dimnames: ["Fbar", "R", "beamQ", "beamP"]
        dimscalings: [1, 1, 1, 1]
        metadata_pool: main_pool

    # (Intermediate) Beams

    host_frb1_beams_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: float16
        extents: [frb_num_output_times, upchan_U16_max_num_output_channels, frb1_num_beams_Q, frb1_num_beams_P]
        quantity_name: "I"
        dimnames: ["Ttilde", "Fbar", "beamQ", "beamP"]
        dimscalings: [frb_downsampling_factor, 1, 1, 1]
        metadata_pool: main_pool
    host_frb1_beams_ringbuffer:
        kotekan_buffer: ring
        num_frames: gpu_buffer_depth
        ring_buffer_size: gpu_buffer_depth * sizeof_float16 * frb1_num_beams_P * frb1_num_beams_Q * upchan_U16_max_num_output_channels * frb_num_output_times
        metadata_pool: main_pool

    host_frb2_beams_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: float16
        extents: [1, frb2_num_beams, upchan_U16_max_num_output_channels, frb_num_output_times]
        quantity_name: "I2"
        dimnames: ["Ttildehi256", "R", "Fbar", "Ttildelo256"]
        dimscalings: [frb_downsampling_factor * 256, 1, 1, frb_downsampling_factor]
        metadata_pool: main_pool

    host_frb2_beams_buffer_post:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: float16
        extents: [1, frb2_num_beams, upchan_U16_max_num_output_channels, frb_num_output_times]
        quantity_name: "I2"
        dimnames: ["Ttildehi256", "R", "Fbar", "Ttildelo256"]
        dimscalings: [frb_downsampling_factor * 256, 1, 1, frb_downsampling_factor]
        metadata_pool: main_pool

    host_frb3_beams_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: uint8
        extents: [1, frb2_num_beams/4, upchan_U16_max_num_output_channels/64, 16,
                  4, 4, 16, 16]
        quantity_name: "I3"
        dimnames: ["Ttilde256", "R4", "Fbar64", "Ttilde16_lo16", "Rlo4", "Fbar16_lo4", "Fbarlo16", "Ttildelo16"]
        dimscalings: [frb_downsampling_factor * 256, 4, 64, frb_downsampling_factor * 16, 1, 16, 1,
                      frb_downsampling_factor]
        metadata_pool: main_pool

    host_frb3_beams_buffer_post:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        value_type: uint8
        extents: [1, frb2_num_beams/4, upchan_U16_max_num_output_channels/64, 16,
                  4, 4, 16, 16]
        quantity_name: "I3"
        dimnames: ["Ttilde256", "R4", "Fbar64", "Ttilde16_lo16", "Rlo4", "Fbar16_lo4", "Fbarlo16", "Ttildelo16"]
        dimscalings: [frb_downsampling_factor * 256, 4, 64, frb_downsampling_factor * 16, 1, 16, 1,
                      frb_downsampling_factor]
        metadata_pool: main_pool

    host_frb3_beams_offsetscale_buffer:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        # the output is quantized in chunks of `frb_chunk_size`
        value_type: float16
        extents: [1, frb2_num_beams/4, upchan_U16_max_num_output_channels/64, 16, 4, 4, 2]
        quantity_name: "I3_offsetscale"
        dimnames: ["Ttilde256", "R4", "Fbar64", "Ttilde16_lo16", "Rlo4", "Fbar16_lo4", "offset/scale"]
        dimscalings: [frb_downsampling_factor * 256, 4, 64, frb_downsampling_factor * 16, 1, 16, 1]
        metadata_pool: main_pool

    host_frb3_beams_offsetscale_buffer_post:
        kotekan_buffer: ndarray
        num_frames: host_buffer_depth
        # the output is quantized in chunks of `frb_chunk_size`
        value_type: float16
        extents: [1, frb2_num_beams/4, upchan_U16_max_num_output_channels/64, 16, 4, 4, 2]
        quantity_name: "I3_offsetscale"
        dimnames: ["Ttilde256", "R4", "Fbar64", "Ttilde16_lo16", "Rlo4", "Fbar16_lo4", "offset/scale"]
        dimscalings: [frb_downsampling_factor * 256, 4, 64, frb_downsampling_factor * 16, 1, 16, 1]
        metadata_pool: main_pool

    # Stages

    run_set_upchan_U16_gain:
        kotekan_stage: setUpchanGain
        upchan_factor: factor_upchan_out
        upchan_max_num_channels: upchan_U16_max_num_channels
        # these coefficients are taken from commit
        # 00a332717 "correction upchan bandpass (#395)
        # with order reveresd here due to inverted counting of sub-frequencies
        # inverse sqart of BP values (to correct)
        upchan_gain: [1.37863168, 1.29784823, 1.19523339, 1.11033674, 1.05353861, 1.02129051, 1.00551973, 1.00005662, 1.00028733, 1.00675415, 1.02341035, 1.05770345, 1.11718371, 1.20659791, 1.30933448, 1.3837501 ]
        upchan_gain_buffer: host_upchan_U16_gain_buffer
        metadata_buffer: host_rfi_RFImask_buffer

    run_upchan_U16:
{%- if fake_upchan_voltage %}
        cpu_0:
            kotekan_stage: testDataGenFewHot
            type: fewhot
            freq_id: {{ frequency_channels }}
            elemns:
### all ones (source at Zenith)
{%- for el in range(0,4*256) %}
                - {{ el }}
{%- endfor %}
###
#{# two elements in EW only
                - 0
                - 512
#}#
#{# all elements in EW, but delta in NS
                - 0
                - 256
                - 512
                - 768
#}#
#{# two bands EW spanning full NS
{%- for el in range(0,256) %}
                - {{ el }}
{%- endfor %}
{%- for el in range(256,256+256) %}
                - {{ el }}
{%- endfor %}
#}#
            samples_per_dataset: samples_per_data_set
            out_buf: host_upchan_U16_voltage_buffer

    run_send_upchan_U16_voltage:
        gpu_0:
            kotekan_stage: cudaProcess
            log_level: debug
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            frame_arrival_period: network_frame_arrival_period
            num_times: 1024
            in_buffers:
                host_upchan_U16_voltage_buffer: host_upchan_U16_voltage_buffer
            out_buffers:
                host_upchan_U16_voltage_ringbuffer: host_upchan_U16_voltage_ringbuffer
            commands:
            - name: cudaCopyToRingbuffer
              input_size: num_dishes * num_polarizations * (upchan_U16_max_num_channels * factor_upchan_out) * (samples_per_data_set / factor_upchan_out)
              ring_buffer_size: gpu_buffer_depth * input_size
              in_buf: host_upchan_U16_voltage_buffer
              signal_buf: host_upchan_U16_voltage_ringbuffer
              gpu_mem_output: upchan_U16_voltage_buffer
{%- else %}
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            # maybe? Depends on the chunking of the previous stage
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_xposed_voltage_ringbuffer: host_xposed_voltage_ringbuffer
                host_upchan_U16_gain_buffer: host_upchan_U16_gain_buffer
            out_buffers:
                host_upchan_U16_voltage_ringbuffer: host_upchan_U16_voltage_ringbuffer
            commands:
            - name: cudaInputData
              do_once: true
              in_buf: host_upchan_U16_gain_buffer
              gpu_mem: upchan_U16_gain_buffer
            - name: cudaSyncInput
            - name: cudaUpchannelizer_chime_U16
              voltage_name: xposed_voltage
              upchan_U16_gain_name: upchan_U16_gain
              upchan_U16_voltage_name: upchan_U16_voltage
              Fmin: upchan_U16_min_channel
              Fmax: upchan_U16_max_channel
            - name: cudaSyncOutput

### for debugging only
    run_recv_upchan_U16_voltage:
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            # maybe? Depends on the chunking of the previous stage
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_upchan_U16_voltage_ringbuffer: host_upchan_U16_voltage_ringbuffer
            out_buffers:
                host_upchan_U16_voltage_buffer: host_upchan_U16_voltage_buffer
            commands:
            - name: cudaCopyFromRingbuffer
              host_signal: host_upchan_U16_voltage_ringbuffer
              gpu_mem_input: upchan_U16_voltage_buffer
              output_size: num_dishes * num_polarizations * (upchan_U16_max_num_channels * factor_upchan_out) * (samples_per_data_set / factor_upchan_out)
              ring_buffer_size: buffer_depth * output_size
              out_buf: host_upchan_U16_voltage_buffer
###
{%- endif %}

    # FRB 1

    load_frb1_phase:
        kotekan_stage: loadFeedGains
        beamformer_type: "frb"
        filename_template: "quick_gains_%04d_reordered.bin"
        num_local_freq: num_freq_gpu_buf
        default_gains: [1.0, 0.0] # 1.0 + 0.0j ie unit gain
        gain_buffers:
          - host_frb1_phase_buffer
        in_buf: host_rfi_RFImask_buffer
        updatable_config:
          frb_gain: /updatable_config/frb_gain

    process_frb1_U16_phase:
        kotekan_stage: processFRBFeedGains
        num_local_freq: num_freq_gpu_buf
        upchan_factor: factor_upchan_out
        frb1_swap_MN: true
        conjugate_gains: true
        # empirically, this made CYG_A have an intermediate intesity2 of 37000
        scaling_factor: 1.0 / 32. #512
        gain_buffers:
          - host_frb1_phase_buffer
        in_mask_buf: host_bf_mask_buffer
        out_buf: host_frb1_U16_phase_buffer

    run_frb1_U16:
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            # maybe? Depends on the chunking of the previous stage
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_upchan_U16_voltage_ringbuffer: host_upchan_U16_voltage_ringbuffer
                host_frb1_U16_phase_buffer: host_frb1_U16_phase_buffer
            out_buffers:
                host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
            commands:
            - name: cudaInputData
              in_buf: host_frb1_U16_phase_buffer
              gpu_mem: frb1_U16_phase_buffer
            - name: cudaSyncInput
            - name: cudaCHIMEFRBBeamformer_chime_U16
              voltage_name: upchan_U16_voltage
              frb_phase_name: frb1_U16_phase
              frb_beamgrid_name: frb1_beams

    # FRB 2 and 3

    run_set_beam_positions:
        kotekan_stage: givenDataGen
        out_buf: host_frb2_beam_positions_buffer
        # beam separation in EW should be 0.4deg
        # beam separtion in NS is such that sin(angle) changes by sqrt(3)/256
