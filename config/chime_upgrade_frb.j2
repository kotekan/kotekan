        values:
# direction sine in the normal vector sin(angle-from-zenith-towards-x), equally spaced for CHIME
{%- for cf in range(16) %}
{%- for ew in range(frb2_num_beams_x) %}
{%- for ns in range(frb2_num_beams_y) %}
          - {{ sin_achromatic_beam_angles_EW[ew] }}
          - {{ chromatic_beam_angles_NS[cf * 256 + ns] }}
{%- endfor %}
{%- endfor %}
{%- endfor %}
        name: frb2_beam_positions
        datatype: float32
        array_shape: [ num_freq_gpu_buf, {{ frb2_num_beams }}, 2]
        dim_scalings: [ 1, 1, 1 ]
        dim_name: [ "F", "R", "X/Y" ]
        do_once: true

    run_calc_frb2_weights:
###
        kotekan_stage: cudaCalcFRB2Weights
        frb2_num_frequencies: upchan_U16_max_num_output_channels
        frb2_beam_positions: host_frb2_beam_positions_buffer
        frb1_swap_MN: true # yes, this is used by FRB 2
        frb2_weights: host_frb2_weights_buffer
        metadata: host_rfi_RFImask_buffer
###
#{#
        kotekan_stage: hdf5FileRead
        input_dir: frb_weights
        do_once: true
        out_buf: host_frb2_weights_buffer
        file_name: host_frb2_weights_buffer
#}#

    run_frb23:
        gpu_0:
            kotekan_stage: cudaProcess
            gpu_id: 0
            buffer_depth: gpu_buffer_depth
            # maybe? Depends on the chunking of the previous stage
            frame_arrival_period: network_frame_arrival_period
            num_times: samples_per_data_set
            in_buffers:
                host_frb1_beams_ringbuffer: host_frb1_beams_ringbuffer
                host_frb2_weights_buffer: host_frb2_weights_buffer
            out_buffers:
                host_frb1_beams_buffer: host_frb1_beams_buffer
                host_frb2_beams_buffer: host_frb2_beams_buffer
                host_frb3_beams_buffer: host_frb3_beams_buffer
                host_frb3_beams_offsetscale_buffer: host_frb3_beams_offsetscale_buffer
            commands:
            - name: cudaInputData
              do_once: true
              in_buf: host_frb2_weights_buffer
              gpu_mem: frb2_weights_buffer
            - name: cudaSyncInput
            - name: cudaFRBBeamReformer
              frb1_max_num_frequencies: upchan_U16_max_num_output_channels
              frb1_max_num_times: buffer_depth * frb_num_output_times
              frb2_num_frequencies: upchan_U16_max_num_output_channels
              #frb1_num_beams_P: frb1_num_beams_P
              #frb1_num_beams_Q: frb1_num_beams_Q
              # frb2_num_beams: frb2_num_beams
              frb2_num_times: frb_num_output_times
              in_signal: host_frb1_beams_ringbuffer
              frb1_beams_name: frb1_beams
              frb2_weights_name: frb2_weights
              frb2_beams_name: frb2_beams
            - name: cudaQuantize8 # TODOL use "CHIME" variant
              # the output is quantized in chunks of `frb_chunk_size`
              num_beams: frb2_num_beams
              num_frequencies: upchan_U16_max_num_output_channels
              num_times: frb_num_output_times
              gpu_mem_input: frb2_beams
              gpu_mem_output: frb3_beams
              gpu_mem_offsetscale: frb3_beams_offsetscale
            - name: cudaSyncOutput
### for debugging only
            - name: cudaCopyFromRingbuffer
              # TODO: Don't do this in production
              host_signal: host_frb1_beams_ringbuffer
              gpu_mem_input: frb1_beams_buffer
              output_size: sizeof_float16 * frb1_num_beams_P * frb1_num_beams_Q * upchan_U16_max_num_output_channels * frb_num_output_times
              ring_buffer_size: gpu_buffer_depth * output_size
              out_buf: host_frb1_beams_buffer
###
            - name: cudaOutputData
              # TODO: Don't do this in production
              gpu_mem: frb2_beams_buffer
              out_buf: host_frb2_beams_buffer
            - name: cudaOutputData
              gpu_mem: frb3_beams_buffer
              out_buf: host_frb3_beams_buffer
            - name: cudaOutputData
              gpu_mem: frb3_beams_offsetscale_buffer
              out_buf: host_frb3_beams_offsetscale_buffer

    switch_frb_out:
        kotekan_stage: bufferSwitch
        in_bufs:
          - enabled: host_frb3_beams_buffer
        out_buf: host_frb3_beams_buffer_post
        updatable_config: /updatable_config/enable_frb_out
    switch_frb_offsetscale_out:
        kotekan_stage: bufferSwitch
        in_bufs:
          - enabled: host_frb3_beams_offsetscale_buffer
        out_buf: host_frb3_beams_offsetscale_buffer_post
        updatable_config: /updatable_config/enable_frb_out

    switch_frb2_out:
        kotekan_stage: bufferSwitch
        in_bufs:
          - enabled: host_frb2_beams_buffer
        out_buf: host_frb2_beams_buffer_post
        updatable_config: /updatable_config/enable_frb_out

{%- if do_once_and_dump %}
    # dump data for debugging
    dump_frb_beams:
        max_frames: 1
        upchan_U16_voltage:
            kotekan_stage: hdf5FileWrite
            base_dir: frb_beams
            input_order: CHIMEBeamformer # this makes no sense, but is required
            in_buf: host_upchan_U16_voltage_buffer
            file_name: upchan_U16_voltage_buffer
        beams1:
            kotekan_stage: hdf5FileWrite
            base_dir: frb_beams
            input_order: CHIMEBeamformer # this makes no sense, but is required
