        - name: cudaSyncInput
        - name: cudaRFISKtilde
          num_frequencies: num_freq_gpu_buf
          bf_mask_name: bf_mask
          rfi_S012_name: rfi_S012
          rfi_SKtilde_name: rfi_SKtilde
          rfi_RFImask_name: rfi_RFImask

run_rfi_SKbar:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        # maybe? Depends on the chunking of the previous stage
        frame_arrival_period: network_frame_arrival_period
        num_times: samples_per_data_set
        in_buffers:
            host_bf_mask_buffer: host_bf_mask_buffer
            host_rfi_S012bar_ringbuffer: host_rfi_S012bar_ringbuffer
        out_buffers:
            host_rfi_SKbar_ringbuffer: host_rfi_SKbar_ringbuffer
            host_rfi_SKbartilde_ringbuffer: host_rfi_SKbartilde_ringbuffer
        commands:
        - name: cudaInputData
          in_buf: host_bf_mask_buffer
          gpu_mem: bf_mask_buffer
        - name: cudaSyncInput
        - name: cudaRFISKbar
          num_frequencies: num_freq_gpu_buf
          bf_mask_name: bf_mask
          rfi_S012bar_name: rfi_S012bar
          rfi_SKbar_name: rfi_SKbar
          rfi_SKbartilde_name: rfi_SKbartilde

run_rfi_SK_copy_from_GPU:
    gpu0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
        frame_arrival_period: network_frame_arrival_period
        num_times: rfi_num_times_bar
        in_buffers:
            host_rfi_SKbar_ringbuffer: host_rfi_SKbar_ringbuffer
            host_rfi_SKtilde_ringbuffer: host_rfi_SKtilde_ringbuffer
        out_buffers:
            host_rfi_SKbar_buffer: host_rfi_SKbar_buffer
