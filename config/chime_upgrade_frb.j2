################################################################################
# Output to receivers

{% if send_n2 %}
# Transmit all the data to the receiver node
buffer_send:
    # server_ip: 10.1.50.12
    # mock receiver IP
    server_ip: 10.13.60.1
    reconnect_time: 20
    log_level: warn
    n2:
        kotekan_stage: bufferSend
        buf: vis_buffer
        server_port: 11024
{% endif %}

# this will move to the baseband receiver eventually
write_baseband:
  root_path: baseband_raw
  dump_timeout: 1200 # 20 Minutes
  write_0:
    samples_per_data_set: 512 # samples_per_data_set / 32 (which causes a recursion if used)
    kotekan_stage: BasebandWriter
    in_buf: baseband_output_buffer_merged

## Transmit baseband data to the baseband receiver
{%- if send_baseband %}
baseband_send:
  #server_ip: 10.5.60.2
  # mock receiver IP
  server_ip: 10.13.60.1
  reconnect_time: 60
  send_timeout: 600 # 10 minutes
  log_level: warn
  # Keep data in memory even if the receiver node is down
  # Baseband readout handles back pressure management
  drop_frames: false
  use_config_tracker: false # not used by legacy CHIME kotekan code
  baseband_send_0:
    kotekan_stage: bufferSend
    server_port: 11027
    buf: baseband_output_buffer_merged
{%- endif %}

write_vis:
    kotekan_stage: VisWriter
    root_path: vis_data
