        commands:
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_SKbar_ringbuffer
          gpu_mem_input: rfi_SKbar_buffer
          output_size: sizeof_float32 * num_dishes * num_polarizations * 3 * num_freq_gpu_buf * rfi_num_times_bar
          ring_buffer_size: gpu_buffer_depth * output_size
          out_buf: host_rfi_SKbar_buffer
        - name: cudaCopyFromRingbuffer
          host_signal: host_rfi_SKtilde_ringbuffer
          gpu_mem_input: rfi_SKtilde_buffer
          output_size: sizeof_float32 * 3 * num_freq_gpu_buf * rfi_num_times
          ring_buffer_size: gpu_buffer_depth * output_size
          out_buf: host_rfi_SKtilde_buffer

run_rfi_MASK_copy_from_GPU:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        buffer_depth: gpu_buffer_depth
