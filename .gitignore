.DS_Store
*.kdev4
*.save
*.kate-swp
.kdev_include_paths
*.c~
*.h~
*~
*#
*.swp
*.pyc
/.idea/
/.vscode/
/nbproject/
/cmake-build*/
build-*
# any out-of-tree build dir. `build/` carries its own .gitignore ('*' + !.gitignore),
# but build_nodpdk/ (the DPDK-free build for cf06) did not -- so `git add -A` swept 523
# build artifacts into the history on 2026-08-04, ~200 MB of objects. Cover the pattern,
# not just the one directory.
build_*/
docs/sphinx/html/*
.ccache/*
.cache/*
scratch/*
*.log

# Local macOS build dir
/build_mac/

# Celestrak TLE downloads: the almanac now caches these in ~/.cache/kotekan_gps,
# but skyfield's default loader names a URL download after its basename ("gp.php"),
# so guard against any stray landing in the repo root.
gp.php
gp.php*
/build_cuda/

# Data products live OUTSIDE the repo (airspy_gps/captures). A relative --outdir run from
# inside kotekan/ used to silently create one here (2026-07-17).
/captures/

# Output generated by running the ci-test configs / boost tests from the repo root
/fake_data/
/time_dump.txt
scripts/gnss/sumtrack_test
